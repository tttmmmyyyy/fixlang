module Main;

import EZS;

_CASES_PATH : String;
_CASES_PATH = "cases";

_LOG_FILE_PATH : String;
_LOG_FILE_PATH = "log.csv";

_COMMIT_HASH : String;
_COMMIT_HASH = "commit";

// How many windows of runs the hardware counters are read over. The cycle count reported is the
// lowest reading of them all, and a run the machine disturbed only ever raises it.
_WINDOWS : String;
_WINDOWS = "5";

// The languages a case may carry a counterpart in, as a `ref.*` source beside its `main.fix`.
_REFERENCE_LANGUAGES : Array String;
_REFERENCE_LANGUAGES = ["c", "rust"];

// What `perf_counters.py` exits with when the program it measured exited non-zero, apart from
// the 1 it exits with when the counters could not be read. There it is `PROGRAM_FAILED`.
_PROGRAM_FAILED : U8;
_PROGRAM_FAILED = 2_U8;

// What `reference.py` exits with when the case carries no counterpart in the language asked for.
// Every other non-zero status of it is something that went wrong.
_NO_COUNTERPART : U8;
_NO_COUNTERPART = 2_U8;

// The columns a `perf_counters.py` line fills, in the order it prints them. The contention it
// prints after them belongs to the row rather than to any one case.
_COUNTER_COLUMN_SUFFIXES : Array String;
_COUNTER_COLUMN_SUFFIXES = ["-inst", "-ram", "-splits", "-cycles"];

// The number a field of a counter script's output holds, or zero where the field is empty or
// is not a number.
read_number : String -> F64;
read_number = |field| (
    let parsed : Result ErrMsg F64 = field.from_string;
    if parsed.is_err { 0.0 };
    parsed.as_ok
);

type CSV = Array (Array String);

namespace CSV {
    // Parse a CSV string into an array of arrays of strings.
    parse : String -> CSV;
    parse = |csv_str| csv_str.split("\n")
        .filter_map(|line| 
            let line = line.strip_spaces;
            if line == "" { none() };
            some(line)
        )
        .map(|line| line.split(",").to_array).to_array;

    serialize : CSV -> String;
    serialize = |csv| (
        if csv.is_empty { "" };
        let header_size = csv.@(0).@size;
        let csv = csv.map(|row| 
            if row.@size > header_size {
                undefined("error: Row has more columns than header: " + row.to_string)
            };
            row.resize(header_size, "")
        );
        csv.map(|row| row.to_iter.join(",")).to_iter.join("\n")
    );

    add_column : String -> CSV -> CSV;
    add_column = |name, csv| (
        if csv.is_empty {
            [[name]]
        } else {
            range(0, csv.@size).fold(csv, |i, csv|
                csv.mod(i, |row|
                    if i == 0 {
                        row.push_back(name)
                    } else {                    
                        row.push_back("")
                    }
                )
            )
        }
    );

    set : [a : ToString] String -> I64 -> a -> CSV -> CSV;
    set = |col, row, value, csv| (
        let value = value.to_string;
        let csv = if csv.is_empty { [[col]] } else { csv };
        let col_idx = csv.@(0).find_by(|x| x == col);
        let (csv, col_idx) = if col_idx.is_none {
            let col_idx = csv.@(0).@size;
            let csv = csv.add_column(col);
            (csv, col_idx)
        } else {
            (csv, col_idx.as_some)
        };
        if row < 0 || row >= csv.@size {
            undefined("error: Row index out of bounds: " + row.to_string)
        };
        csv.mod(row, set(col_idx, value))
    );

    add_row : CSV -> CSV;
    add_row = |csv| (
        if csv.is_empty {
            undefined("error: Cannot add row to empty CSV")
        };
        let header_size = csv.@(0).@size;
        csv.push_back(Array::fill(header_size, ""))
    );
}

// Put the counts of a `perf_counters.py` line into the log's last row, under the columns of
// `case_name`. `language_suffix` names the language a counterpart was measured in, and is empty
// for the case's own measurement. `fields` holds the whole line: the counts, and the contention
// after them.
set_latest_counts : String -> String -> Array String -> CSV -> CSV;
set_latest_counts = |case_name, language_suffix, fields, log| (
    let row = log.@size - 1;
    Iterator::range(0, _COUNTER_COLUMN_SUFFIXES.@size).fold(log, |i, log|
        log.set(case_name + _COUNTER_COLUMN_SUFFIXES.@(i) + language_suffix, row, fields.@(i))
    )
);

type Args = struct {
    no_save : Bool,
    llvm_passes_file: String,
};

namespace Args {
    default : Args;
    default = Args {
        no_save: false,
        llvm_passes_file: "",
    };
}

main : IO ();
main = (
    let config = EZSConfig::default.set_execution_trace(true);

    let raw_args = *get_args;
    let args = loop((1, Args::default), |(i, args)|
        if i >= raw_args.@size { break $ args };
        if raw_args.@(i) == "--no-save" {
            continue $ (i + 1, args.set_no_save(true))
        } else if raw_args.@(i) == "--llvm-passes-file" {
            if i + 1 >= raw_args.@size {
                undefined("error: --llvm-passes-file requires a file path argument")
            };
            let llvm_passes_file = raw_args.@(i + 1);
            continue $ (i + 2, args.set_llvm_passes_file(llvm_passes_file))
        } else {
            undefined("error: Unknown argument: " + raw_args.@(i))
        }
    );

    // Parse the log file.
    let log = *["cat", _LOG_FILE_PATH].ez_run_o(config);
    let log = CSV::parse(log);

    // If the log file is empty, write the header line "commit_hash"
    let log = if log.is_empty {
        log.add_column(_COMMIT_HASH)
    } else {
        log
    };

    // Get the current commit hash.
    let commit_hash = *["git", "rev-parse", "HEAD"].ez_run_o(config);
    let commit_hash = commit_hash.strip_spaces;

    // Get if the current repository is dirty.
    let is_dirty = *["git", "status", "--porcelain"].ez_run_o(config);
    let is_dirty = is_dirty.strip_spaces != "";

    // Add "(dirty)" to  the `commit_hash` if necessary.
    let commit_hash = if is_dirty {
        commit_hash + "(dirty)"
    } else {
        commit_hash
    };

    // Add the new row to the log.
    let log = log.add_row;
    let log = log.set(_COMMIT_HASH, log.@size - 1, commit_hash);

    // The processor the row was measured on. Every column of a case is read from its counters,
    // so a row from another machine cannot be compared with its neighbours.
    let (cpu, _, cpu_code) = *["python3", "perf_counters.py", "--cpu"].ez_run_oec(config);
    let log = if cpu_code != 0_U8 { log } else {
        log.set("cpu", log.@size - 1, cpu.strip_spaces)
    };

    // See the cases directory.
    ez_cd(config, _CASES_PATH);;
    let dirs = *["find", ".", "-maxdepth", "1", "-type", "d"].ez_run_o(config);
    let dirs = dirs.split("\n").filter_map(|line|
        let line = line.strip_spaces;
        if line == "" || line == "." { none() };
        let line = line.get_sub(2, line.@size); // Remove "./"
        if line.get_bytes.@(0) == '_' { none() };
        some(line)
    );
    // Build every case, and every counterpart, before measuring any of them. A build is by
    // far the heaviest thing this program runs, and a cycle count is dropped on a machine
    // that is busy, so a build standing between two measurements is what costs a run its
    // cycle columns.
    dirs.fold_m((), |dir, _|
        ez_cd(config, dir);;
        let command = ["cargo", "run", "--", "build", "-O", "experimental", "--emit-symbols", "--allow-preliminary-commands"];
        let command = if args.@llvm_passes_file != "" {
            command.push_back("--llvm-passes-file")
                   .push_back("../../" + args.@llvm_passes_file)
        } else {
            command
        };
        command.ez_run_o(config);;
        _REFERENCE_LANGUAGES.to_iter.fold_m((), |lang, _|
            let (_, _, build_code) = *["python3", "../../reference.py", "build", lang].ez_run_oec(config);
            // A counterpart that does not compile would otherwise reach the measurement as a
            // language this case does not carry, and leave the row short of its columns.
            when(build_code != 0_U8 && build_code != _NO_COUNTERPART,
                eprintln("error: the " + lang + " counterpart of " + dir + " does not build");;
                exit(1)
            );;
            pure()
        );;
        ez_cd(config, "..")
    );;

    // The most CPU other work took while the hardware counters were read, carried alongside
    // the log so that the row can say how much of the machine the measurement had: the cycle
    // columns mean nothing without it.
    let (log, max_contention) = *dirs.fold_m((log, 0.0), |dir, (log, max_contention)|
        ez_cd(config, dir);;
        let case_name = dir;
        // Every column of a case comes from one reading of the hardware counters. `-inst` counts
        // the instructions the program retired, which is the program's own figure and reaches the
        // log whatever the machine was doing. `-ram` counts the accesses that reached main memory:
        // it separates a case whose cycle count another program can move from a case where it
        // cannot. `-splits` counts loads and stores that crossed a cache-line boundary, which cost
        // real time and which an instruction count has no notion of. `-cycles` counts what the
        // machine actually took, so that a change to code layout or branch density -- where the
        // instruction count and the time diverge -- shows up somewhere in this log.
        //
        // The cycle count is the one column the rest of the machine can move, and it survives a
        // machine with other work on it when that work reached neither the core nor the cache:
        // `perf_counters.py` runs on one thread of a core and keeps the windows the other thread
        // stayed out of, and it drops the count of a program that reaches main memory often enough
        // for the shared cache to cost it. It leaves that field empty where either condition
        // fails. The `contention` column says how much of the machine the run had.
        //
        // On a machine without the counters every column stays empty and the run carries on.
        let (perf, _, perf_code) = *["python3", "../../perf_counters.py", "--windows", _WINDOWS,
            "./a.out"].ez_run_oec(config);
        // A case checks its own answer, so a case that exits non-zero is one whose answer moved.
        // The run stops here, since its empty columns would read as a machine that had nothing to
        // count.
        if perf_code == _PROGRAM_FAILED {
            eprintln("error: " + dir + " failed its own check");;
            exit(1)
        };
        let (log, case_contention) = if perf_code != 0_U8 { (log, 0.0) } else {
            let perf_fields = perf.strip_spaces.split(",").to_array;
            if perf_fields.@size != _COUNTER_COLUMN_SUFFIXES.@size + 1 {
                undefined("error: perf_counters.py reported \"" + perf_fields.to_iter.join(",")
                    + "\" for " + dir)
            };
            let log = log.set_latest_counts(case_name, "", perf_fields);
            // A figure the harness cannot make out leaves the row's `contention` at whatever
            // the other cases reported, which is the honest reading: this case said nothing.
            (log, perf_fields.@(_COUNTER_COLUMN_SUFFIXES.@size).read_number)
        };
        let max_contention = max(max_contention, case_contention);
        // A case may carry `ref.c` and `ref.rs`: the same program on the same input, read
        // with the same counters, so the chart can show how far the Fix line is from C
        // and Rust on each of them. The column name keeps the language last, which is what
        // holds these out of the cost line printed at the end -- a reference does not move
        // with a pass sequence, so it has no business in what the pass search compares.
        let (log, max_contention) = *_REFERENCE_LANGUAGES.to_iter.fold_m((log, max_contention), |lang, (log, max_contention)|
            let (ref_out, _, ref_code) = *["python3", "../../reference.py", "measure", lang, "--windows", _WINDOWS].ez_run_oec(config);
            // The counterpart checks its own answer too, and `reference.py` stops on that rather
            // than letting it become a number on the chart.
            if ref_code != 0_U8 && ref_code != _NO_COUNTERPART {
                eprintln("error: the " + lang + " counterpart of " + dir + " failed its own check");;
                exit(1)
            };
            if ref_code != 0_U8 { (log, max_contention).pure };
            let ref_out = ref_out.strip_spaces.split(",").to_array;
            if ref_out.@size < _COUNTER_COLUMN_SUFFIXES.@size + 1 { (log, max_contention).pure };
            // A machine without the counters leaves every field empty, and a column of empty
            // cells is one the log is better off without.
            if ref_out.@(0) == "" { (log, max_contention).pure };
            let log = log.set_latest_counts(case_name, "-" + lang, ref_out);
            (log, max(max_contention, ref_out.@(_COUNTER_COLUMN_SUFFIXES.@size).read_number)).pure
        );
        // Change back to the parent directory.
        ez_cd(config, "..");;
        (log, max_contention).pure
    );

    ez_cd(config, "..");;

    // A case whose counters could not be read leaves every column of its own empty, and says
    // nothing about how busy the machine was. Where that is every case, the run measured nothing,
    // and a contention of `0.00` would read as the quietest machine there is.
    let header = log.@(0);
    let latest = log.@(log.@size - 1);
    let cell = |suffix, dir| (
        let column = header.find_by(|name| name == dir + suffix);
        if column.is_none { "" };
        latest.@(column.as_some)
    );
    let unread = dirs.filter(|dir| cell("-inst", dir) == "").to_array;
    let log = if unread.@size == dirs.get_size { log } else {
        log.set("contention", log.@size - 1, max_contention.to_string_precision(2_U8))
    };

    // Say which cases the run came away without a cycle count for, and which of the two reasons
    // each is: the counters were out of reach, or other work could have moved the count. The row
    // that results reads like every other one until someone opens the file.
    let withheld = dirs.filter(|dir|
        cell("-inst", dir) != "" && cell("-cycles", dir) == ""
    ).to_array;
    when(!unread.is_empty,
        eprintln("warning: " + unread.@size.to_string + " of " + dirs.get_size.to_string
            + " cases came away with no counters at all, so every column of theirs is empty."
            + " `perf_counters.py` reports that where the machine has no hardware PMU, where"
            + " `kernel.perf_event_paranoid` is above 2, or where the PMU had to time-slice the"
            + " events: " + unread.to_iter.join(", "))
    );;
    when(!withheld.is_empty,
        eprintln("warning: " + withheld.@size.to_string + " of " + dirs.get_size.to_string
            + " cases came away without a cycle count, with other work taking "
            + max_contention.to_string_precision(2_U8) + " cores while they ran. A count is kept"
            + " from a window the thread beside the measurement stayed out of, and from a case"
            + " that reaches main memory seldom enough for the shared cache not to cost it: "
            + withheld.to_iter.join(", "))
    );;

    // Save the log to the log file.
    unless(args.@no_save,
        write_file_string(_LOG_FILE_PATH, log.serialize).try(exit_with_msg(1))
    );;

    // Print the commit hash and this run's instruction counts, and those alone, so that a run
    // can be read against the one before it without opening the log. The reference languages are
    // left out: their columns carry the language last, and a reference does not move with a Fix
    // commit.
    let latest = log.@(log.@size - 1);
    let costs = Iterator::range(0, header.@size).filter(|i|
        i == 0 || header.@(i).ends_with("-inst")
    ).map(|i| latest.@(i));
    costs.join(",").println;;
    
    pure()
);