module Main;

import Std::{Array, I64, IO, Option, Array::{from_map, to_iter}, Debug::assert_eq, Iterator::{filter_map, fold}, Monad::pure, Option::{none, some}};

iter_filter_map : Array I64 -> I64;
iter_filter_map = |arr| (
    arr.to_iter.filter_map(|x| if x % 2 == 0 { some(x * 2) } else { none() }).fold(0, |x, acc| acc + x)
);

main : IO ();
main = (
    let arr = Array::from_map(1000000, |i| i % 251);
    assert_eq(|_|"iter_filter_map", iter_filter_map(arr), 125496112);;
    pure()
);
