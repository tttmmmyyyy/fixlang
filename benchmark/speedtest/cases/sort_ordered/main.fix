module Main;

import Std::{
    Array, Bool, I64, IO, Array::{empty, push_back, sort, to_iter, @, @size}, Debug::assert_eq,
    Iterator::{fold, range, sum}, Monad::pure
};

// Sort benchmark on an input that is already in order, where every split falls where the recursion
// wants it. Guards the side the recursion budget is spent on: a budget large enough to keep the
// randomly ordered case out of heap sort is only safe while an ordered input stays cheap.

gen_input : I64 -> Array I64 = |n| (
    Iterator::range(0, n).fold(Array::empty(n), |i, arr| arr.push_back(i))
);

is_nondecreasing : Array I64 -> Bool = |arr| (
    Iterator::range(1, arr.@size).fold(true, |i, acc| acc && arr.@(i-1) <= arr.@(i))
);

main : IO () = (
    let n = 100000;
    let sorted = gen_input(n).sort;
    assert_eq(|_|"sort_ordered: nondecreasing", sorted.is_nondecreasing, true);;
    assert_eq(|_|"sort_ordered: sum preserved", sorted.to_iter.sum, 4999950000);;
    pure()
);
