module Main;

import Std::{
    Array, Bool, I64, IO, Array::{@, from_map, to_iter}, Debug::assert_eq,
    Iterator::{DynIterator, filter, fold, to_dyn}, Monad::pure
};

evens_or_all : Bool -> Array I64 -> DynIterator I64;
evens_or_all = |only_evens, arr| (
    if only_evens { arr.to_iter.filter(|x| x % 2 == 0).to_dyn } else { arr.to_iter.to_dyn }
);

dyn_iter_branch : Array I64 -> I64;
dyn_iter_branch = |arr| (
    evens_or_all(arr.@(1) % 2 == 1, arr).fold(0, |x, acc| acc + x)
);

main : IO ();
main = (
    let arr = Array::from_map(1000000, |i| i % 251);
    assert_eq(|_|"dyn_iter_branch", dyn_iter_branch(arr), 62748056);;
    pure()
);
