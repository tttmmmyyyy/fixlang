module Main;

import CPLib.String::calc_z_array;
import Speedtest::{check_answer, rands, PerfControl::{measure, start}};
import Std::{
    IO, String, Array::{push_back, to_iter}, FromBytes::from_bytes, Functor::map, Iterator::fold, 
    Monad::pure, Result::as_ok, ToString::to_string, ToU8::u8
};

// The `z_algorithm` of cp-library, run on the input `ref.cpp` gives ac-library. Only the part
// that calls the library is counted: `PerfControl` leaves generating the input out.

main : IO ();
main = (
    let control = *PerfControl::start;
    let n = 10000000;
    let s = from_bytes(rands(n, 2, 1_U64).map(|c| ('a' + c.u8)).push_back(0_U8)).as_ok : String;
    let z = *control.measure(|_| calc_z_array(s));
    check_answer("z_algorithm", z.to_iter.fold(0, |x, acc| acc + x).to_string, "20006181");;
    pure()
);
