module Main;

import Std::{
    Array, I64, IO, Array::{from_map, to_iter}, Debug::assert_eq, Iterator::{fold, range, to_dyn},
    Monad::pure
};

dyn_iter_bind : Array I64 -> I64;
dyn_iter_bind = |arr| (
    let pairs = do {
        let x = *arr.to_iter.to_dyn;
        let j = *range(0, x % 4).to_dyn;
        pure $ x + j
    };
    pairs.fold(0, |x, acc| acc + x)
);

main : IO ();
main = (
    let arr = Array::from_map(1000000, |i| i % 251);
    assert_eq(|_|"dyn_iter_bind", dyn_iter_bind(arr), 188244216);;
    pure()
);
