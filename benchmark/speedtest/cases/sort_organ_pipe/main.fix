module Main;

import Std::{
    Array, Bool, I64, IO, Array::{empty, push_back, sort, to_iter, @, @size}, Debug::assert_eq,
    Iterator::{fold, range, sum}, Monad::pure
};

// Sort benchmark on an input that rises to the middle and falls back, so the middle element is the
// greatest of every sub-range and every split leaves one element on one side. Guards the recursion
// budget: this is the shape it is against, and the shape that reaches heap sort.

gen_input : I64 -> Array I64 = |n| (
    Iterator::range(0, n).fold(Array::empty(n), |i, arr|
        arr.push_back(if i < n - 1 - i { i } else { n - 1 - i })
    )
);

is_nondecreasing : Array I64 -> Bool = |arr| (
    Iterator::range(1, arr.@size).fold(true, |i, acc| acc && arr.@(i-1) <= arr.@(i))
);

main : IO () = (
    let n = 100000;
    let sorted = gen_input(n).sort;
    assert_eq(|_|"sort_organ_pipe: nondecreasing", sorted.is_nondecreasing, true);;
    assert_eq(|_|"sort_organ_pipe: sum preserved", sorted.to_iter.sum, 2499950000);;
    pure()
);
