module Main;

import CPLib.Arithmetic::calc_prime_list;
import Std::{
    IO, Array::@size, Debug::{assert_eq, consumed_time_while_lazy}, Functor::map, IO::println, 
    Monad::pure, String::populate, ToI64::i64, ToString::to_string
};

main : IO ();
main = (
    let n = 1e8;
    assert_eq(|_|"test_prime_list 1", calc_prime_list(20).map(i64), [2, 3, 5, 7, 11, 13, 17, 19]);;
    let (res, time) = consumed_time_while_lazy(|_| calc_prime_list(n));

    assert_eq(|_|"test_prime_list 2", res.@size, 5761455);;
    println $ "[CPLib.Arithmetic.Test] calc_prime_list({}): {}".populate([n.to_string, time.to_string]);;
    pure()
);