module Main;

import CPLib.Graph::{calc_sccs, GraphBuilder::{add_edge, build, create}};
import Speedtest::{check_answer, rands, PerfControl::{measure, start}};
import Std::{
    IO, Array::{@, @size, to_iter}, Iterator::{fold, range}, LessThan::max, Monad::pure, 
    ToString::to_string
};

// The `scc` of cp-library, run on the input `ref.cpp` gives ac-library. Only the part
// that calls the library is counted: `PerfControl` leaves generating the input out.

main : IO ();
main = (
    let control = *PerfControl::start;
    let n = 200000; let m = 500000;
    let us = rands(m, n, 1_U64); let vs = rands(m, n, 2_U64);
    let sccs = *control.measure(|_|
        let g = range(0, m).fold(GraphBuilder::create(n), |i, g| g.add_edge(us.@(i), vs.@(i), ()));
        g.build.calc_sccs
    );
    let largest = sccs.to_iter.fold(0, |c, acc| max(acc, c.@size));
    check_answer("scc", sccs.@size.to_string + " " + largest.to_string, "40859 159142");;
    pure()
);
