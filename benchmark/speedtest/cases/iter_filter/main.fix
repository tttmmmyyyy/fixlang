module Main;

import Std::{Array, Bool, I64, IO, Array::{from_map, to_iter}, Debug::assert_eq, Iterator::{filter, fold}, Monad::pure};

iter_filter : Array I64 -> I64;
iter_filter = |arr| (
    arr.to_iter.filter(|x| x % 2 == 0).fold(0, |x, acc| acc + x)
);

main : IO ();
main = (
    let arr = Array::from_map(1000000, |i| i % 251);
    assert_eq(|_|"iter_filter", iter_filter(arr), 62748056);;
    pure()
);
