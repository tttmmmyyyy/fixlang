module Main;

import CPLib.String::calc_suffix_array;
import Speedtest::{check_answer, rands, PerfControl::{measure, start}};
import Std::{
    IO, String, Array::{@, push_back}, FromBytes::from_bytes, Functor::map, Iterator::{fold, range}, 
    Monad::pure, Result::as_ok, ToString::to_string, ToU8::u8
};

// The `suffix_array` of cp-library, run on the input `ref.cpp` gives ac-library. Only the part
// that calls the library is counted: `PerfControl` leaves generating the input out.

main : IO ();
main = (
    let control = *PerfControl::start;
    let n = 1000000;
    let s = from_bytes(rands(n, 26, 1_U64).map(|c| ('a' + c.u8)).push_back(0_U8)).as_ok : String;
    let sa = *control.measure(|_| calc_suffix_array(s));
    check_answer("suffix_array", range(0, n).fold(0, |i, acc| acc + sa.@(i) * i).to_string, "249973518341177452");;
    pure()
);
