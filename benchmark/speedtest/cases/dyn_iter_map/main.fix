module Main;

import Std::{Array, I64, IO, Array::{from_map, to_iter}, Debug::assert_eq, Iterator::{fold, map, to_dyn}, Monad::pure};

dyn_iter_map : Array I64 -> I64;
dyn_iter_map = |arr| (
    arr.to_iter.map(|x| x * 3).to_dyn.fold(0, |x, acc| acc + x)
);

main : IO ();
main = (
    let arr = Array::from_map(1000000, |i| i % 251);
    assert_eq(|_|"dyn_iter_map", dyn_iter_map(arr), 374994360);;
    pure()
);
