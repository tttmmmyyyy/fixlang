module Main;

// Minimal isolation of fannkuch's hot path: a tight loop of in-place array
// read+write (`arr.set(i, arr.@(i) + 1)`). The array is only ever held by the
// inner loop's state, so `set` takes the unique-reference (in-place) path; this
// isolates the per-element bounds-check + uniqueness-check overhead.
main : IO ();
main = (
    let args = *get_args;
    let iters : I64 = args.@(args.@size - 1).from_string.as_ok;
    let arr = Array::fill(1000, 0);
    let arr = loop((0, arr), |(k, arr)|
        if k == iters { break $ arr };
        let arr = loop((0, arr), |(i, arr)|
            if i == 1000 { break $ arr };
            continue $ (i + 1, arr.set(i, arr.@(i) + 1))
        );
        continue $ (k + 1, arr)
    );
    println $ arr.@(0).to_string
);
