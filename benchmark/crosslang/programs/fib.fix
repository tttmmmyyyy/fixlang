module Main;

// Naive recursive Fibonacci. Stresses function-call overhead and integer
// arithmetic (and, in Fix, whatever per-call cost the implementation adds).
fib : I64 -> I64;
fib = |n| (
    if n <= 1 { n } else { fib(n-1) + fib(n-2) }
);

main : IO ();
main = (
    let args = *get_args;
    // The single passed argument is the last element regardless of whether
    // get_args includes the program name at index 0.
    let n : I64 = args.@(args.@size - 1).from_string.as_ok;

    let t0 = *FFI_CALL_IO[I64 mono_nanos()];
    // `seed_i64` is an opaque identity ordered after t0, so `fib` cannot be
    // hoisted before the start timestamp.
    let n2 = *FFI_CALL_IO[I64 seed_i64(I64), n];
    let ans = fib(n2);
    // `sink_then_mono` consumes `ans`, so `fib` must finish before t1.
    let t1 = *FFI_CALL_IO[I64 sink_then_mono(I64), ans];

    println("fix,fib," + (t1 - t0).to_string + "," + ans.to_string)
);
