module Main;

// Tight loop with a carried dependency (the modulo prevents the optimizer from
// using a closed form or vectorizing). Stresses Fix's `loop`/`continue`/`break`
// lowering, integer add and integer division.
loopsum : I64 -> I64;
loopsum = |n| (
    loop((0, 0), |(i, acc)|
        if i == n { break $ acc };
        continue $ (i + 1, (acc + i) % 1000000007)
    )
);

main : IO ();
main = (
    let args = *get_args;
    let n : I64 = args.@(args.@size - 1).from_string.as_ok;

    let t0 = *FFI_CALL_IO[I64 mono_nanos()];
    let n2 = *FFI_CALL_IO[I64 seed_i64(I64), n];
    let ans = loopsum(n2);
    let t1 = *FFI_CALL_IO[I64 sink_then_mono(I64), ans];

    println("fix,loop," + (t1 - t0).to_string + "," + ans.to_string)
);
