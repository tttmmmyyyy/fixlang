module Main;

// A function built from the one `relay` was given, called both directly and through the lambda that
// captures it and is handed to `fold`.

// Recursive, so that they stay functions of their own rather than being expanded into their callers.
terminal : (I64 -> I64) -> I64 -> I64;
terminal = |op, n| (
    if n <= 0 { 0 };
    op(n) + terminal(op, n - 1)
);

relay : (I64 -> I64) -> I64 -> I64;
relay = |op, n| (
    if n <= 0 { 0 };
    let shifted = |x| op(x) + 1;
    Iterator::range(0, n).fold(0, |i, acc| acc + terminal(shifted, i))
        + shifted(n)
        + relay(op, n - 1)
);

main : IO () = (
    let k = 3;
    println(relay(|x| x * k, 4).to_string)
);
