main : IO ();
main = (
    let k = (*get_args).@size;
    let a = gbv.to_iter.map(score_b).sum + guv.to_iter.map(score_u).sum;
    let b = score_b(gone_b) + score_u(gone_u) + score_b(gbv.@(k * 7)) + score_u(guv.@(k * 9));
    let c = match gone_b { v117((s, arr)) => s + arr.@(0), _ => "other" };
    let d = match gone_u { v0(a) => a.@size, _ => -1 };
    println $ a.to_string + " " + b.to_string + " " + c + " " + d.to_string
);
