module Main;

// A boxed struct and a boxed union, each built once here and once as a global, so the same
// `destructure` and `match` shapes appear with a local container and with a global one.
type Pair = box struct { head : Array I64, tail : Array I64 };
type Holder = box union { some : Array I64, none : () };

gpair : Pair;
gpair = Pair { head : [1, 2], tail : [3, 4] };

gholder : Holder;
gholder = Holder::some([5, 6]);

// An array holding `elements`, built at run time. An array literal of numbers is a constant the
// whole program shares, so the value a case means to build here passes through this.
built_here : Array I64 -> Array I64;
built_here = |elements| elements.to_iter.to_array;

// Both fields are read, and a field longer than `fallback` is returned in its place. The result is
// a field on one path and `fallback` on another, so each read in an arm retains its
// field.
longer_of_pair : Array I64 -> Pair -> Array I64;
longer_of_pair = |fallback, pair| (
    if pair.@head.@size > fallback.@size { pair.@head }
    else if pair.@tail.@size > fallback.@size { pair.@tail }
    else { fallback }
);

// A `match` on a boxed union retains the payload out of the container, which is the take-out rule.
sum_holder : Holder -> I64;
sum_holder = |holder| match holder {
    some(arr) => arr.@(0),
    none(_) => 0
};

// `as_some` reads the payload through an operation instead, which counts the reference inside
// itself rather than at a node of its own.
head_of_holder : Holder -> I64;
head_of_holder = |holder| if holder.is_some { holder.as_some.@(0) } else { 0 };

// A struct pattern reads both fields out of a boxed container, each with the getter `@head` and
// `@tail` use. The result is a field on one path and `fallback` on another, so the reads retain
// both fields and the ones not returned are released.
longer_by_pattern : Array I64 -> Pair -> Array I64;
longer_by_pattern = |fallback, pair| (
    let Pair { head : h, tail : t } = pair;
    if h.@size > fallback.@size { h } else if t.@size > fallback.@size { t } else { fallback }
);

// The callback writes through a raw pointer into the array's payload, so an array of boxed elements
// may afterwards hold a reference to anything, the global's graph included. The function returns the
// whole pair `mutate_elements` gives back, so that the caller binds the array to a name of its own
// with a tuple pattern.
plant_global : Array (Array I64) -> (Array (Array I64), ());
plant_global = |arr| arr.mutate_elements(|_| pure());

// The same write over a payload of scalars, which holds no reference at all.
plant_scalars : Array I64 -> (Array I64, ());
plant_scalars = |arr| arr.mutate_elements(|_| pure());

main : IO ();
main = (
    let local_pair = Pair { head : built_here([10, 20]), tail : built_here([30, 40]) };
    let local_holder = Holder::some(built_here([50, 60]));

    let fallback = built_here([0]);
    let from_local = local_pair.longer_of_pair(fallback).@(0) + local_holder.sum_holder
                   + local_pair.longer_by_pattern(fallback).@(0) + local_holder.head_of_holder;
    let from_global = gpair.longer_of_pair(fallback).@(0) + gholder.sum_holder
                    + gpair.longer_by_pattern(fallback).@(0) + gholder.head_of_holder;

    // Every element is built here, so what the array holds turns on the write alone.
    let (planted, _) = [built_here([70]), built_here([80])].plant_global;
    // The elements are put into a new array once `planted` has been released, so each read retains
    // its element.
    let elements = [planted.@(0), planted.@(1)];
    let from_planted = elements.@(0).@(0) + elements.@(1).@(0);

    // The same write over a payload of scalars, which holds no reference for the callback to
    // overwrite and so keeps both facts.
    let (scalars, _) = [90, 100].plant_scalars;
    let from_scalars = scalars.@(0) + scalars.@(1);

    println $ (from_local + from_global + from_planted + from_scalars).to_string
);
