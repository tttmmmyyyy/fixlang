module Main;

// The shift amount reaches the width of `I64`. Under the check the program stops there; without
// the check the amount is taken modulo the width, so the shift leaves the value where it is and the
// program prints it and exits.
//
// The amount comes from the count of the program's arguments, which is one wherever the program
// runs and which the compiler cannot fold the shift away through.
main : IO ();
main = (
    let args = *IO::get_args;
    let one = args.@size;
    println(1.shift_left(one * 64).to_string)
);
