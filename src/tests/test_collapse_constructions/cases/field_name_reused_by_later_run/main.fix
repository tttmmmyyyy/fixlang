module Main;

g_val : I64;
g_val = "abcdefg".get_size;

// `step` calls itself, so `inline` leaves it and closure specialization makes a copy of it that the
// lambda's body is put into. The lambda's body carries the names the first run of
// `collapse_constructions` bound for the fields of the triple, and the pair built in it holds a
// computed field that the second run binds to a name of its own.
step : (I64 -> (Option I64, I64, I64)) -> I64 -> I64 -> I64;
step = |f, i, acc| if i == 0 { acc } else {
    let (o, v, w) = f(i);
    let acc = match o { some(x) => acc + x + v + w, none() => acc + v + w + 1000 };
    step(f, i - 1, acc)
};

main : IO ();
main = (
    let n = *(pure $ 7);
    println $ step(|i| (some(i * 3), i + n, (none() : Option I64, g_val).@1), 3, 0).to_string
);
