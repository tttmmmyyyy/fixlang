module Main;

// Read-only recursion: `arr` is only read, so it is inferred Borrow and `tally` gets a borrow
// version.
tally : Array I64 -> I64 -> I64;
tally = |arr, i| (
    if i == arr.@size { 0 } else { arr.@(i) + tally(arr, i + 1) }
);

main : IO ();
main = (
    pure();;
    let arr = Array::fill(4, 1);
    // The call ends its branch, and nothing after the `if` names `arr`: the call is the array's
    // last use, so the own version moves it in and frees it, and borrowing it would only delay its
    // release.
    let a = if arr.@(0) == 1 { tally(arr, 0) } else { 0 };
    println $ a.to_string
);
