module Main;

// Consumes the whole unboxed pair (both boxed fields owned): it hands the pair back. Recursive to
// survive inlining.
hand_back : (Array I64, Array I64) -> I64 -> (Array I64, Array I64);
hand_back = |t, n| (
    if n == 0 { t } else { hand_back(t, n - 1) }
);

main : IO ();
main = (
    let t = (Array::fill(2, 1), Array::fill(3, 2));
    // `t` is used at two consuming calls, so it is non-last-use at the first: lowering emits a
    // whole-value retain of `t`, which unit normalization splits into one retain per field.
    let a = hand_back(t, 1).@0.get_size;
    let b = hand_back(t, 1).@1.get_size;
    println $ (a + b).to_string
);
