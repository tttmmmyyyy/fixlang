module Main;

// Writing through the pointer to a boxed value's payload clones the value when something else
// holds it, and hands back one nothing else holds. Both halves of that are declared: the check is
// dropped on a value already proven unique (rendered `[unique]`), and the value each write returns
// is `fresh`, so the next write has nothing left to check. Both the plain and the IO-context
// variant are exercised here. The program prints a literal rather than a number because rendering
// one itself writes through a pointer, which would put an unrelated write in the dump.
type Rec = box struct { x : I64, y : I64 };

main : IO ();
main = (
    let (mutated, _) = Rec { x : 1, y : 2 }.mutate_boxed(|_| pure());
    let (mutated_io, _) = *mutated.mutate_boxed_io(|_| pure());
    eval mutated_io;
    println("mutate_boxed")
);
