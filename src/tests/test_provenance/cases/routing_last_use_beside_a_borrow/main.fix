module Main;

// Reads `key`, and updates an array read out of `rows`. Neither parameter is consumed, so both are
// inferred Borrow and `tally` gets a borrow version. Recursive, so the inliner leaves it a call.
tally : I64 -> Array (Array I64) -> Array I64 -> I64;
tally = |d, rows, key| (
    if d > 0 { tally(d - 1, rows, key) };
    let row = rows.@(0);
    let row = row.set(0, key.@(0));
    row.@(0) + row.@(1)
);

main : IO ();
main = (
    pure();;
    let key = Array::fill(3, 7);
    // `rows` ends at the call and `key` is read after it. The own version frees `rows` once it has
    // read `row` out of it, so `row` is unique at the `set`; borrowing `rows` keeps it alive across
    // the call, and the `set` copies `row`.
    let rows = [Array::fill(4, 1)];
    let a = tally(0, rows, key);
    let b = key.@(1);
    println $ (a + b).to_string
);
