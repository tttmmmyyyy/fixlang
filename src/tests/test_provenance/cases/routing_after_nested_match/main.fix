module Main;

// Read-only recursion: `arr` is only read, so it is inferred Borrow and `tally` gets a borrow
// version.
tally : Array I64 -> I64 -> I64;
tally = |arr, i| (
    if i == arr.@size { 0 } else { arr.@(i) + tally(arr, i + 1) }
);

main : IO ();
main = (
    pure();;
    let arr = Array::fill(4, 1);
    // The call ends a branch of the inner `if`, whose result ends a branch of the outer one, and
    // `arr` is read again only after the outer `if`: routing to the borrow version cancels the
    // retain that read would otherwise need.
    let a = if arr.@(0) == 1 { if arr.@(1) == 1 { tally(arr, 0) } else { 1 } } else { 0 };
    let a2 = arr.@size;
    println $ (a + a2).to_string
);
