module Main;

// An unboxed union, whose reference-counting unit is the union itself while its leaf lies inside
// the `full` variant.
type Slot = unbox union { empty : (), full : Array I64 };

// Read-only recursion: `slot` is only read, so it is inferred Borrow and `tally` gets a borrow
// version.
tally : Slot -> I64 -> I64;
tally = |slot, i| (
    if slot.is_empty { 0 };
    let arr = slot.as_full;
    if i == arr.@size { 0 } else { arr.@(i) + tally(slot, i + 1) }
);

main : IO ();
main = (
    pure();;
    // The union built for the call holds `arr`, which is read after the call, so routing to the
    // borrow version removes the retain made for the call.
    let arr = Array::fill(4, 1);
    let t = tally(Slot::full(arr), 0);
    let k = arr.@(0);
    println $ (t + k).to_string
);
