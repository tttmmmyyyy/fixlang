module Main;

// Read-only recursion: `arr` is only read, so it is inferred Borrow and `tally` gets a borrow
// version.
tally : Array I64 -> I64 -> I64;
tally = |arr, i| (
    if i == arr.@size { 0 } else { arr.@(i) + tally(arr, i + 1) }
);

// An array beside a scalar, so that a call can be handed the array read out of the pair.
type Env = unbox struct { table : Array I64, key : I64 };

// Recursive, so the inliner leaves it a call and what it answers with is a value the caller reads a
// leaf out of.
//
// # Parameters
// * `n` - How far the key is raised above the value it starts at.
build : I64 -> Env;
build = |n| (
    if n == 0 { Env { table : Array::fill(4, 1), key : 3 } };
    build(n - 1).mod_key(|k| k + 1)
);

main : IO ();
main = (
    pure();;
    let n = Array::fill(1, 2).@(0);
    // `env` is `e1` or `e2`, and both are read after the call while `env` is not, so the array
    // `env.@table` holds is alive past the call on either branch.
    let e1 = build(2);
    let e2 = build(3);
    let env = if n == 2 { e1 } else { e2 };
    let t = tally(env.@table, 0);
    let k = e1.@key + e2.@key;
    // Only `f1` is read after the call, so where `env2` is `f2` the array ends at the call.
    let f1 = build(4);
    let f2 = build(5);
    let env2 = if n == 2 { f1 } else { f2 };
    let u = tally(env2.@table, 0);
    let l = f1.@key;
    println $ (t + k + u + l).to_string
);
