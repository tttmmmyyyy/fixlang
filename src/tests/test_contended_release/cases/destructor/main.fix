module Main;

// Takes one reference to the round's value and drops it, together with every other thread of the
// round.
drop_one : Ptr -> IO ();
drop_one = |ptr| (
    let value : Destructor I64 = *FFI::boxed_from_retained_ptr(ptr);
    FFI_CALL_IO[() wait_at_gate()];;
    // Reading the resource is this thread's last use of the value, so the reference it holds is
    // dropped here, as close behind the gate as the language puts it.
    if value.@_value < 0 { undefined("the resource should be the number of the round") };
    pure()
);
FFI_EXPORT[drop_one, fix_drop_one];

start_workers : I64 -> IO ();
start_workers = |threads| FFI_CALL_IO[() start_workers(CInt), threads.c_int];

stop_workers : IO ();
stop_workers = FFI_CALL_IO[() stop_workers()];

run_round : Ptr -> IO ();
run_round = |ptr| FFI_CALL_IO[() run_round(Ptr), ptr];

// How many times a destructor function has run since the program started.
destructor_run_count : IO CInt;
destructor_run_count = FFI_CALL_IO[CInt destructor_run_count()];

// Takes `count` references to `value` and returns the pointer they all name, one for each thread to
// drop.
retain_many : I64 -> Destructor I64 -> IO Ptr;
retain_many = |count, value| (
    loop_m((0, nullptr), |(i, ptr)|
        if i == count { break_m $ ptr };
        let ptr = *value.FFI::boxed_to_retained_ptr;
        continue_m $ (i + 1, ptr)
    )
);

// Builds one value whose destructor function reports that it ran, hands it to every thread, and
// lets them all drop it at once. Nothing here holds the value once the references are taken, so the
// threads hold every one of them and the last release comes from one of them.
one_round : I64 -> I64 -> IO ();
one_round = |threads, resource| (
    let value = *Destructor::make(resource, |resource| (
        FFI_CALL_IO[() note_destructor_ran()];;
        pure $ resource
    ));
    let value = value.mark_threaded;
    let ptr = *value.retain_many(threads);
    run_round(ptr)
);

main : IO ();
main = (
    let args = *get_args;
    let rounds : I64 = args.@(1).from_string.as_ok;
    let threads : I64 = args.@(2).from_string.as_ok;

    start_workers(threads);;
    loop_m(0, |round|
        if round == rounds { break_m $ () };
        one_round(threads, round);;
        continue_m $ round + 1
    );;
    stop_workers;;

    let runs = *destructor_run_count;
    println(
        if runs == rounds.c_int { "ok" };
        "the destructor ran " + runs.to_string + " times for " + rounds.to_string + " values"
    )
);
