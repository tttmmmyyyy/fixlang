module Main;

// How many elements the array holds, and how long the thread that lets go of the value waits
// before doing so, in microseconds. Both come from the command line.
settings : IO (I64, I64);
settings = (
    let args = *get_args;
    pure $ (args.@(1).from_string.as_ok, args.@(2).from_string.as_ok)
);

// Plugs an element into the shared punched array. The storage is shared, so the plug copies the
// elements into a storage of its own -- leaving out the slot whose element was moved out, which the
// punched array does not own -- and lets go of the shared storage. That release is the one the
// other thread turns into the last: it has to release every element the storage holds except the
// one in the hole.
worker_plug : Ptr -> IO ();
worker_plug = |ptr| (
    let holder : Box (PunchedArray (Box I64)) = *FFI::boxed_from_retained_ptr(ptr);
    let punched = holder.@value;

    // The other thread is still holding the value, so this plug finds the storage shared and copies
    // it. Reading that here is what makes a run whose two threads did not overlap report itself,
    // rather than pass without ever making the copy the release under test belongs to.
    let (unique, _) = punched.@_arr._unsafe_is_storage_unique;
    if unique { println("missed: the storage was this thread's own by the time the plug began") };

    let arr = punched._unsafe_plug_bounds_unchecked(Box::make(-1));
    if arr.@(0).@value > 0 { undefined("the hole should hold the element plugged into it") };
    if arr.@(1).@value < 0 { undefined("the elements should survive the copy") };
    pure()
);
FFI_EXPORT[worker_plug, fix_worker_plug];

// Lets go of the value while the other thread is copying the elements out of the storage.
worker_drop : Ptr -> IO ();
worker_drop = |ptr| (
    let holder : Box (PunchedArray (Box I64)) = *FFI::boxed_from_retained_ptr(ptr);
    let (_, delay) = *settings;
    FFI_CALL_IO[CInt usleep(CInt), delay.c_int];;
    if holder.@value.@_idx < 0 { undefined("the punched array should have a hole") };
    pure()
);
FFI_EXPORT[worker_drop, fix_worker_drop];

run_workers : Ptr -> IO ();
run_workers = |ptr| FFI_CALL_IO[() run_workers(Ptr), ptr];

// Takes `count` references to `value` and returns the pointer they all name, one for each thread to
// drop.
retain_many : I64 -> Box (PunchedArray (Box I64)) -> IO Ptr;
retain_many = |count, value| (
    loop_m((0, nullptr), |(i, ptr)|
        if i == count { break_m $ ptr };
        let ptr = *value.FFI::boxed_to_retained_ptr;
        continue_m $ (i + 1, ptr)
    )
);

// Whether nobody but the caller holds `value`, asked in the `IO` context so that the answer is read
// once the threads have finished rather than wherever the question could be moved to.
is_unique_io : Box I64 -> IO Bool;
is_unique_io = |value| IO::from_runner $ |ios| (ios, value.unsafe_is_unique.@0);

main : IO ();
main = (
    let (element_count, _) = *settings;

    // One object in every slot the storage owns and another in the slot whose element is moved out,
    // so that the two reference counts report which slots a release walked. A boxed value built
    // from a literal is a global, and a global carries no count at all, so both are built from the
    // program's own arguments.
    let args = *get_args;
    let element = Box::make(args.@(0).@size);
    let hole_marker = Box::make(0 - args.@(0).@size);
    let arr = Array::fill(element_count, element).set(0, hole_marker);

    // Moving the element at slot 0 out leaves that slot as the hole. `hole_elem` takes over the
    // reference the slot held, so the storage no longer owns it.
    let (punched, hole_elem) = PunchedArray::_unsafe_punch_bounds_unchecked(0, arr);
    let value = Box::make(punched).mark_threaded;

    // Nothing here holds the punched array any more: the two threads hold every reference to it, so
    // the last release of the storage comes from one of them.
    let ptr = *value.retain_many(2);
    run_workers(ptr);;

    // The elements the storage owned are back to this thread's own reference, and the hole's
    // element is still held twice -- by this thread and by what the punch handed back. A release
    // that walked the hole would have dropped one of those two.
    let elements_released = *element.is_unique_io;
    let hole_kept = *hole_marker.is_unique_io.map(|unique| !unique);
    eval hole_elem;
    println(
        if !elements_released { "the storage was freed without releasing the elements it held" };
        if !hole_kept { "the release walked the hole and let go of an element the storage does not own" };
        "ok"
    )
);
