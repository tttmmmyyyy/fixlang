module Main;

// A `match` over an `Option` that the branches of an `if` build, whose result `step` goes on to
// compute with. The outer arms move into the branches, and the computation after the match stays
// after it, so no `Option` is built.
step : I64 -> I64;
step = |n| (
    let r = match (if n % 3 == 0 { Option::some(n + 1) } else { Option::none() }) {
        some(v) => v * 2,
        none() => -1
    };
    r * r + n
);

main : IO ();
main = (
    println $ Iterator::range(0, 10).map(step).to_array.to_string
);
