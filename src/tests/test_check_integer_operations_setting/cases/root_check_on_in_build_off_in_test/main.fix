module Main;

// The sum leaves the range of `I64`, which the check stops the program at. Without the check the
// sum is taken modulo two to the width of the type, so the program prints it and exits.
//
// The operand comes from the count of the program's arguments, which is one wherever the program
// runs and which the compiler cannot fold the arithmetic away through.
main : IO ();
main = (
    let args = *IO::get_args;
    let one = args.@size;
    println((I64::maximum * one + one).to_string)
);
