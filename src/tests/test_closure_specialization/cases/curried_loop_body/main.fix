module Main;

// A state monad: a computation that reads a counter, returns a value and hands the counter on.
type St a = unbox struct { _run : I64 -> (a, I64) };

namespace St {
    run : I64 -> St a -> (a, I64);
    run = |s, m| (m.@_run)(s);
}

impl St : Monad {
    pure = |v| St { _run : |s| (v, s) };
    bind = |f, m| St { _run : |s| let (v, s) = m.run(s); f(v).run(s) };
}

// Adds the counter to `total` once per round, moving the counter on by one, until the counter
// reaches `limit`.
//
// The loop body returns its action directly, so its lambda and the one the action holds are
// written one inside the other. The copy of `Std::loop_m` made for the body calls it with the
// accumulator alone, and applies what it returns to the counter.
//
// # Parameters
// * `limit` - The counter at which the rounds stop.
sum_counter : I64 -> St I64;
sum_counter = |limit| loop_m(0, |total| St { _run : |s|
    if s >= limit { (break $ total, s) };
    (continue $ total + s, s + 1)
});

main : IO ();
main = (
    let (total, _) = sum_counter(10).St::run(3);
    println(total.to_string)
);
