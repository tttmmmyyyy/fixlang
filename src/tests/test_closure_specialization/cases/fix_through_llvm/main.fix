module Main;

// `Std::fix` is an inline-LLVM expression, and an inline-LLVM expression reads variables only. A
// closure reaching one is therefore bound to a name first, and a name holding a bare capture list
// has to be wrapped back into a closure before that binding is made.

apply_twice : (I64 -> I64) -> I64 -> I64;
apply_twice = |op, n| (
    if n <= 0 { 0 };
    op(op(n)) + apply_twice(op, n - 1)
);

main : IO () = (
    let k = 3;
    let step = |rec, n| if n <= 0 { 0 } else { n + rec(n - 1) };
    let s = Std::fix(step, 10);
    let f = |x| x * k;
    let t = apply_twice(f, 2);
    let u = Std::fix(|rec, n| if n <= 0 { 0 } else { f(n) + rec(n - 1) }, 4);
    println((s + t + u).to_string)
);
