module Main;

// A closure built from the one the function was given, used both directly and through a relay. The
// capture list of the lambda that carries `shifted` into `fold` holds `shifted`, which is itself a
// capture list once lifted, so specializing `relay` changes the type of what that field holds.

// Recursive, so that they stay functions of their own rather than being expanded into their callers.
terminal : (I64 -> I64) -> I64 -> I64;
terminal = |op, n| (
    if n <= 0 { 0 };
    op(n) + terminal(op, n - 1)
);

relay : (I64 -> I64) -> I64 -> I64;
relay = |op, n| (
    if n <= 0 { 0 };
    let shifted = |x| op(x) + 1;
    Iterator::range(0, n).fold(0, |i, acc| acc + terminal(shifted, i))
        + shifted(n)
        + relay(op, n - 1)
);

main : IO () = (
    let k = 3;
    println(relay(|x| x * k, 4).to_string)
);
