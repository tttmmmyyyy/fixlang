module Main;

// One closure reached three ways from inside the lambda that captures it: called there, handed to a
// function that calls it, and handed to a function nothing reaches a direct call through. Narrowing
// the capture field has to serve the first two and leave the third a closure, so the narrowed value
// has to wrap back into one at that third place.

// Recursive, so that they stay functions of their own rather than being expanded into their callers.
terminal : (I64 -> I64) -> I64 -> I64;
terminal = |op, n| (
    if n <= 0 { 0 };
    op(n) + terminal(op, n - 1)
);

// Nothing reaches a direct call through `op` here: it goes into an array first.
opaque : (I64 -> I64) -> I64 -> I64;
opaque = |op, n| (
    let a : Array (I64 -> I64) = [op];
    let f = a.@(0);
    f(n)
);

relay : (I64 -> I64) -> I64 -> I64;
relay = |op, n| (
    if n <= 0 { 0 };
    Iterator::range(0, n).fold(0, |i, acc| acc + op(i) + terminal(op, i) + opaque(op, i))
        + relay(op, n - 1)
);

main : IO () = (
    let k = 5;
    println(relay(|x| x * k + 1, 4).to_string)
);
