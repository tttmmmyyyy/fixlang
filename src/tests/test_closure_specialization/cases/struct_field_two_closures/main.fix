module Main;

// Two of the struct's fields hold a function, so a copy takes two capture lists, standing after the
// struct in the order the fields are declared. The destructuring names them in another order, which
// is the order the source has rather than the order the declaration does.
type Pair = unbox struct { n : I64, f : I64 -> I64, g : I64 -> I64 };

stepping : I64 -> Pair -> I64;
stepping = |acc, s| (
    let Pair { n : n, g : g, f : f } = s;
    if n == 0 { acc };
    stepping(acc + f(n) * 100 + g(n), Pair { n : n - 1, f : f, g : g })
);

main : IO () = (
    let k = 3;
    let f = |x| x * k;
    let m = 7;
    let g = |x| x + m;
    println((stepping(0, Pair { n : 4, f : f, g : g }) + stepping(0, Pair { n : 2, f : f, g : g })).to_string)
);
