module ThreadingLib;

// Gives a pointer through which another thread takes a value, as a threading library does before
// handing a value over. The body spans several lines so that a diagnostic about the call has to
// point at the call alone.
publish : Box I64 -> IO Ptr;
publish = |value| (
    let contents = value.@value;
    let boxed = Box::make(contents);
    FFI::pack_for_thread(boxed)
);

// Publishes a value of another type, so that `Std::FFI::pack_for_thread` is instantiated twice.
publish_array : Array I64 -> IO Ptr;
publish_array = |values| FFI::pack_for_thread(values);

// Needs nothing of multi-threading, so a program that uses only this is built without it.
double : I64 -> I64;
double = |value| value * 2;
