module Main;

import ThreadingLib;

main : IO ();
main = (
    let value : Box I64 = *FFI::unpack_from_thread(*ThreadingLib::publish(Box::make(42)));
    let values : Array I64 = *FFI::unpack_from_thread(*ThreadingLib::publish_array([1, 2, 3]));
    let total : Box I64 = *FFI::unpack_from_thread(*FFI::pack_for_thread(Box::make(value.@value + values.@(0))));
    println(total.@value.to_string)
);
