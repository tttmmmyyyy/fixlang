module Main;

// Takes one reference to the object the shared value holds, takes and drops many more, writes
// through it, and drops the one it was handed. The reference counts the threads run through here
// are what they contend over, and because the threads hold every reference, all three answers the
// counting can give are reached under contention: a count that stays above one, a count that
// reaches one and lets a write happen in place, and a count that reaches zero and destroys the
// value while other threads are still working.
//
// The object hammered here is the one the shared value owns, so its count is one the hand-over has
// to have reached: a hand-over that marked the value's own object and stopped there leaves this
// count updated non-atomically while eight threads run through it.
//
// Written in `IO` so that the reference counting survives optimization. Run through
// `IO::unsafe_perform` instead, the loop's result goes unused and the whole loop is removed --
// eight threads then share a value without touching its count and the control cannot fail.
hammer_one : Ptr -> IO ();
hammer_one = |ptr| (
    let value : Box (Box I64) = *FFI::unpack_from_thread(ptr);
    let inner = value.@value;
    loop_m(0, |i|
        if i == 4000 { break_m $ () };
        let ptr = *inner.FFI::boxed_to_retained_ptr;
        let taken : Box I64 = *FFI::boxed_from_retained_ptr(ptr);
        if taken.@value < 0 { undefined("the shared value was destroyed while a thread still held it") };
        continue_m $ i + 1
    );;

    // A write through the handle. Whichever thread finds itself the only holder left takes the
    // uniqueness check's unique answer and writes in place; the others find the value shared and
    // write to a copy of their own.
    let inner = inner.set_value(inner.@value + 1);
    if inner.@value < 0 { undefined("the shared value was destroyed while a thread still held it") };
    pure()
);
FFI_EXPORT[hammer_one, fix_hammer_one];

hammer_from_threads : Ptr -> I64 -> IO ();
hammer_from_threads = |ptr, threads| (
    FFI_CALL_IO[() hammer_from_threads(Ptr, CInt), ptr, threads.c_int]
);

// Hands `value` over `count` times through `hand_over` and returns the pointer every hand-over
// names, one reference for each thread to drop. The value is boxed, so each pointer names its object.
hand_over_many : (Box (Box I64) -> IO Ptr) -> I64 -> Box (Box I64) -> IO Ptr;
hand_over_many = |hand_over, count, value| (
    loop_m((0, nullptr), |(i, ptr)|
        if i == count { break_m $ ptr };
        let ptr = *hand_over(value);
        continue_m $ (i + 1, ptr)
    )
);

main : IO ();
main = (
    let args = *get_args;

    // A boxed value built from a literal is a global, and a global carries no reference count at
    // all -- the threads would have nothing to contend over and the program would look correct
    // however it was written. Building the value from the program's own arguments is what puts it
    // on the heap with a count. The length of `argv[0]` is the same on both of this program's runs,
    // so the value it holds is too.
    // The value holds another boxed object, so that the hand-over is asked to reach past the object
    // it is given.
    let value = Box::make(Box::make(args.@(0).@size));

    // An argument asks for the value to be handed over the way the language says to, through
    // `pack_for_thread`. Run without it, the value is handed over through `boxed_to_retained_ptr`,
    // which leaves it in single-threaded mode: the reference counts are updated non-atomically
    // while eight threads share the value, which is the race this program exists to produce.
    let hand_over = if args.@size >= 2 { FFI::pack_for_thread } else { FFI::boxed_to_retained_ptr };

    let threads = 8;
    let ptr = *value.hand_over_many(hand_over, threads);

    // Nothing here holds the value any more: the threads hold every reference to it, so whichever
    // of them finishes last is the one that destroys it, and the destructor runs while the others
    // are still working. Reading the value after this would keep a reference and leave the
    // destruction to this thread alone.
    hammer_from_threads(ptr, threads);;
    println("ok")
);
