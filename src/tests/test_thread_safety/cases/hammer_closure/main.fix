module Main;

// Takes the pair out of the box the pointer names, and takes and drops many references to the
// closure and to the box inside the `Option`. The closure's captured array is counted each time the
// closure is, so the threads count the capture under contention as well.
hammer_one : Ptr -> IO ();
hammer_one = |ptr| (
    let v : (I64 -> I64, Option (Box I64)) = *FFI::unpack_from_thread(ptr);
    let (f, o) = v;
    loop_m(0, |i|
        if i == 4000 { break_m $ () };
        let q = *FFI::boxed_to_retained_ptr(Box::make(f));
        let g : Box (I64 -> I64) = *FFI::boxed_from_retained_ptr(q);
        let q = *FFI::boxed_to_retained_ptr(o.as_some);
        let b : Box I64 = *FFI::boxed_from_retained_ptr(q);
        if (g.@value)(0) + b.@value < 0 { undefined("the shared value was destroyed while a thread still held it") };
        continue_m $ i + 1
    )
);
FFI_EXPORT[hammer_one, fix_hammer_one];

main : IO ();
main = (
    let args = *get_args;
    // Built from the program's arguments, so that the boxed values are on the heap with a count.
    let n = args.@(0).@size;
    let arr = Array::fill(n, n);
    let f = |i| arr.@(i) + 1;
    let threads = 8;
    let v = (f, Option::some(Box::make(n)));
    // With `mark` as the argument, the pair goes through `pack_for_thread`. Without it, it goes
    // through `boxed_to_retained_ptr` of a box of the same layout, which leaves the counts in
    // single-threaded mode, so the run has a race to report.
    let ptr = *(if args.@size >= 2 { FFI::pack_for_thread(v) } else { FFI::boxed_to_retained_ptr(Box::make(v)) });
    let retain = (|_| undefined("") : (I64 -> I64, Option (Box I64))).FFI::get_funptr_retain_for_thread;
    loop_m(1, |i|
        if i == threads { break_m $ () };
        FFI_CALL_IO[() call_refcount_funptr(Ptr, Ptr), retain, ptr];;
        continue_m $ i + 1
    );;
    FFI_CALL_IO[() hammer_from_threads(Ptr, CInt), ptr, threads.c_int];;
    println("ok")
);
