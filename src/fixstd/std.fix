        } else {
            let q = F64::_compute_log10_pow5(-e2);
            let e10 = q + e2;
            let i = -e2 - q;
            let j = q - (F64::_compute_pow5_bits(i) - F32::_pow5_bitcount);
            let vr = _multiply_pow5_shift(mv, i, j);
            let vp = _multiply_pow5_shift(mp, i, j);
            let vm = _multiply_pow5_shift(mm, i, j);
            let last_removed_digit = if q != 0 && (vp - 1_U32) / 10_U32 <= vm / 10_U32 {
                let j = q - 1 - (F64::_compute_pow5_bits(i + 1) - F32::_pow5_bitcount);
                _multiply_pow5_shift(mv, i + 1, j) % 10_U32
            } else { 0_U32 };
            if q <= 1 {
                // `mv` has at least two trailing zero bits, and `mm` has one where `mm_shift` is 1.
                if accept_bounds { (vr, vp, vm, e10, mm_shift == 1_U32, true, last_removed_digit) };
                // `mp` has at least one trailing zero bit.
                (vr, vp - 1_U32, vm, e10, false, true, last_removed_digit)
            };
            if q < 31 { (vr, vp, vm, e10, false, mv.bit_and(1_U32.shift_left((q - 1).u32) - 1_U32) == 0_U32, last_removed_digit) };
            (vr, vp, vm, e10, false, false, last_removed_digit)
        };
        let (mantissa, exponent) = if vm_is_trailing_zeros || vr_is_trailing_zeros {
            // The general case, which needs the digits removed from `vr` and whether those of `vm`
            // are zeros.
            let (vr, vp, vm, removed, last_removed_digit, vm_is_trailing_zeros, vr_is_trailing_zeros) = loop(
                (vr, vp, vm, 0, last_removed_digit, vm_is_trailing_zeros, vr_is_trailing_zeros),
                |(vr, vp, vm, removed, last_removed_digit, vm_zeros, vr_zeros)| (
                    if vp / 10_U32 <= vm / 10_U32 { break $ (vr, vp, vm, removed, last_removed_digit, vm_zeros, vr_zeros) };
                    continue $ (vr / 10_U32, vp / 10_U32, vm / 10_U32, removed + 1, vr % 10_U32, vm_zeros && vm % 10_U32 == 0_U32, vr_zeros && last_removed_digit == 0_U32)
                )
            );
            let (vr, vm, removed, last_removed_digit, vr_is_trailing_zeros) = if vm_is_trailing_zeros {
                loop((vr, vp, vm, removed, last_removed_digit, vr_is_trailing_zeros), |(vr, vp, vm, removed, last_removed_digit, vr_zeros)| (
                    if vm % 10_U32 != 0_U32 { break $ (vr, vm, removed, last_removed_digit, vr_zeros) };
                    continue $ (vr / 10_U32, vp / 10_U32, vm / 10_U32, removed + 1, vr % 10_U32, vr_zeros && last_removed_digit == 0_U32)
                ))
            } else {
