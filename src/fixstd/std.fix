// Module `Std` provides basic types, traits and values.
// 
// This module is special in the sense that: 
//
// - It is always imported implicitly. If you don't want to import some or all of entities in this module, you should write `import Std {...entities...}` explicitly.
// - It contains built-in types or values which are defined or implemented directly by Fix compiler, not by Fix source code.
// 
// NOTE on tuples: 
// The tuple types `Std::TupleN` are defined on demand, i.e., if the user uses N-tuple in the source code, 
// the compiler generates definition `TupleN` and related functions / trait implementations.
// The document for `Std` module describes about them up to N=3, but you can use larger tuples in the same way.
module Std;

// Generates an undefined value.
//
// Calling this function prints `msg` to the stderr, flush stderr, and aborts the program (calls `abort` in libc).
// Since `undefined(msg)` has generic type `a`, you can put it anywhere and it will be type-checked.
// 
// This is useful when you want to write a placeholder that will be implemented later:
// 
// ```fix ignore
// truth : I64;
// truth = undefined("I will implement the truth later.");
// ```
// 
// Another use case is aborting the program when a certain branch of the code should not be reached:
// 
// ```fix ignore
// if condition {
//     // Do something.
// } else {
//     undefined("This branch should not be reached.");
// }
// ```
// 
// When the `--no-runtime-check` option is enabled, the compiler assumes that the program will never reach `undefined`.
// This may lead to improved performance by eliminating branches like the one in the above example, 
// but if the program does reach `undefined`, it will result in undefined behavior.
// 
// # Parameters
// * `msg` - The message to print to the stderr when the undefined value is reached.
undefined : String -> a = |msg| msg.@_data._undefined_internal;

// The type of boolean values. The `true` / `false` keywords desugar to the constructors
// `_true()` / `_false()`.
type Bool = unbox union { _false : (), _true : () };

// A union type with variants `continue` and `break`.
//
// This type is used to represent the result of a loop body function passed to `Std::loop` or other similar functions.
type LoopState s r = unbox union { continue : s, break : r };

// `loop` enables you to make a loop. `LoopState` is a union type defined as follows: 
// 
// ```fix ignore
// type LoopState s r = unbox union { continue : s, break : r };
// ```
// 
// `loop` takes two arguments: the initial state of the loop `s0` and the loop body function `body`. 
// It first calls `body` on `s0`. 
// If `body` returns `break(r)`, then the loop ends and returns `r` as the result. 
// If `body` returns `continue(s)`, then the loop calls again `body` on `s`.
// 
// Example:
// ```fix
// # module DocTest;
// #
// main : IO ();
// main = (
//     let sum = loop((0, 0), |(i, sum)|
//         if i == 100 { break $ sum };
//         continue $ (i + 1, sum + i)
//     );
//     println $ sum.to_string
// ); // evaluates to 0 + 1 + ... + 99 
// ```
// 
// # Parameters
// 
// * `s0` - The initial state of the loop.
// * `body` - The loop body function. It takes the current state of the loop and returns either `continue(s)` or `break(r)`.
loop : s -> (s -> LoopState s r) -> r;
loop = |s, body| (
    match body(s) {
        continue(s) => loop(s, body),
        break(b) => b
    }
);

namespace Array {

    // Copies `arr[begin, end)` into a new array, treating `arr` as having size `len` and giving the
    // new array `additional_capacity` elements' worth of capacity beyond the elements copied.
    //
    // A negative `begin` reads as `0` and an `end` past `len` reads as `len`; a range that ends at
    // or before it begins gives an array of no elements.
    //
    // # Parameters
    //
    // * `len` - The size to treat `arr` as having.
    // * `additional_capacity` - The capacity of the returned array beyond the elements it holds.
    // * `begin` - The start index of the range to copy.
    // * `end` - The end index of the range to copy.
    // * `arr` - The array to copy the range out of.
    _get_sub_size_with_length_and_additional_capacity : I64 -> I64 -> I64 -> I64 -> Array a -> Array a;
    _get_sub_size_with_length_and_additional_capacity = |len, additional_capacity, begin, end, arr| (
        let begin = max(0, begin);
        let end = min(len, end);
        let n = if end > begin { end - begin } else { 0 };
        let res = Array::empty(n + additional_capacity);
        if n == 0 || len == 0 { res };
        res._unsafe_copy_capacity_bounds_unchecked(arr, begin, end)
    );

    // Gets an element of an array at the specified index.
    // 
    // # Parameters
    // * `i` - The index of the element to get.
    // * `array` - The array to get the element from.
    @ : I64 -> Array a -> a;
    @ = |idx, arr| (
        let idx = _check_range(idx, arr.@size);
        arr._unsafe_get_bounds_unchecked(idx)
    );

    // Deprecated alias for `Std::Array::@size`.
    get_size : Array a -> I64 = |arr| arr.@size;
    DEPRECATED[get_size, "Use `Std::Array::@size` instead."];

    // Deprecated alias for `Std::Array::@capacity`.
    get_capacity : Array a -> I64 = |arr| arr.@capacity;
    DEPRECATED[get_capacity, "Use `Std::Array::@capacity` instead."];

    // Creates an empty array with specified capacity.
    // 
    // # Parameters
    // 
    // * `capacity` - The number of elements the array can hold without allocating more space. If negative, or so large that the elements exceed the address space, the program will abort.
    empty : I64 -> Array a;
    empty = |cap|(
        let cap = Array::_check_size(cap);
        Array::_unsafe_empty_capacity_unchecked(cap)
    );

    // Creates an array of the specified size filled with the initial value.
    // 
    // The capacity is set to the same value as the size.
    // 
    // Example: `fill(n, x) == [x, x, x, ..., x]` (of length `n`).
    // 
    // # Parameters
    // 
    // * `size` - The number of elements in the array. If negative, or so large that the elements exceed the address space, the program will abort.
    // * `value` - The value to fill the array with.
    fill : I64 -> a -> Array a;
    fill = |size, value| (
        let size = Array::_check_size(size);
        Array::empty(size)._unsafe_append_value_capacity_unchecked(value, size)
    );

    // Updates an array by applying a function to the element at the specified index.
    //
    // This function clones the given array if it is shared.
    // 
    // If you call `arr.mod(i, f)` when both of `arr` and `arr.@(i)` are unique, it is assured that `f` receives the element value which is unique. 
    // 
    // # Parameters
    // 
    // * `i` - The index of the element to modify.
    // * `modifier` - The function to apply to the element.
    // * `array` - The array to modify.
    mod : I64 -> (a -> a) -> Array a -> Array a;
    mod = |idx, fun, arr| (
        let idx = _check_range(idx, arr.@size);
        let (parr, elm) = PunchedArray::_unsafe_punch_bounds_unchecked(idx, arr);
        let elm = fun(elm);
        parr._unsafe_plug_bounds_unchecked(elm)
    );

    // Optimized implementation of `_unsafe_act_bounds_unchecked` function specialized for `Identity` functor.
    _unsafe_act_bounds_unchecked_identity : I64 -> (a -> Identity a) -> Array a -> Identity (Array a);
    _unsafe_act_bounds_unchecked_identity = |idx, fun, arr| (
        let (parr, elm) = PunchedArray::_unsafe_punch_bounds_unchecked(idx, arr);
        let Identity { data : elm } = fun(elm);
        Identity { data : parr._unsafe_plug_bounds_unchecked(elm) }
    );

    // Optimized implementation of `_unsafe_act_bounds_unchecked` function specialized for `Const r` functor.
    _unsafe_act_bounds_unchecked_const : I64 -> (a -> Const r a) -> Array a -> Const r (Array a);
    _unsafe_act_bounds_unchecked_const = |idx, fun, arr| (
        let elm = arr._unsafe_get_bounds_unchecked(idx);
        let Const { data : res } = fun(elm);
        Const { data : res }
    );

    // Optimized implementation of `_unsafe_act_bounds_unchecked` function specialized for `Tuple2 x` functor.
    _unsafe_act_bounds_unchecked_tuple2 : I64 -> (a -> (x, a)) -> Array a -> (x, Array a);
    _unsafe_act_bounds_unchecked_tuple2 = |idx, fun, arr| (
        let (parr, elm) = PunchedArray::_unsafe_punch_bounds_unchecked(idx, arr);
        let (x, elm) = fun(elm);
        (x, parr._unsafe_plug_bounds_unchecked(elm))
    );

    // Modifies an array by a functorial action. 
    // 
    // Semantically, `arr.act(idx, fun)` is equivalent to `fun(arr.@(idx)).map(|elm| arr.set(idx, elm))`.
    // 
    // This function can be defined for any functor `f` in general, but it is easier to understand the behavior when `f` is a monad: 
    // the monadic action `act(idx, fun, arr)` first performs `fun(arr.@(idx))` to get a value `elm`, and returns a pure value `arr.set(idx, elm)`. 
    // 
    // If you call `arr.act(idx, fun)` when both of `arr` and `arr.@(idx)` are unique, it is assured that `fun` receives the unique value.
    // 
    // If you call `act` on an array which is shared, this function clones the given array when inserting the result of your action into the array. 
    // This means that you don't need to pay cloning cost when your action failed, as expected.
    // 
    // # Parameters
    //
    // * `i` - The index of the element to be acted on.
    // * `action` - The functorial action to be performed on the element at index `i`.
    // * `array` - The array.
    act : [f : Functor] I64 -> (a -> f a) -> Array a -> f (Array a);
    act = |idx, fun, arr| (
        let idx = _check_range(idx, arr.@size);
        arr._unsafe_act_bounds_unchecked(idx, fun)
    );

    // Modifies an array by a functorial action. 
    // 
    // This function is similar to `Array::act`, but it does not check the bounds of `idx`.
    // 
    // # Parameters
    //
    // * `i` - The index of the element to be acted on.
    // * `action` - The functorial action to be performed on the element at index `i`.
    // * `array` - The array.
    _unsafe_act_bounds_unchecked : [f : Functor] I64 -> (a -> f a) -> Array a -> f (Array a);
    _unsafe_act_bounds_unchecked = |idx, fun, arr| (
        let (unique, arr) = arr._unsafe_is_storage_unique;
        if unique {
            // The array is unique here, so this punch never clones; punching through the checking
            // version says so to the optimizer, which then knows the punched array is unique and drops
            // the check of the plug below. The plug has to be the checking one: `map` may run its
            // function more than once, and each run must plug into a private array.
            let (parr, elm) = PunchedArray::_unsafe_punch_bounds_unchecked(idx, arr);
            fun(elm).map(|elm| parr._unsafe_plug_bounds_unchecked(elm))
        } else {
            fun(arr._unsafe_get_bounds_unchecked(idx)).map(|elm| arr.set(idx, elm))
        }
    );

    // `arr.mutate_elements(io)` gets a pointer `ptr` to the first element of `arr`, executes `io(ptr)`,
    // and then returns the mutated `arr` paired with the result of `io(ptr)`.
    //
    // The IO action `io(ptr)` is expected to modify the elements of `arr` through the obtained pointer.
    // Do not perform any IO operations other than mutating the elements of `arr`.
    //
    // This function first clones the array if it is shared. The pointer is valid only while `io` runs.
    //
    // For example, the callback can use its IO context and the FFI to store into this array a boxed value made somewhere far away.
    // Doing that inside a global value's initializer can let an optimization break the program: what an initializer's result reaches stops being reference-counted once the initializer finishes, and the program goes on counting references to what it holds, so nothing may be both.
    // `dev-docs/2026-08-03-initializer-contract-violation/` holds a program that makes something be both.
    //
    // # Parameters
    // * `act` - The action to perform on the pointer to the first element.
    // * `array` - The array to mutate.
    mutate_elements : (Ptr -> IO b) -> Array a -> (Array a, b);
    mutate_elements = |act, array| mutate_elements_ios(act, array, IOState::_unsafe_create).@1;

    // `arr.mutate_elements_io(io)` gets a pointer `ptr` to the first element of `arr`, executes `io(ptr)`,
    // and then returns the mutated `arr` paired with the result of `io(ptr)`.
    //
    // Similar to `mutate_elements`, but this function is used when you want to run the IO action in the existing IO context.
    //
    // # Parameters
    // * `act` - The action to perform on the pointer to the first element.
    // * `array` - The array to mutate.
    mutate_elements_io : (Ptr -> IO b) -> Array a -> IO (Array a, b);
    mutate_elements_io = |act, array| IO::from_runner $ |ios| mutate_elements_ios(act, array, ios);

    // Internal implementation of the `mutate_elements` and `mutate_elements_io` functions.
    //
    // # Parameters
    // * `act` - The action to perform on the pointer to the first element.
    // * `array` - The array to mutate.
    // * `ios` - The `IOState` to thread through the action.
    mutate_elements_ios : (Ptr -> IO b) -> Array a -> IOState -> (IOState, (Array a, b));
    mutate_elements_ios = |act, array, ios| ios._mutate_elements_ios_internal(|ptr| act(ptr).@runner, array);

    // Calls an IO action with a pointer to the first element of the array.
    //
    // The array is borrowed for the duration of the action, so the pointer is valid only while it runs.
    // It is not allowed to mutate the array through the borrowed pointer; to do that, use `mutate_elements`.
    //
    // # Parameters
    // * `act` - The IO action to call with the pointer to the first element.
    // * `array` - The array whose elements are borrowed.
    borrow_elements_io : (Ptr -> IO b) -> Array a -> IO b;
    borrow_elements_io = |act, array| IO::from_runner $ |ios| array.borrow_elements(|ptr| (act(ptr).@runner)(ios));

    // Appends an array to an array.
    // 
    // Note: Since `a1.append(a2)` puts `a2` after `a1`, `append(lhs, rhs)` puts `lhs` after `rhs`.
    // 
    // # Parameters
    // 
    // * `second` - The array to be appended.
    // * `first` - The array to which `second` is appended.
    append : Array a -> Array a -> Array a;
    append = |second, first| (
        let first_len = first.@size;
        let second_len = second.@size;

        // Reserve the buffer of `first` for the appended elements.
        let len = first_len + second_len;
        let first = if first.@capacity < len {
            first.reserve(max(len, 2 * first.@capacity))
        } else {
            first
        };

        // Append all of `second`. The primitive clones `first` if it is shared and moves the
        // elements of `second` when `second` is unique.
        first._unsafe_append_capacity_unchecked(second)
    );

    // Finds the first index at which the element satisfies a condition.
    // 
    // # Parameters
    //
    // * `cond` - The condition to be satisfied.
    // * `array` - The array to be searched.
    find_by : (a -> Bool) -> Array a -> Option I64;
    find_by = |cond, arr| (
        let len = arr.@size;
        loop(0, |idx| (
            if idx == len { break $ Option::none $ () };
            if cond(arr.@(idx)) { break $ Option::some $ idx };
            continue $ idx + 1
        ))
    );

    // Create an array from an iterator.
    // 
    // # Parameters
    // 
    // * `it` - The iterator to be converted to an array.
    from_iter : [it : Iterator, Item it = a] it -> Array a;
    from_iter = Iterator::to_array;

    // Creates an array by a mapping function.
    // 
    // # Parameters
    // 
    // * `size` - The size of the array to be created.
    // * `map` - The mapping function. It takes an index and returns the value at that index.
    from_map : I64 -> (I64 -> a) -> Array a;
    from_map = |size, map| (
        // `empty(size)` reserves the capacity, so append the elements directly instead of through
        // `push_back`, whose per-element capacity re-check is redundant here.
        Iterator::range(0, size).fold(Array::empty(size), |i, arr| arr._unsafe_append_value_capacity_unchecked(map(i), 1))
    );

    // Gets the first element of an array. Returns none if the array is empty.
    // 
    // # Parameters
    // 
    // * `arr` - The array.
    get_first : Array a -> Option a;
    get_first = |arr| (
        if arr.is_empty { Option::none() };
        Option::some $ arr.@(0)
    );

    // Gets the last element of an array. Returns none if the array is empty.
    // 
    // # Parameters
    // 
    // * `arr` - The array.
    get_last : Array a -> Option a;
    get_last = |arr| (
        let len = arr.@size;
        if len == 0 { Option::none() };
        Option::some $ arr.@(len - 1)
    );

    // `arr.get_sub(start, end)` returns an array `[ arr.@(i) | i ∈ [start, end) ]`.
    // 
    // `start` and `end` are clamped to the range `[0, arr.@size]`.
    // 
    // # Parameters
    // 
    // * `start` - The start index of the subarray.
    // * `end` - The end index of the subarray.
    // * `array` - The array to be sliced.
    get_sub : I64 -> I64 -> Array a -> Array a;
    get_sub = |start, end, arr| arr._get_sub_size_with_length_and_additional_capacity(arr.@size, 0, start, end);

    // Gets whether the array is empty.
    // 
    // # Parameters
    // 
    // * `array` - The array to be checked.
    is_empty : Array a -> Bool;
    is_empty = |arr| ( arr.@size == 0 );

    // Pops an element at the back of an array.
    // If the array is empty, this function does nothing.
    // 
    // # Parameters
    // 
    // * `array` - The array to be popped.
    pop_back : Array a -> Array a;
    pop_back = |arr| (
        let size = arr.@size;
        if size == 0 { arr };
        arr._unsafe_truncate_bounds_unchecked(size - 1)
    );

    // Pushes an element to the back of an array.
    // 
    // # Parameters
    // 
    // * `element` - The element to be pushed.
    // * `array` - The array to which the element is pushed.
    push_back : a -> Array a -> Array a;
    push_back = |e, arr| (
        let len = arr.@size;
        let arr = if arr.@capacity < len + 1 {
            arr.reserve(2*(len + 1))
        } else {
            arr
        };
        arr._unsafe_append_value_capacity_unchecked(e, 1)
    );

    // Reserves the memory region for an array.
    // 
    // # Parameters
    // 
    // * `capacity` - The capacity to be reserved. If so large that the elements exceed the address space, the program will abort.
    // * `array` - The array to be reserved.
    reserve : I64 -> Array a -> Array a;
    reserve = |cap, arr| (
        if cap <= arr.@capacity { arr };
        arr._unsafe_set_capacity_bounds_unchecked(cap)
    );

    // Sort by `LessThan` trait.
    // 
    // Note: this can be an unstable sort.
    // 
    // # Parameters
    // - `arr`: An array of elements to be sorted.
    sort : [a : LessThan] Array a -> Array a;
    sort = |arr| arr.sort_by(|(lhs, rhs)| lhs < rhs);

    // Sort by a "less than" comparator.
    //
    // Note: this can be an unstable sort.
    // 
    // # Parameters
    // - `less_than`: A function that takes two elements and returns true if the first is
    //   less than the second.
    // - `arr`: An array of elements to be sorted.
    sort_by : ((a, a) -> Bool) -> Array a -> Array a;
    sort_by = |less_than, arr| (
        let depth = loop((arr.@size, 0_U8), |(n, depth)| if n == 0 { break $ depth } else { continue $ (n/2, depth+1_U8) } );
        arr._introsort_by_internal(less_than, 0, arr.@size, depth)
    );

    // Reverse an array.
    //
    // # Parameters
    // - `array` - The array to be reversed.
    reverse : Array a -> Array a;
    reverse = |arr| (
        let n = arr.@size;
        if n <= 1 { arr };
        range(0, n/2).fold(arr, |i, arr| arr.unsafe_swap_bounds_unchecked(i, n - 1 - i))
    );

    // Sorts a range of an array by quicksort, falling back to insertion sort on a short range and
    // to heap sort where the recursion has spent its budget.
    //
    // The caller must keep `0 <= start <= end <= arr.@size`: the range is read and written without
    // checking an index against the size.
    //
    // # Parameters
    // - `less_than`: A function that takes two elements and returns true if the first is
    //   less than the second.
    // - `start`: The starting index of the range to sort.
    // - `end`: The ending index of the range to sort.
    // - `arr`: An array of elements to be sorted.
    // - `depth`: How many more uneven splits the range may take before heap sort takes it.
    _introsort_by_internal : ((a, a) -> Bool) -> I64 -> I64 -> U8 -> Array a -> Array a;
    _introsort_by_internal = |less_than, start, end, depth, arr| (
        if end - start <= 1 { arr };
        if end - start <= 12 { arr._insertion_sort_by_ranged(less_than, start, end) };
        if depth == 0_U8 { arr._heap_sort_by_ranged(less_than, start, end) };

        let pivot_i = (start + end) / 2;
        let pivot = arr.@(pivot_i);

        // Move pivot to the last.
        let arr = arr.unsafe_swap_bounds_unchecked(pivot_i, end - 1);

        let (arr, pivot_i) = arr._move_to_front_by_ranged(|elem| less_than((elem, pivot)), start, end);

        // Move pivot to pivot_i.
        let arr = arr.unsafe_swap_bounds_unchecked(pivot_i, end - 1);

        // Nothing compared less than the pivot, so the partition moved one element into place, and
        // a range whose elements all compare equal would go on doing that one element at a time.
        // Gather everything equal to the pivot beside it instead, and drop all of it from the
        // recursion at once.
        if pivot_i == start {
            let (arr, equal_end) = arr._move_to_front_by_ranged(|elem| !less_than((pivot, elem)), start + 1, end);
            arr._introsort_by_internal(less_than, equal_end, end, depth - 1_U8)
        };

        // A split near the middle costs nothing from the budget: what the budget is against is the
        // pivot that keeps landing near an end, and a run of those is what heap sort is here for.
        // Spending it on every split instead hands heap sort most of a randomly ordered array,
        // whose splits are uneven by a constant rather than by a growing one.
        let smaller_side_size = min(pivot_i - start, end - pivot_i - 1);
        let depth = if smaller_side_size < (end - start) / 8 { depth - 1_U8 } else { depth };

        let arr = arr._introsort_by_internal(less_than, start, pivot_i, depth);
        let arr = arr._introsort_by_internal(less_than, pivot_i + 1, end, depth);

        arr
    );

    // Moves to the front of `arr[start, end)` the elements the predicate holds of, in the order it
    // meets them, and returns the array with the index just past the last of them.
    //
    // The caller must keep `0 <= start <= end <= arr.@size`: the range is read and written without
    // checking an index against the size.
    //
    // # Parameters
    // - `pred`: The predicate the elements moved to the front satisfy.
    // - `start`: The start index of the range.
    // - `end`: The end index of the range.
    // - `arr`: An array whose range is to be rearranged.
    _move_to_front_by_ranged : (a -> Bool) -> I64 -> I64 -> Array a -> (Array a, I64);
    _move_to_front_by_ranged = |pred, start, end, arr| (
        range(start, end).fold((arr, start), |j, (arr, i)|
            if pred(arr._unsafe_get_bounds_unchecked(j)) {
                (arr.unsafe_swap_bounds_unchecked(i, j), i + 1)
            } else {
                (arr, i)
            }
        )
    );

    // Insertion sort for the specified range in an array.
    //
    // # parameters
    // - `less_than`: A function that takes two elements and returns true if the first is
    //   less than the second.
    // - `start`
    // - `end`
    // - `arr`: An array of elements to be sorted.
    _insertion_sort_by_ranged : ((a, a) -> Bool) -> I64 -> I64 -> Array a -> Array a;
    _insertion_sort_by_ranged = |less_than, start, end, arr| (
        let n = end - start;
        if n <= 1 { arr };
        range(start + 1, start + n).fold(arr, |i, arr| (
            let v = arr.@(i);
            loop((arr, i), |(arr, j)|
                if j == start { 
                    break $ arr.set(start, v)
                };
                let w = arr.@(j-1);
                if less_than((v, w)) {
                    continue $ (arr.set(j, w), j-1)
                } else {
                    break $ arr.set(j, v)
                }
            )
        ))
    );

    // Heap sort for the specified range in an array.
    //
    // # Parameters
    // - `less_than`: A function that takes two elements and returns true if the first is
    //   less than the second.
    // - `start`: The start index of the range to sort.
    // - `end`: The end index of the range to sort.
    // - `arr`: An array of elements to be sorted.
    _heap_sort_by_ranged : ((a, a) -> Bool) -> I64 -> I64 -> Array a -> Array a;
    _heap_sort_by_ranged = |less_than, start, end, arr| (
        let n = end - start;
        if n <= 1 { arr };

        // Build the heap.
        let heap = range_step(n/2-1, -1, -1).fold(arr, |i, arr| arr._heap_down_ranged(less_than, start + i, start + n, start, end));

        // Extract elements from the heap one by one.
        range_step(n-1, 0, -1).fold(heap, |i, heap|
            let heap = heap.unsafe_swap_bounds_unchecked(start + 0, start + i);

            // Call sift down on the reduced heap.
            heap._heap_down_ranged(less_than, start + 0, start + i, start, end)
        )
    );

    // Down-heap (sift down) operation to maintain the heap property.
    //
    // # Parameters
    // - `less_than`: A function that takes two elements and returns true if the first is
    //   less than the second.
    // - `i`: The index of the element to sift down.
    // - `heap_end`: The end index of the heap.
    // - `start`: The start index of the range being sorted, where the root of the heap sits.
    // - `end`: The end index of the range being sorted.
    // - `heap`: An array representing the heap.
    _heap_down_ranged : ((a, a) -> Bool) -> I64 -> I64 -> I64 -> I64 -> Array a -> Array a;
    _heap_down_ranged = |less_than, i, heap_end, start, end, heap| (
        let left = 2 * (i - start) + 1 + start;
        let right = 2 * (i - start) + 2 + start;

        let largest = i;
        let largest = if left < heap_end && less_than((heap.@(i), heap.@(left))) { left } else largest;
        let largest = if right < heap_end && less_than((heap.@(largest), heap.@(right))) { right } else largest;

        if largest == i { heap };

        let heap = heap.unsafe_swap_bounds_unchecked(i, largest);
        heap._heap_down_ranged(less_than, largest, heap_end, start, end)
    );

    // Stable sort by `LessThan` trait.
    //
    // Implemented by merge sort, which allocates an array as large as the one being sorted.
    //
    // # Parameters
    // - `arr`: An array of elements to be sorted.
    sort_stable : [a : LessThan] Array a -> Array a;
    sort_stable = |arr| arr.sort_stable_by(|(lhs, rhs)| lhs < rhs);    

    // Stable sort by a "less than" comparator.
    //
    // Implemented by merge sort, which allocates an array as large as the one being sorted.
    //
    // # Parameters
    // 
    // * `less_than` - The comparator function.
    // * `array` - The array to be sorted.
    sort_stable_by : ((a, a) -> Bool) -> Array a -> Array a;
    sort_stable_by = |less_than, arr| (
        let n = arr.@size;
        if n <= _merge_sort_insertion_limit { arr._insertion_sort_by_ranged(less_than, 0, n) };
        // The merge sort reads from one array and writes into the other, so it needs a second array
        // holding the same elements.
        let copy = arr.get_sub(0, n);
        _merge_sort_by_ranged(less_than, 0, n, copy, arr).@0
    );

    // The greatest length that `_merge_sort_by_ranged` sorts by insertion sort instead of
    // splitting it further. A range it does split has at least two elements, which is what lets the
    // merge read the element before the midpoint, so this is at least 1.
    _merge_sort_insertion_limit : I64;
    _merge_sort_insertion_limit = 12;

    // Sorts `from[start, end)` into `into[start, end)` by "less than" comparator.
    //
    // The two arrays hold equal elements over `[start, end)` on entry. On exit `into` holds them in
    // non-descending order and `from` holds them in an unspecified order. The pair is returned as
    // `(into, from)`, so that the sorted array is the first component.
    //
    // # Parameters
    // - `less_than`: A function that takes two elements and returns true if the first is
    //   less than the second.
    // - `start`: The start index of the range to sort.
    // - `end`: The end index of the range to sort.
    // - `from`: The array to read the elements from.
    // - `into`: The array to write the sorted elements into.
    _merge_sort_by_ranged : ((a, a) -> Bool) -> I64 -> I64 -> Array a -> Array a -> (Array a, Array a);
    _merge_sort_by_ranged = |less_than, start, end, from, into| (
        if end - start <= _merge_sort_insertion_limit {
            (into._insertion_sort_by_ranged(less_than, start, end), from)
        };
        let mid = start + (end - start) / 2;
        // Sorting each half the other way round puts both sorted runs in `from`, ready to be merged.
        let (from, into) = _merge_sort_by_ranged(less_than, start, mid, into, from);
        let (from, into) = _merge_sort_by_ranged(less_than, mid, end, into, from);
        if !less_than((from.@(mid), from.@(mid - 1))) {
            // The two runs are already in order where they stand, so the merge would only copy them.
            (into._unsafe_copy_range_bounds_unchecked(from, start, end, start), from)
        };
        (into._merge_runs(less_than, start, mid, mid, end, start, from), from)
    );

    // Merges the sorted runs `from[former_pos, former_end)` and `from[latter_pos, latter_end)` into
    // `into`, writing from `into_pos` on.
    //
    // # Parameters
    // - `less_than`: A function that takes two elements and returns true if the first is
    //   less than the second.
    // - `former_pos`: The index of the next element of the run that starts the range.
    // - `former_end`: The end index of that run.
    // - `latter_pos`: The index of the next element of the run that ends the range.
    // - `latter_end`: The end index of that run.
    // - `into_pos`: The index in `into` at which the next element lands.
    // - `from`: The array holding the two runs.
    // - `into`: The array to write the merged elements into.
    _merge_runs : ((a, a) -> Bool) -> I64 -> I64 -> I64 -> I64 -> I64 -> Array a -> Array a -> Array a;
    _merge_runs = |less_than, former_pos, former_end, latter_pos, latter_end, into_pos, from, into| (
        if former_pos == former_end { into._unsafe_copy_range_bounds_unchecked(from, latter_pos, latter_end, into_pos) };
        if latter_pos == latter_end { into._unsafe_copy_range_bounds_unchecked(from, former_pos, former_end, into_pos) };
        let former_elem = from.@(former_pos);
        let latter_elem = from.@(latter_pos);
        if !less_than((latter_elem, former_elem)) { // Essential for stability.
            into.set(into_pos, former_elem)
                ._merge_runs(less_than, former_pos + 1, former_end, latter_pos, latter_end, into_pos + 1, from)
        } else {
            into.set(into_pos, latter_elem)
                ._merge_runs(less_than, former_pos, former_end, latter_pos + 1, latter_end, into_pos + 1, from)
        }
    );

    // Overwrites `dst[dst_begin, dst_begin + end - begin)` with `src[begin, end)`, omitting the
    // bounds checks.
    //
    // The caller must ensure `[begin, end)` is in range of `src` and
    // `[dst_begin, dst_begin + end - begin)` is in range of `dst`; an out-of-range index causes
    // undefined behavior.
    //
    // # Parameters
    // - `src`: The array to read the elements from.
    // - `begin`: The start index of the range in `src`.
    // - `end`: The end index of the range in `src`.
    // - `dst_begin`: The index in `dst` at which the first element lands.
    // - `dst`: The array to write the elements into.
    _unsafe_copy_range_bounds_unchecked : Array a -> I64 -> I64 -> I64 -> Array a -> Array a;
    _unsafe_copy_range_bounds_unchecked = |src, begin, end, dst_begin, dst| (
        if begin == end { dst };
        dst.unsafe_set_bounds_unchecked(dst_begin, src._unsafe_get_bounds_unchecked(begin))
           ._unsafe_copy_range_bounds_unchecked(src, begin + 1, end, dst_begin + 1)
    );

    // Converts an array to an iterator.
    //
    // # Parameters
    //
    // * `array` - The array to be converted.
    to_iter : [?it : Iterator, Item ?it = a] Array a -> ?it;
    to_iter = |arr| ArrayIterator { arr: arr, idx: 0 };

    // Truncates an array, keeping the given number of first elements.
    // 
    // `truncante(len, arr)` does nothing if `len >= arr.@size`.
    // 
    // # Parameters
    // 
    // * `new_length` - The number of elements to be kept.
    // * `array` - The array to be truncated.
    truncate : I64 -> Array a -> Array a;
    truncate = |length, arr| (
        if length < 0 { undefined("[Std::Array::truncate] Negative size is not allowed.") };
        if length >= arr.@size { arr };
        arr._unsafe_truncate_bounds_unchecked(length)
    );

    // Resizes an array to the given size, filling with the given value if the new size is larger than the current size, 
    // or truncating if the new size is smaller than the current size.
    // 
    // # Parameters
    // * `new_size` - The new size of the array.
    // * `fill_value` - The value to fill if the new size is larger than the current size.
    // * `array` - The array to be resized.
    resize : I64 -> a -> Array a -> Array a;
    resize = |n, x, xs| (
        if n <= xs.@size { xs.truncate(n) };
        let m = xs.@size;
        xs.reserve(n)._unsafe_append_value_capacity_unchecked(x, n - m)
    );

    // `arr.search_partition_point(pred)` returns an index x such that `pred` is true on [0, x) and false on [x, n) by binary search.
    // 
    // When we put an order on `Bool` as `false < true`, `pred` must be monotonically decreasing on `arr`.
    // 
    // The returned value x satisfies 0 <= x <= `arr.@size`. If `arr` is empty, it returns 0.
    // 
    // # Parameters
    // 
    // * `predicate` - The predicate function.
    // * `array` - The array to be searched.
    search_partition_point : (a -> Bool) -> Array a -> I64;
    search_partition_point = |pred, arr| (
        let n = arr.@size;
        if n == 0 { 0 };
        if !pred(arr.@(0)) { 0 };
        loop((0, n), |(left, right)|
            if right - left <= 1 { break $ right };
            let mid = (left + right) / 2;
            continue $ if pred(arr.@(mid)) { (mid, right) } else { (left, mid) }
        )
    );

    // Remove consecutive duplicates from an array.
    // 
    // # Parameters
    // * `arr` - The input array.
    // 
    // # Examples
    // ```fix
    // assert_eq(|_|"", [1,1,2,2,3].dedup, [1,2,3]);;
    // assert_eq(|_|"", [1,2,1,2].dedup, [1,2,1,2]) // non-consecutive duplicates are kept
    // ```
    dedup : [a : Eq] Array a -> Array a;
    dedup = |arr| (
        if arr.is_empty { arr };
        let (arr, i, _) = range(1, arr.@size).fold((arr, 1, arr.@(0)), |j, (arr, i, prev)|
            let now = arr.@(j);
            if now != prev {
                let arr = arr.set(i, now);
                (arr, i+1, now)
            } else {
                (arr, i, now)
            }
        );
        arr.truncate(i)
    );    
}

// The empty array with zero capacity.
impl Array a : Zero {
    zero = Array::empty(0);
}

// Concatenates two arrays.
impl Array a : Add {
    add = |lhs, rhs| lhs.append(rhs);
}

impl [a : Eq] Array a : Eq {
    eq = |lhs, rhs| (
        if lhs.@size != rhs.@size { false };
        let len = lhs.@size;
        loop(0, |idx| (
            if idx == len { break $ true };
            if lhs.@(idx) != rhs.@(idx) { break $ false };
            continue $ idx + 1
        ))
    );
}

// `LessThan` implementation for `Array a`.
// 
// Compares two arrays by lexicographic order.
impl [a : Eq, a : LessThan] Array a : LessThan {
    less_than = |lhs, rhs| (
        loop(0, |i| (
            if i == lhs.@size && i == rhs.@size { break $ false };
            if i == lhs.@size { break $ true };
            if i == rhs.@size { break $ false };
            let l = lhs.@(i);
            let r = rhs.@(i);
            if l != r { break $ l < r };
            continue $ i + 1
        ))
    );
}

// `LessThanOrEq` implementation for `Array a`.
// 
// Compares two arrays by lexicographic order.
impl [a : Eq, a : LessThanOrEq] Array a : LessThanOrEq {
    less_than_or_eq = |lhs, rhs| (
        loop(0, |i| (
            if i == lhs.@size && i == rhs.@size { break $ true };
            if i == lhs.@size { break $ true };
            if i == rhs.@size { break $ false };
            let l = lhs.@(i);
            let r = rhs.@(i);
            if l != r { break $ l <= r };
            continue $ i + 1
        ))
    );
}

impl Array : Functor {
    map = |f, arr| (
        let n = arr.@size;
        let res = Array::empty(n);
        loop((0, res), |(i, res)| (
            if i == n { break $ res };
            let e = f $ arr.@(i);
            continue $ (i+1, res.push_back(e))
        ))
    );
}

impl Array : Monad {
    pure = |e| [e];
    bind = |f, arr| (
        let size = arr.@size;
        let arr_arr = Array::empty(size);
        let (arr_arr, count) = loop((0, arr_arr, 0), |(idx, arr_arr, count)| (
            if idx == size { break $ (arr_arr, count) };
            let inner = f $ arr.@(idx);
            let count = count + inner.@size;
            let arr_arr = arr_arr.push_back(inner);
            continue $ (idx + 1, arr_arr, count)
        ));
        let ret = Array::empty(count);
        loop((0, ret), |(i, ret)| (
            if i == size { break $ ret };
            let inner = arr_arr.@(i);
            continue $ loop((0, ret), |(j, ret)|(
                if j == inner.@size {
                    break $ (i + 1, ret)
                } else {
                    let ret = ret.push_back(inner.@(j));
                    continue $ (j + 1, ret)
                }
            ))
        ))
    );
}

impl [a : ToString] Array a : ToString {
    to_string = |arr| ("[" + arr.to_iter.map(to_string).join(", ") + "]");
}

impl Arrow a : Functor {
    map = |f, a| a >> f;
}

impl Arrow a : Monad {
    pure = |x| |_| x;
    bind = |f, a| |x| f(a(x)) $ x;
}

impl Bool : ToString {
    to_string = |lhs| (
        if lhs { "true" } else { "false" }
    );
}

// Boxed wrapper for a type.
type Box a = box struct { value : a };

namespace Box {
    make : a -> Box a;
    make = |val| Box { value : val };
}

// Marker trait for boxed types.
// 
// This trait is automatically implemented for all boxed types.
// Implementing this trait manually is not allowed.
trait a : Boxed {}

// A type (alias) for error message. 
type ErrMsg = String;

namespace FFI {

    // `x.mutate_boxed(io)` gets a pointer `ptr` to the data that `x` points to, executes `io(ptr)`, and then returns mutated `x` paired with the result of ``io(ptr)``.
    // 
    // The IO action `io(ptr)` is expected to modify the value of `x` through the obtained pointer. 
    // Do not perform any IO operations other than mutating the value of `x`.
    // 
    // For more details on the pointer passed to `io`, see the document of `borrow_boxed`.
    // 
    // This function first clones the value if `x` is not unique.
    //
    // See also: `borrow_boxed`, `mutate_boxed_io`, `mutate_boxed`.
    // 
    // # Parameters
    // * `act` - The action to perform on the pointer to the boxed value.
    // * `value` - The boxed value to mutate.
    mutate_boxed : [a : Boxed] (Ptr -> IO b) -> a -> (a, b);
    mutate_boxed = |act, value| mutate_boxed_ios(act, value, IOState::_unsafe_create).@1;

    // `x.mutate_boxed_io(io)` gets a pointer `ptr` to the data that `x` points to, executes `io(ptr)`, and then returns mutated `x` paired with the result of `io(ptr)`.
    // 
    // Similar to `mutate_boxed`, but this function is used when you want to run the IO action in the existing IO context.
    // 
    // For more details on the pointer passed to `io`, see the document of `borrow_boxed`.
    // 
    // For more details, see the document of `mutate_boxed`.
    // 
    // See also: `borrow_boxed`, `borrow_boxed_io`, `mutate_boxed`.
    // 
    // # Parameters
    // 
    // * `act` - The IO action to be performed on the pointer.
    // * `value` - The boxed value to be mutated.
    mutate_boxed_io : [a : Boxed] (Ptr -> IO b) -> a -> IO (a, b);
    mutate_boxed_io = |act, value| IO::from_runner $ |ios| mutate_boxed_ios(act, value, ios);

    // Internal implementation of the `mutate_boxed` and `mutate_boxed_io` functions.
    // 
    // # Parameters
    // 
    // * `act` - The action to perform on the pointer to the boxed value.
    // * `value` - The boxed value to mutate.
    // * `ios` - The `IOState` to use for the action.
    mutate_boxed_ios : [a : Boxed] (Ptr -> IO b) -> a -> IOState -> (IOState, (a, b));
    mutate_boxed_ios = |act, value, ios| ios._mutate_boxed_ios_internal(|ptr| act(ptr).@runner, value);

    // Gets a retained pointer to a boxed value.
    // This function is used to share ownership of Fix's boxed values with foreign languages.
    // 
    // To get back the boxed value from the retained pointer, use `boxed_from_retained_ptr`.
    // To release / retain the value in a foreign language, call the function pointer obtained by `get_funptr_release` or `get_funptr_retain` on the pointer.
    // 
    // Note that the returned pointer points to the control block allocated by Fix, and does not necessary points to the data of the boxed value.
    // If you want to get a pointer to the data of the boxed value, use `borrow_boxed`.
    // 
    // # Parameters
    // 
    // * `value` - The boxed value to get the pointer to.
    boxed_to_retained_ptr : [a : Boxed] a -> IO Ptr;
    boxed_to_retained_ptr = |val| IO::from_runner $ _boxed_to_retained_ptr_ios(val);

    // Creates a boxed value from a retained pointer obtained by `boxed_to_retained_ptr`.
    //
    // NOTE:
    // It is the user's responsibility to ensure that the argument is actually a pointer to the type of the return value, and undefined behavior will occur if it is not.
    //
    // # Parameters
    // 
    // * `retained_ptr` - The pointer to the value.
    boxed_from_retained_ptr : [a : Boxed] Ptr -> IO a;
    boxed_from_retained_ptr = |ptr| IO::from_runner $ _boxed_from_retained_ptr_ios(ptr);

    // Performs an IO action borrowing a pointer to the data of a boxed value.
    // 
    // For the details of the pointer, see the document of `borrow_boxed`.
    //
    // It is not allowed to mutate a boxed value through the borrowed pointer. If you want to do so, use `mutate_boxed`.
    // 
    // See also: `borrow_boxed`, `mutate_boxed`, `mutate_boxed_io`.
    // 
    // # Parameters
    // 
    // * `act` - The IO action to be performed on the pointer.
    // * `value` - The boxed value to be borrowed.
    borrow_boxed_io : [a : Boxed] (Ptr -> IO b) -> a -> IO b;
    borrow_boxed_io = |act, value| IO::from_runner $ |ios| value.borrow_boxed(|ptr| (act(ptr).@runner)(ios));

    // Gets errno which is set by C functions.
    get_errno : IO CInt;
    get_errno = FFI_CALL_IO[CInt fixruntime_get_errno()];

    // Sets errno to zero.
    clear_errno : IO ();
    clear_errno = FFI_CALL_IO[() fixruntime_clear_errno()];

    // `Destructor` is a type for managing resources allocated in foreign languages.
    // It contains a handle to the resource (of type `a`) and a destructor function `a -> IO a` to release the resource.
    // The Fix compiler calls the destructor function to release the resource just before destroying the `Destructor`.
    // 
    // # Why does the destructor function return `a`?
    // 
    // For those who only want to know what to return, not the reason: Please return any (valid) value of type `a`.
    // 
    // Let the two fields of `Destructor` be `value : a` and `dtor : a -> IO a` respectively.
    // 
    // When destroying a `Destructor`, the Fix compiler performs the following operations:
    // 1. Similar to calling `mod` or `act` functions, it updates the value of the `value` field of `Destructor` using `dtor`.
    // 2. Similar to destroying a normal Fix struct, it performs the process to destroy `value : a` and `dtor : a -> IO a`, and then releases the memory region occupied by `Destructor`.
    // 
    // By being implemented as in step 1, it is guaranteed that `dtor` receives a unique value.
    // Therefore, for example, when `a` is `Array Ptr` (a collection of handles to multiple resources), the received `Array a` can be directly edited,
    // enabling efficient processing.
    // 
    // Also, to properly execute step 2, a valid value of type `a` must remain in the `value` field after step 1, so the destructor function is designed to return a value of type `a`.
    // 
    // # Notes
    // 
    // As with other FFI features, improper use of `Destructor` may compromise Fix's purity or cause undefined behavior.
    // The following are some examples of such precautions, but not all:
    // - Performing operations other than "releasing resources" in the destructor function will compromise Fix's purity.
    // - Creating multiple `Destructor`s from a handle to a single resource will cause double-free.
    // - Copying a handle to a single resource, putting one in a `Destructor` and continuing to use the other directly, may result in accessing a released resource.
    type Destructor a = box struct { _value : a, _dtor : a -> IOState -> (IOState, a) };

    namespace Destructor {
        // Applies a function to the resource held by `Destructor` and returns the result.
        // 
        // The reason for not simply providing a function `get : Destructor a -> a` is as follows:
        // If the expression `fun(dtor.get)` is the last use of `dtor`, the compiler will call the destructor function after the call to `get`, and the released resource will be passed to `fun`.
        // 
        // # Parameters
        // 
        // * `work` - The function to be called on the resource.
        // * `dtor` - The destructor value.
        borrow : (a -> b) -> Destructor a -> b;
        borrow = |worker, dtor| dtor.with_retained(|dtor| worker(dtor.@_value));

        // Applies an IO action to the resource held by `Destructor` and returns the result.
        // 
        // It works the same as `borrow` except that it executes an `IO` action.
        // 
        // # Parameters
        // 
        // * `action` - The IO action to be performed on the resource.
        // * `dtor` - The destructor value.
        borrow_io : (a -> IO b) -> Destructor a -> IO b;
        borrow_io = |act, dtor| IO::from_runner $ |ios| dtor.borrow(|val| (act(val).@runner)(ios));

        // Make a `Destructor` value.
        // 
        // Takes a resource and a destructor function, and creates a `Destructor` value.
        // 
        // After receiving a resource from a foreign language, you must create exactly one `Destructor` value from that resource.
        // To ensure this, you must implement as follows:
        // - Resource creation (calling a foreign function) must be done using `FFI_CALL_IO`.
        // - Call `Destructor::make` within the same `IO` context.
        // If resource creation is done with `FFI_CALL`, it will be treated as a pure function by the Fix compiler, so the number of calls may be changed by optimization.
        // 
        // # Parameters
        // 
        // * `value` - The value to be wrapped.
        // * `dtor` - The destructor function to be called on the value.
        make : a -> (a -> IO a) -> IO (Destructor a);
        make = |val, dtor| (
            let dtor : a -> IOState -> (IOState, a) = |val, ios| (dtor(val).@runner)(ios);
            IO::from_runner $ Destructor::_make(val, dtor)
        );

        // Makes `dtor` unique if necessary, then modifies the value of the resource.
        // 
        // For example, use this function when you have a `Destructor` managing a memory region allocated with `malloc`, and want to modify the contents of that memory region.
        // 
        // The first argument `ctor` is a "copy constructor" for that resource.
        // For example, it is an `IO` action that allocates a new memory region with `malloc` and copies the contents of the original memory region with `memcpy`.
        // 
        // The second argument `action` is an IO action to modify the value of the contained resource.
        // 
        // `dtor.mutate_unique(ctor, action)` creates a new resource using `ctor` if `dtor` is shared, and creates a new `Destructor` value containing it.
        // Then, it applies `action` to the contained resource and returns the result.
        // 
        // # Parameters
        //
        // * `ctor` - The copy constructor function of the resource.
        // * `action` - The action to be performed on the resource.
        // * `dtor` - The destructor value.
        mutate_unique : (a -> IO a) -> (a -> IO b) -> Destructor a -> (Destructor a, b);
        mutate_unique = |ctr, action, dtor| dtor.mutate_unique_io(ctr, action).unsafe_perform;

        // Makes `dtor` unique if necessary, then executes an IO action that modifies the value of the resource.
        // 
        // This is similar to `mutate_unique`, but the `ctor` and `action` is executed in the context of the external `IO` context.
        // 
        // # Parameters
        // 
        // * `ctor` - The copy constructor function of the resource.
        // * `action` - The action to be performed on the resource.
        // * `dtor` - The destructor value.
        mutate_unique_io : (a -> IO a) -> (a -> IO b) -> Destructor a -> IO (Destructor a, b);
        mutate_unique_io = |ctor, action, dtor| (
            let (unique, dtor) = dtor.unsafe_is_unique;
            // Unique case
            if unique {
                let val = dtor.@_value;
                let res = *action(val);
                pure $ (dtor, res)
            };
            // Shared case
            // 
            // Here, it is essential to use `borrow_io`:
            // Consider the case where `dtor` is shared across multiple threads, which caused us to enter this branch.
            // In this case, `dtor` may be released by other threads immediately, and `dtor` may actually become unique.
            // However, the processing below assumes that `dtor` is shared.
            // Therefore, `dtor` should be kept shared by using `borrow_io`.
            // 
            // In fact, if `dtor` remains unique while processing, `Destructor` is changed in-place by `set__value`, 
            // and the old resource leaks.
            dtor.borrow_io(|val|
                let val = *ctor(val);
                let res = *action(val);
                let dtor = dtor.set__value(val); // The `Destructor` SHOULD be cloned here.
                pure $ (dtor, res)
            )
        );
    }
}

// `IO a` is a type representing I/O actions which return values of type `a`.
type IO a = unbox struct { runner : IOState -> (IOState, a) };

namespace IO {
    // Executes an IO action and returns the result.
    // 
    // This function is unsafe because it breaks the purity of Fix.
    // 
    // # Parameters
    // - `io` - An IO action to be performed.
    unsafe_perform : IO a -> a = |io| (
        let ios = IOState::_unsafe_create;
        let (ios, res) = (io.@runner)(ios);
        eval ios;
        res
    );

    // Reads characters from an IOHandle.
    // 
    // If the first argument `upto_newline` is true, this function reads a file upto newline or EOF.
    _read_line_inner : Bool -> IOHandle -> IOFail String;
    _read_line_inner = |upto_newline, handle| (
        IOFail::from_io_result $ do {
            let file_ptr = *handle.get_file_ptr;
            if file_ptr == nullptr {
                pure $ Result::err("`Std::IO::_read_line_inner` failed!: the IOHandle is already closed.")
            };
            loop_m("", |str|
                let buf_size = 1024;
                let buf = Array::empty(buf_size);
                let (buf, fgets_res) = *buf.mutate_elements_io(|buf_ptr| (
                    FFI_CALL_IO[Ptr fgets(Ptr, CInt, Ptr), buf_ptr, buf_size.c_int, file_ptr]
                ));
                if fgets_res == nullptr {
                    let err = *FFI_CALL_IO[CInt ferror(Ptr), file_ptr];
                    if err != 0.c_int { 
                        let err = "`Std::IO::_read_line_inner` failed!: an error occurred in `fgets`.";
                        break_m $ Result::err(err)
                    } else {
                        break_m $ Result::ok(str)
                    }
                };
                let str = str + String::_unsafe_from_c_str(buf);
                if upto_newline {
                    // If the last character is \n, break.
                    let last_byte = str.get_last_byte.as_some;
                    if last_byte == '\n' { 
                        break_m $ Result::ok(str)
                    };
                    continue_m $ str
                } else {
                    continue_m $ str
                }
            )
        }
    );

    // Closes a file.
    // 
    // Unlike C's `fclose`, closing an already closed `IOHandle` is safe and does nothing.
    // 
    // # Parameters
    // 
    // * `handle` - The IOHandle to be closed.
    close_file : IOHandle -> IO ();
    close_file = |handle| handle.@_data.borrow_io(|handle_ptr| FFI_CALL_IO[() fixruntime_iohandle_close(Ptr), handle_ptr]);

    // Prints a string to stderr.
    // 
    // # Parameters
    // 
    // * `msg` - The string to be printed.
    eprint : String -> IO ();
    eprint = |msg| msg.borrow_c_str_io(|c_str| FFI_CALL_IO[CInt fputs(Ptr, Ptr), c_str, *stderr.get_file_ptr]);; pure();

    // Prints a string followed by a newline to stderr.
    // 
    // # Parameters
    // 
    // * `msg` - The string to be printed.
    eprintln : String -> IO ();
    eprintln = |msg| msg.borrow_c_str_io(|c_str| FFI_CALL_IO[CInt fixruntime_fputs_line(Ptr, Ptr), c_str, *stderr.get_file_ptr]);; pure();

    // Exits the program with an error code.
    // 
    // # Parameters
    // 
    // * `code` - The error code to be returned.
    exit : I64 -> IO a;
    exit = |code| FFI_CALL_IO[() exit(CInt), code.c_int];; pure $ undefined("");

    // Exits the program with an error message and an error code.
    //  
    // The error message is written to the standard error output.
    // 
    // # Parameters
    // 
    // * `code` - The error code to be returned.
    // * `msg` - The error message to be printed.
    exit_with_msg : I64 -> String -> IO a;
    exit_with_msg = |code, msg| eprintln(msg);; exit(code);

    // Flushes an `IOHandle`.
    // 
    // # Parameters
    // * `handle` - The `IOHandle` to be flushed.
    flush : IOHandle -> IO I32;
    flush = |handle| (
        let file_ptr = *handle.get_file_ptr;
        let res = *FFI_CALL_IO[CInt fflush(Ptr), file_ptr];
        res.i32.pure
    );

    // Creates an IO action from a IO runner function, which is a function of type `IOState -> (IOState, a)`.
    // 
    // # Parameters
    //
    // * `io_runner` - The IO runner function.
    from_runner : (IOState -> (IOState, a)) -> IO a;
    from_runner = |runner| IO { runner : runner };

    // `get_arg(i)` returns the i-th (0-indexed) command line argument.
    // 
    // If i is greater than or equal to the number of command line arguments, this function returns none.
    // 
    // # Parameters
    // 
    // * `i` - The index of the command line argument.
    get_arg : I64 -> IO (Option String);
    get_arg = |n| (
        let argc = *get_arg_count;
        if n >= argc { pure $ Option::none() };
        let arg_ptr = *(FFI_CALL_IO[Ptr fixruntime_get_argv(I64), n]);
        pure $ Option::some(String::unsafe_from_c_str_ptr(arg_ptr))
    );

    // Gets the number of command line arguments.
    get_arg_count : IO I64;
    get_arg_count = (
        let argc = *(FFI_CALL_IO[I32 fixruntime_get_argc()]);
        pure $ argc.i64
    );

    // Gets command line arguments.
    get_args : IO (Array String);
    get_args = (
        let argc = *get_arg_count;
        let args = Array::empty(argc);
        loop_m((args, 0), |(args, idx)| (
            if idx == argc { break_m $ args };
            let arg = (*get_arg(idx)).as_some;
            continue_m $ (args.push_back(arg), idx + 1)
        ))
    );

    // Reads a line from stdin. 
    //
    // This function's return value contains a newline code.
    // 
    // If an error occurs while reading from stdin, this function exits the program.
    // If you want to handle errors, use `read_line(stdin)` instead.
    input_line : IO String;
    input_line = (
        let res = *read_line(stdin).to_result;
        if res.is_ok {
            pure $ res.as_ok
        } else {
            pure $ undefined(res.as_err.to_string)
        }
    );

    // Reads a line from stdin. 
    //
    // This function strips the newline code at the end of the line.
    // 
    // If an error occurs while reading from stdin, this function exits the program.
    // If you want to handle errors, use `read_line(stdin)` instead.
    input_line_s : IO String;
    input_line_s = (
        let line = *input_line;
        pure $ line.strip_last_newlines
    );

    // Checks if an `IOHandle` reached to the EOF.
    // 
    // # Parameters
    // 
    // * `handle` - The IOHandle to be checked.
    is_eof : IOHandle -> IO Bool;
    is_eof = |handle| FFI_CALL_IO[CInt feof(Ptr), *handle.get_file_ptr].map(|res| res != 0.c_int);

    // Loop on lines read from an `IOHandle`.
    // 
    // `loop_lines(handle, initial_state, worker)` calls `worker` on the pair of current state and a line string read from `handle`.
    // The function `worker` should return an updated state as `LoopState` value, i.e., a value created by `continue` or `break`.
    // When the `handle` reaches to the EOF or `worker` returns a `break` value, `loop_lines` returns the last state value.
    // 
    // Note that the line string passed to `worker` may contain a newline code at the end. To remove it, use `String::strip_last_spaces`.
    //
    // The file is divided into lines at each newline, as a text editor numbers them. After a last line
    // that ends in a newline, `worker` is called once more with the empty string, and on an empty file
    // it is called once with the empty string. These are the only cases in which `worker` receives the
    // empty string: an empty line elsewhere comes as `"\n"`. To skip that empty string, `break` when
    // `worker` receives it.
    // 
    // # Parameters
    // 
    // * `handle` - The IOHandle to be read.
    // * `state` - The initial state.
    // * `worker` - The function to be called on the pair of current state and a line string read from `handle`.
    loop_lines : IOHandle -> s -> (s -> String -> LoopState s s) -> IOFail s;
    loop_lines = |handle, state, worker| (
        if *is_eof(handle).lift {
            pure $ state
        };
        let line = *read_line(handle);
        let res = worker(state, line);
        if res.is_break {
            pure $ res.as_break
        };
        let next_state = res.as_continue;
        loop_lines(handle, next_state, worker)
    );

    // Loop on lines read from an `IOHandle`.
    // 
    // Similar to `loop_lines`, but the worker function can perform an IO action. It passes `worker` the
    // same lines as `loop_lines`, the empty string after a last newline included.
    // 
    // # Parameters
    //
    // * `handle` - The IOHandle to be read.
    // * `state` - The initial state.
    // * `worker` - The function to be called on the pair of current state and a line string read from `handle`.
    loop_lines_io : IOHandle -> s -> (s -> String -> IOFail (LoopState s s)) -> IOFail s;
    loop_lines_io = |handle, state, worker| (
        if *is_eof(handle).lift {
            pure $ state
        };
        let line = *read_line(handle);
        let res = *worker(state, line);
        if res.is_break {
            pure $ res.as_break
        };
        let next_state = res.as_continue;
        loop_lines_io(handle, next_state, worker)
    );

    // Openes a file. The second argument is a mode string for `fopen` C function.
    // 
    // # Parameters
    //
    // * `path` - The path to the file to be opened.
    // * `mode` - The mode string for `fopen` C function.
    open_file : Path -> String -> IOFail IOHandle;
    open_file = |path, mode| (
        let path = path.to_string;
        IOFail::from_io_result $ path.borrow_c_str_io(|path_ptr| mode.borrow_c_str_io(|mode_ptr|
            let file_ptr = *FFI_CALL_IO[Ptr fopen(Ptr, Ptr), path_ptr, mode_ptr];
            if file_ptr == nullptr { 
                pure $ Result::err $ "Failed to open a file: " + path
            } else {
                pure $ Result::ok $ *IOHandle::from_file_ptr(file_ptr)
            }
        ))
    );

    // Prints a string to stdout.
    // 
    // # Parameters
    //
    // * `msg` - The string to be printed.
    print : String -> IO ();
    print = |msg| msg.borrow_c_str_io(|c_str| FFI_CALL_IO[CInt fputs(Ptr, Ptr), c_str, *stdout.get_file_ptr]);; pure();

    // Prints a string followed by a newline to stdout.
    // 
    // # Parameters
    //
    // * `msg` - The string to be printed.
    println : String -> IO ();
    println = |msg| msg.borrow_c_str_io(|c_str| FFI_CALL_IO[CInt fixruntime_fputs_line(Ptr, Ptr), c_str, *stdout.get_file_ptr]);; pure();

    // Reads all characters from a file.
    // 
    // # Parameters
    //
    // * `path` - The path to the file to be read.
    read_file_string : Path -> IOFail String;
    read_file_string = |path| with_file(path, "r", read_string);

    // Reads all bytes from a file.
    // 
    // # Parameters
    //
    // * `path` - The path to the file to be read.
    read_file_bytes : Path -> IOFail (Array U8);
    read_file_bytes = |path| with_file(path, "r", read_bytes);

    // Reads one line from an IOHandle: the characters up to and including the next newline, or up to
    // the end of the file where the last line has no newline.
    //
    // A line keeps its newline, so an empty line is returned as `"\n"`. Once every line has been read,
    // this function returns the empty string, and it is the only case in which it does. To read every
    // line, call this function until it returns the empty string.
    // 
    // # Parameters
    // 
    // * `handle` - The IOHandle to be read.
    read_line : IOHandle -> IOFail String;
    read_line = _read_line_inner(true);

    // Reads all bytes from an IOHandle.
    // 
    // # Parameters
    // 
    // * `handle` - The IOHandle to be read.
    read_bytes : IOHandle -> IOFail (Array U8);
    read_bytes = |handle| (
        // Get all bytes into an array of buffers.
        let (bufs, len) = *loop_m(([], 0), |(bufs, len)| (
            let buf = *read_n_bytes(handle, 1024);
            if buf.is_empty {
                break_m $ (bufs, len)
            } else {
                continue_m $ (bufs.push_back(buf), len + buf.@size)
            }
        ));
        // Concatenate all buffers.
        let res = Array::empty(len);
        pure $ bufs.to_iter.fold(res, |bytes, res| res.append(bytes))
    );

    // Reads at most n bytes from an IOHandle.
    // 
    // # Parameters
    //
    // * `handle` - The IOHandle to be read.
    // * `n` - The maximum number of bytes to be read.
    read_n_bytes : IOHandle -> I64 -> IOFail (Array U8);
    read_n_bytes = |handle, n| IOFail::from_io_result $ do {
        // Get the file pointer.
        let file_ptr = *handle.get_file_ptr;

        // Read n bytes into a buffer.
        let buf = Array::empty(n);
        let (buf, len) = buf.mutate_elements(|buf| FFI_CALL_IO[CSizeT fread(Ptr, CSizeT, CSizeT, Ptr), buf, 1.c_size_t, n.c_size_t, file_ptr]);

        // Check error.
        let err = *FFI_CALL_IO[CInt ferror(Ptr), file_ptr];
        if err != 0.c_int { 
            let err = "`Std::IO::read_n_bytes` failed!: Some error occurred in `fread`.";
            pure $ Result::err(err)
        };

        // Return the result.
        let buf = buf._unsafe_grow_size(len.i64);
        pure $ Result::ok(buf)
    };

    // Reads all characters from an IOHandle.
    // 
    // # Parameters
    //
    // * `handle` - The IOHandle to be read.
    read_string : IOHandle -> IOFail String;
    read_string = _read_line_inner(false);

    // The handle for standard input.
    stdin : IOHandle;
    stdin = do { IOHandle::from_file_ptr $ *FFI_CALL_IO[Ptr fixruntime_c_stdin()] }.unsafe_perform;

    // The handle for standard output.
    stdout : IOHandle;
    stdout = do { IOHandle::from_file_ptr $ *FFI_CALL_IO[Ptr fixruntime_c_stdout()] }.unsafe_perform;

    // The handle for standard error.
    stderr : IOHandle;
    stderr = do { IOHandle::from_file_ptr $ *FFI_CALL_IO[Ptr fixruntime_c_stderr()] }.unsafe_perform;

    // Performs a function with a file handle. The second argument is a mode string for `fopen` C function. 
    // 
    // The file handle will be closed automatically.
    // 
    // # Parameters
    //
    // * `path` - The path to the file to be opened.
    // * `mode` - The mode string for `fopen` C function.
    // * `action` - The function to be called on the opened file handle.
    with_file : Path -> String -> (IOHandle -> IOFail a) -> IOFail a;
    with_file = |path, mode, action| (
        let handle = *open_file(path, mode);
        let res = *action(handle).to_result.lift;
        close_file(handle).lift;;
        res.from_result
    );

    // Writes a byte array into an IOHandle.
    // 
    // # Parameters
    // 
    // * `handle` - The IOHandle to be written.
    // * `array` - The byte array to be written.
    write_bytes : IOHandle -> Array U8 -> IOFail ();
    write_bytes = |handle, array| IOFail::from_io_result $ do {
        let file_ptr = *handle.get_file_ptr;
        let arr_size = array.@size;
        array.borrow_elements_io(|array_buf|
            let written = *FFI_CALL_IO[CSizeT fwrite(Ptr, CSizeT, CSizeT, Ptr), array_buf, 1.c_size_t, arr_size.c_size_t, file_ptr];
            if written.i64 < arr_size { pure $ Result::err $ "`Std::IO::write_bytes` failed!: some error occurred in `fwrite`." };
            pure $ Result::ok()
        )
    };

    // Writes a byte array into a file.
    // 
    // # Parameters
    //
    // * `path` - The path to the file to be written.
    // * `content` - The byte array to be written.
    write_file_bytes : Path -> Array U8 -> IOFail ();
    write_file_bytes = |path, content| with_file(path, "w", |handle| write_bytes(handle, content));

    // Writes a string into a file.
    // 
    // # Parameters
    //
    // * `path` - The path to the file to be written.
    // * `content` - The string to be written.
    write_file_string : Path -> String -> IOFail ();
    write_file_string = |path, content| with_file(path, "w", |handle| write_string(handle, content));

    // Writes a string into an IOHandle.
    // 
    // # Parameters
    //
    // * `handle` - The IOHandle to be written.
    // * `content` - The string to be written.
    write_string : IOHandle -> String -> IOFail ();
    write_string = |handle, content| IOFail::from_io_result $ do {
        let file_ptr = *handle.get_file_ptr;
        content.borrow_c_str_io(|c_str|
            let res = *FFI_CALL_IO[CInt fputs(Ptr, Ptr), c_str, file_ptr];
            if res < 0.c_int { pure $ Result::err $ "`Std::IO::write_string` failed!: some error occurred in fputs." };
            pure $ Result::ok()
        )
    };
}

impl IO : Functor {
    map = |f, io| IO::from_runner $ |iostate| (
        let (iostate, a) = (io.@runner)(iostate);
        (iostate, f(a))
    );
}

impl IO : Monad {
    pure = |v| IO { runner : |iostate| (iostate, v) };
    bind = |f, io| (
        IO::from_runner $ |iostate| (
            let (iostate, a) = (io.@runner)(iostate);
            (f(a).@runner)(iostate)
        )
    );
}

namespace IO {
    // A handle type for read / write operations on files, stdin, stdout, stderr.
    // 
    // You can create `IOHandle` value by `IO::open_file`, and close it by `IO::close_file`. 
    // There are also global `IO::IOHandle::stdin`, `IO::IOHandle::stdout`, `IO::IOHandle::stderr`.
    // 
    // `IOHandle` is different from C's `FILE` structure in that it is safe to close it twice.
    // If you try to get a file pointer by `file_ptr` from a closed `IOHandle`, you will get `nullptr`.
    //
    // NOTE: 
    // `IOHandle` is implemented by `Destructor`, but the destructor function does not close the file pointer.
    // (The destructor function only frees the management memory area.)
    // You should explicitly close the file pointer by `IO::close_file`.
    type IOHandle = unbox struct { _data : Destructor Ptr };
}

namespace IO::IOHandle {
    // Gets pointer to C's `FILE` value from an `IOHandle`.
    //
    // If the `IOHandle` is already closed, the function returns `nullptr`.
    // 
    // NOTE: 
    // Do not directly close the file pointer by `fclose` or other functions.
    // Instead you should close `IOHandle` by `IO::close_file`.
    // 
    // NOTE: 
    // If `IO::close` is called while using the `Ptr` obtained by this function, the `Ptr` becomes invalid and may cause undefined behavior.
    //
    // # Parameters
    //
    // * `handle` - The IOHandle to get the file pointer from.
    get_file_ptr : IOHandle -> IO Ptr;
    get_file_ptr = |handle| handle.@_data.borrow_io(|handle_ptr| FFI_CALL_IO[Ptr fixruntime_iohandle_get_file(Ptr), handle_ptr]);

    // Creates an `IOHandle` from a file pointer (i.e., pointer to C's `FILE`).
    // 
    // Creating two `IOHandle`s from a single file pointer is forbidden.
    // 
    // # Parameters
    // 
    // * `file_ptr` - The file pointer to be wrapped.
    from_file_ptr : Ptr -> IO IOHandle;
    from_file_ptr = |file_ptr| (
        let handle_ptr = *FFI_CALL_IO[Ptr fixruntime_iohandle_create(Ptr), file_ptr];
        let dtor = |handle_ptr| FFI_CALL_IO[() fixruntime_iohandle_delete(Ptr), handle_ptr];; pure $ nullptr;
        let dtor = *Destructor::make(handle_ptr, dtor);
        pure $ IOHandle { _data : dtor }
    );
}

namespace IO {
    // The type for I/O actions which may fail.
    type IOFail a = unbox struct { _data : IO (Result ErrMsg a) };
}

namespace IO::IOFail {
    // Create from IO action of which returns `Result ErrMsg a`.
    // 
    // # Parameters
    //
    // * `io_res` - The IO action to be converted.
    from_io_result : IO (Result ErrMsg a) -> IOFail a;
    from_io_result = |io_res| IOFail { _data : io_res };

    // Creates an pure `IOFail` value from a `Result` value.
    // 
    // # Parameters
    // 
    // * `res` - The result value to be converted.
    from_result : Result ErrMsg a -> IOFail a;
    from_result = |res| IOFail { _data : pure(res) };

    // Lifts an `IO` action to a successful `IOFail` action.
    // 
    // # Parameters
    //
    // * `io` - The IO action to be lifted.
    lift : IO a -> IOFail a;
    lift = |io| IOFail { _data : io.map(pure) };

    // Creates an error `IOFail` action.
    // 
    // # Parameters
    //
    // * `err_msg` - The error message to be thrown.
    throw : ErrMsg -> IOFail a;
    throw = |e| from_result $ Result::err(e);

    // Converts an `IOFail` to an `Result` value (wrapped by `IO`).
    //
    // # Parameters
    //
    // * `io_fail` - The `IOFail` value to be converted.
    to_result : IOFail a -> IO (Result ErrMsg a);
    to_result = @_data;

    // Converts an `IOFail` value to an `IO` value by an error handler (i.e., a `catch`) function.
    // 
    // # Parameters
    // 
    // * `catch` - The error handler function to be called on the error.
    // * `io_fail` - The `IOFail` value to be run.
    try : (ErrMsg -> IO a) -> IOFail a -> IO a;
    try = |catch, iof| (
        let res = *iof.to_result;
        if res.is_ok { pure $ res.as_ok } else { catch(res.as_err) }
    );
}

impl IOFail : Functor {
    map = |f, iof| IOFail { _data : iof.@_data.map(map(f)) };
}

impl IOFail : Monad {
    pure = |v| IOFail { _data : pure(pure(v)) };
    bind = |f, iof| IOFail { _data : do {
        let res = *iof.@_data;
        if res.is_err { pure $ Result::err $ res.as_err };
        f(res.as_ok).@_data
    }};
}

// The trait of iterators.
// 
// Iterator is a concept of a sequence of elements that can be iterated.
// More precisely, an iterator is a type whose data is "the current state" and has a method `advance` which returns the next element and the next state.
trait iter : Iterator {
    // The type of the element of the iterator.
    type Item iter;
    // Advances the iterator and returns the next element and the next state.
    // If the iterator has no more elements, it returns `none()`.
    // 
    // # Parameters
    // * `iter` - The iterator to be advanced.
    advance : iter -> Option (iter, Item iter);
}

namespace Iterator {
    /*
        Folding and looping.
    */

    // Fold the elements of an iterator from left to right.
    //
    // Conceptually, `[a0, a1, a2, ...].to_iter.fold(s, op) = s.op(a0).op(a1).op(a2)...`.
    // 
    // # Parameters
    //
    // * `s` - The initial state.
    // * `body` - The function to be called on the pair of an element and the current state.
    // * `iter` - The iterator to be folded.
    fold : [iter : Iterator, Item iter = a] s -> (a -> s -> s) -> iter -> s;
    fold = |s, op, iter| (
        match iter.advance {
            none() => s,
            some((iter, a)) => iter.fold(op(a, s), op)
        }
    );

    // Fold the elements of an iterator from left to right by monadic action.
    // 
    // # Parameters
    //
    // * `s` - The initial state.
    // * `body` - The function to be called on the pair of an element and the current state.
    // * `iter` - The iterator to be folded.
    fold_m : [m : Monad, iter : Iterator, Item iter = a] s -> (a -> s -> m s) -> iter -> m s;
    fold_m = |s, op, iter| (
        match iter.advance {
            none() => pure(s),
            some((iter, a)) => op(a, s).bind(|s| iter.fold_m(s, op))
        }
    );

    // Loop over the elements of an iterator.
    // 
    // This function is similar to `fold` but a more general version of it. It allows the user to break out of the loop at any point.
    // 
    // # Parameters
    //
    // * `s` - The initial state.
    // * `body` - The function to be called on the pair of an element and the current state.
    // * `iter` - The iterator to be looped.
    loop_iter : [iter : Iterator, Item iter = a] s -> (a -> s -> LoopState s s) -> iter -> s;
    loop_iter = |s, body, iter| (
        match iter.advance {
            none() => s,
            some((iter, a)) => match body(a, s) {
                break(s) => s,
                continue(s) => iter.loop_iter(s, body),
            }
        }
    );

    // Loop over the elements of an iterator.
    // 
    // This function is similar to `loop_iter`, but it returns a `LoopState`. 
    // This allows you to return different types for `break` and `continue`.
    // 
    // # Parameters
    //
    // * `s` - The initial state.
    // * `body` - The function to be called on the pair of an element and the current state.
    // * `iter` - The iterator to be looped.
    loop_iter_s : [iter : Iterator, Item iter = a] s -> (a -> s -> LoopState s b) -> iter -> LoopState s b;
    loop_iter_s = |s, body, iter| (
        match iter.advance {
            none() => continue(s),
            some((iter, a)) => match body(a, s) {
                break(s) => break(s),
                continue(s) => iter.loop_iter_s(s, body),
            }
        }
    );

    // Loop over the elements of an iterator by monadic action.
    // 
    // # Parameters
    //
    // * `s` - The initial state.
    // * `body` - The function to be called on the pair of an element and the current state.
    // * `iter` - The iterator to be looped.
    loop_iter_m : [m : Monad, iter : Iterator, Item iter = a] s -> (a -> s -> m (LoopState s s)) -> iter -> m s;
    loop_iter_m = |s, body, iter| (
        match iter.advance {
            none() => pure(s),
            some((iter, a)) => body(a, s).bind(|state| match state {
                break(s) => pure(s),
                continue(s) => iter.loop_iter_m(s, body),
            })
        }
    );

    // Loop over the elements of an iterator by monadic action.
    //
    // This function is similar to `loop_iter_s`, but it returns a `LoopState`.
    // This allows you to return different types for `break_m` and `continue_m`.
    //
    // # Parameters
    //
    // * `s` - The initial state.
    // * `body` - The function to be called on the pair of an element and the current state.
    // * `iter` - The iterator to be looped.
    loop_iter_ms : [m : Monad, iter : Iterator, Item iter = a] s -> (a -> s -> m (LoopState s b)) -> iter -> m (LoopState s b);
    loop_iter_ms = |s, body, iter| (
        match iter.advance {
            none() => pure(continue(s)),
            some((iter, a)) => body(a, s).bind(|state| match state {
                break(s) => pure(break(s)),
                continue(s) => iter.loop_iter_ms(s, body),
            })
        }
    );

    // Executes monadic actions and collects the results into an array.
    //
    // # Parameters
    //
    // * `iter` - The iterator of monads to be collected.
    collect_m : [m : Monad, iter : Iterator, Item iter = m a] iter -> m (Array a);
    collect_m = |iter| iter.fold_m([], |act, acm| pure $ acm.push_back(*act));

    // Calcculate sum of the elements of an iterator.
    //
    // # Parameters
    //
    // * `iter` - The iterator of elements to be summed.
    sum : [iter : Iterator, Item iter = a, a : Additive] iter -> a;
    sum = |iter| iter.fold(zero, |a, acc| acc + a);

    // Compare two iterators by their elements.
    //
    // # Parameters
    //
    // * `iter1` - The first iterator to be compared.
    // * `iter2` - The second iterator to be compared.
    is_equal : [iter1 : Iterator, iter2 : Iterator, Item iter1 = a, Item iter2 = a, a : Eq] iter1 -> iter2 -> Bool;
    is_equal = |iter1, iter2| (
        match iter1.advance {
            none() => match iter2.advance {
                none() => true,
                some(_) => false
            },
            some((iter1, a1)) => match iter2.advance {
                none() => false,
                some((iter2, a2)) => a1 == a2 && iter1.is_equal(iter2)
            }
        }
    );

    /*
        Conversion to arrays.
    */

    // Convert an iterator to an array.
    // 
    // # Parameters
    //
    // * `iter` - The iterator to be converted.
    to_array : [iter : Iterator, Item iter = a] iter -> Array a;
    to_array = |iter| iter.fold([], |a, acc| acc.push_back(a));

    // Create an iterator from an array.
    // 
    // # Parameters
    //
    // * `array` - The array to be converted to an iterator.
    from_array : [?it : Iterator, Item ?it = a] Array a -> ?it;
    from_array = |arr| ArrayIterator { arr: arr, idx: 0 };

    // Iterators that yields elements of an array.
    type ArrayIterator a = unbox struct { arr : Array a, idx : I64 };

    impl ArrayIterator a : Iterator {
        type Item (ArrayIterator a) = a;
        // Stop with `idx >= arr.@size` (not `idx == arr.@size`) so the loop guard is `idx < arr.@size`,
        // the same condition as the bounds check inside `arr.@(idx)`. LLVM then proves the check
        // redundant and vectorizes the read loop; see `RangeIterator` for the full rationale.
        advance : ArrayIterator a -> Option (ArrayIterator a, a) = |ArrayIterator { arr : arr, idx : idx }| (
            if idx >= arr.@size { none() };
            let v = arr.@(idx);
            some((ArrayIterator { arr: arr, idx: idx + 1 }, v))
        );
    }

    // Convert any iterator to an array iterator.
    // 
    // All elements of the input iterator are collected into an array. Therefore, this function may consume a lot of memory.
    // On the other hand, iteration may be faster by banging.
    //
    // # Parameters
    //
    // * `iter` - The iterator.
    bang : [?out : Iterator, Item ?out = a, input : Iterator, Item input = a] input -> ?out;
    bang = |iter| iter.to_array.to_iter;

    /*
        Basic iterators.
    */

    // Iterators that yields no elements.
    type EmptyIterator a = unbox struct {};
    impl EmptyIterator a : Iterator {
        type Item (EmptyIterator a) = a;
        advance = |_| none();
    }

    // An iterator that yields no elements.
    // 
    // NOTE: When using this iterator, you may need to specify the element type explicitly, e.g., via a type annotation on the surrounding expression.
    empty : [?it : Iterator, Item ?it = a] ?it;
    empty = EmptyIterator {};

    // Iterators that yields reversed elements of an iterator.
    type RangeIterator = unbox struct { next : I64, end : I64 };

    impl RangeIterator : Iterator {
        type Item RangeIterator = I64;
        // Stop when `next` reaches `end` via `>=`, and let `range` pass `end` through unclamped
        // (below). The loop guard is then `next < end`, syntactically the same as the array bounds
        // check `i < arr.@size` when iterating `range(0, arr.@size)`, so LLVM proves the per-element
        // check redundant and vectorizes the loop. Testing `next == end` instead would force `range`
        // to clamp `end` to `start` for empty ranges, and that clamp lowers to a `select` on the size
        // that hides the equality and blocks the vectorization.
        advance = |RangeIterator { next : next, end : end }| (
            if next >= end { Option::none() }
            else { Option::some $ (RangeIterator { next: next + 1, end: end }, next) }
        );
    }

    // Create an iterator that generates a range of numbers.
    //
    // `range(a, b)` generates a range of numbers from `a` to `b - 1`.
    //
    // If `a` is greater than or equal to `b`, the iterator will an empty iterator.
    //
    // # Parameters
    //
    // * `start` - The start of the range.
    // * `end` - The end of the range.
    range : [?it : Iterator, Item ?it = I64] I64 -> I64 -> ?it;
    range = |start, end| (
        RangeIterator { next: start, end: end }
    );

    type RangeStepIterator = unbox struct { next : I64, end : I64, step : I64 };

    impl RangeStepIterator : Iterator {
        type Item RangeStepIterator = I64;
        // Stop when `next` reaches `end` from the stepping direction (`>=` counting up, `<=` counting
        // down), which leaves `end` equal to the caller's bound: `range_step` no longer has to round
        // `end` to an exact multiple of `step` to make a `next == end` test terminate. This keeps the
        // loop guard aligned with an array bounds check so LLVM can vectorize; see `RangeIterator` for
        // the full rationale. `step` is loop-invariant, so the direction test hoists out of the loop.
        advance = |RangeStepIterator { next : next, end : end, step : step }| (
            let finished = if step >= 0 { next >= end } else { next <= end };
            if finished { Option::none() };
            Option::some $ (RangeStepIterator { next: next + step, end: end, step: step }, next)
        );
    }

    // Create an iterator that generates a range of numbers with a step.
    //
    // `range_step(a, b, s)` yields `a, a + s, a + 2*s, ...`, stopping before it would pass `b`:
    // values stay below `b` when `s > 0` and above `b` when `s < 0`. It is empty when `s` points
    // away from `b`. `s` must not be 0.
    //
    // # Parameters
    //
    // * `start` - The start of the range.
    // * `end` - The end of the range.
    // * `step` - The step of the range.
    range_step : [?it : Iterator, Item ?it = I64] I64 -> I64 -> I64 -> ?it;
    range_step = |start, end, step| (
        if step == 0 { undefined("[range_step] step must not be 0!") };
        RangeStepIterator { next: start, end: end, step: step }
    );

    type CountUpIterator = unbox struct { next : I64 };

    impl CountUpIterator : Iterator {
        type Item CountUpIterator = I64;
        advance = |CountUpIterator { next : next }| some((CountUpIterator { next: next + 1 }, next));
    }

    // Create an iterator that counts up from a number.
    // 
    // `count_up(start)` generates an infinite sequence of numbers starting from `start`.
    //
    // # Parameters
    //
    // * `start` - The start of the count.
    count_up : [?it : Iterator, Item ?it = I64] I64 -> ?it;
    count_up = |start| CountUpIterator { next: start };

    type StateIterator s a = unbox struct {
        state : Option s,
        transit : s -> Option (s, a)
    };

    impl StateIterator s a : Iterator {
        type Item (StateIterator s a) = a;
        advance = |StateIterator { state : s, transit : f }| (
            match s {
                none() => none(),
                some(s) => match f(s) {
                    none() => none(),
                    some((s, a)) => some((StateIterator { state: some(s), transit: f }, a))
                }
            }
        );
    }

    // Create an iterator that generates elements by the state transition function.
    // 
    // # Parameters
    //
    // * `state` - The initial state.
    // * `transition` - The state transition function that takes the current state and returns the next state and the next element.
    generate : [?it : Iterator, Item ?it = a] s -> (s -> Option (s, a)) -> ?it;
    generate = |state, transit| StateIterator { state: some(state), transit: transit };

    // Create an iterator by a function that returns element at each index.
    // 
    // # Parameters
    //
    // * `map` - The function that takes an index and returns the element at that index.
    from_map : [?it : Iterator, Item ?it = a] (I64 -> a) -> ?it;
    from_map = |f| count_up(0).map(f);

    /*
        Extract information from iterators.
    */

    // Get the number of elements in an iterator.
    // 
    // # Parameters
    //
    // * `iter` - The iterator to be counted.
    get_size : [iter : Iterator] iter -> I64;
    get_size = |iter| iter.fold(0, |_, acc| acc + 1);

    // Get the first element of an iterator.
    // 
    // If the iterator is empty, this function returns `none()`.
    //
    // # Parameters
    //
    // * `iter` - The iterator.
    get_first : [iter : Iterator] iter -> Option (Item iter);
    get_first = |iter| iter.advance.map(|(_, a)| a);

    // Get the last element of an iterator.
    // 
    // If the iterator is empty, this function returns `none()`.
    //
    // # Parameters
    //
    // * `iter` - The iterator.
    get_last : [iter : Iterator] iter -> Option (Item iter);
    get_last = |iter| iter.fold(none(), |a, _| some(a));

    // Get the tail of an iterator.
    // 
    // If the iterator is empty, this function returns `none()`.
    // 
    // # Parameters
    //
    // * `iter` - The iterator.
    get_tail : [iter : Iterator] iter -> Option iter;
    get_tail = |iter| iter.advance.map(|(iter, _)| iter);

    // Remove the first element of an iterator.
    // 
    // If the iterator is empty, this function does nothing.
    //
    // # Parameters
    //
    // * `iter` - The iterator.
    pop_first : [iter : Iterator] iter -> iter;
    pop_first = |iter| (
        match iter.advance {
            none() => iter,
            some((iter, _)) => iter
        }
    );

    // Is an iterator empty?
    //
    // # Parameters
    //
    // * `iter` - The iterator.
    is_empty : [iter : Iterator] iter -> Bool;
    is_empty = |iter| iter.advance.is_none;

    /*
        Transforming iterators.
    */

    type MapIterator i a b = unbox struct { iter : i, f : a -> b };
    impl [i : Iterator, Item i = a] MapIterator i a b : Iterator {
        type Item (MapIterator i a b) = b;
        advance = |MapIterator { iter : iter, f : f }| (
            match iter.advance {
                none() => none(),
                some((iter, a)) => some((MapIterator { iter: iter, f: f }, f(a)))
            }
        );
    }

    // Map a function over an iterator.
    // 
    // `iter.map(f)` returns an iterator that applies `f` to each element of `iter`.
    //
    // # Parameters
    //
    // * `f` - The function to be applied to each element of the iterator.
    // * `iter` - The iterator to be mapped.
    map : [?out : Iterator, Item ?out = b, input : Iterator, Item input = a] (a -> b) -> input -> ?out;
    map = |f, iter| MapIterator { iter: iter, f: f };

    // The next element of `iter` that `pred` accepts, with the iterator advanced past it. The
    // predicate is handed over as an argument so that the loop skipping the rejected elements is a
    // body of its own, which is what lets `advance` go into the loop consuming it.
    _skip_until : [i : Iterator, Item i = a] (a -> Bool) -> i -> Option (i, a);
    _skip_until = |pred, iter| (
        loop(iter, |iter|
            match iter.advance {
                none() => break $ none(),
                some((iter, a)) => if pred(a) { break $ some((iter, a)) } else { continue $ iter }
            }
        )
    );

    type FilterIterator i a = unbox struct { iter : i, pred : a -> Bool };
    impl [i : Iterator, Item i = a] FilterIterator i a : Iterator {
        type Item (FilterIterator i a) = Item i;
        advance = |FilterIterator { iter : iter, pred : pred }| (
            match _skip_until(pred, iter) {
                none() => none(),
                some((iter, a)) => some((FilterIterator { iter: iter, pred: pred }, a))
            }
        );
    }

    // Filter the elements of an iterator by a predicate.
    // 
    // `iter.filter(pred)` returns an iterator that only yields elements of `iter` for which `pred` returns `true`.
    // 
    // # Parameters
    //
    // * `predicate` - The predicate function to be applied to each element of the iterator.
    // * `iter` - The iterator to be filtered.
    filter : [?out : Iterator, Item ?out = a, input : Iterator, Item input = a] (a -> Bool) -> input -> ?out;
    filter = |pred, iter| FilterIterator { iter: iter, pred: pred };

    // The next element of `iter` that `f` maps to `some`, with the iterator advanced past it, and
    // the value `f` gave it. The function is handed over as an argument so that the loop skipping
    // the elements it declines is a body of its own, which is what lets `advance` go into the loop
    // consuming it.
    _map_until : [i : Iterator, Item i = a] (a -> Option b) -> i -> Option (i, b);
    _map_until = |f, iter| (
        match iter.advance {
            none() => none(),
            some((iter, a)) => match f(a) {
                none() => _map_until(f, iter),
                some(b) => some((iter, b))
            }
        }
    );

    type FilterMapIterator i a b = unbox struct { iter : i, f : a -> Option b };
    impl [i : Iterator, Item i = a] FilterMapIterator i a b : Iterator {
        type Item (FilterMapIterator i a b) = b;
        advance = |FilterMapIterator { iter : iter, f : f }| (
            match _map_until(f, iter) {
                none() => none(),
                some((iter, b)) => some((FilterMapIterator { iter: iter, f: f }, b))
            }
        );
    }

    // Filter and map the elements of an iterator.
    // 
    // `iter.filter_map(f)` returns an iterator that applies `f` to each element of `iter` and yields the result if it is `some`.
    // 
    // # Parameters
    //
    // * `f` - The function to be applied to each element of the iterator.
    // * `iter` - The iterator to be filtered and mapped.
    filter_map : [?out : Iterator, Item ?out = b, input : Iterator, Item input = a] (a -> Option b) -> input -> ?out;
    filter_map = |f, iter| FilterMapIterator { iter: iter, f: f };

    // The next element any inner iterator yields, with both iterators advanced past it. The walk
    // past the inner iterators that yield nothing is a body of its own, which is what lets
    // `advance` go into the loop consuming it.
    _inner_until : [i2 : Iterator, i1 : Iterator, Item i2 = i1] i2 -> Option i1 -> Option (i2, i1, Item i1);
    _inner_until = |i2, i1| (
        match i1 {
            none() => (
                match i2.advance {
                    none() => none(),
                    some((i2, i1)) => _inner_until(i2, some(i1))
                }
            ),
            some(i1) => (
                match i1.advance {
                    none() => _inner_until(i2, none()),
                    some((i1, a)) => some $ (i2, i1, a)
                }
            )
        }
    );

    type FlattenIterator i2 i1 = unbox struct { i2 : i2, i1 : Option i1 };
    impl [i2 : Iterator, i1: Iterator, Item i2 = i1] FlattenIterator i2 i1 : Iterator {
        type Item (FlattenIterator i2 i1) = Item i1;
        advance = |FlattenIterator { i2 : i2, i1 : i1 }| (
            match _inner_until(i2, i1) {
                none() => none(),
                some((i2, i1, a)) => some $ (FlattenIterator { i2: i2, i1: some(i1) }, a)
            }
        );
    }

    // Flatten an iterator of iterators.
    // 
    // # Parameters
    //
    // * `iter_iter` - The iterator of iterators.
    flatten : [?out : Iterator, Item ?out = Item inner, input : Iterator, inner : Iterator, Item input = inner] input -> ?out;
    flatten = |iter| FlattenIterator { i2: iter, i1: none() };

    type FlatMapIterator i1 a i2 = FlattenIterator (MapIterator i1 a i2) i2;

    // Apply a function to each element of an iterator and flatten the result.
    //
    // # Parameters
    //
    // * `f` - The function to be applied to each element of the iterator.
    // * `iter` - The iterator.
    flat_map : [?out : Iterator, Item ?out = b, input : Iterator, Item input = a, inner : Iterator, Item inner = b] (a -> inner) -> input -> ?out;
    flat_map = |f, iter| iter.map(f).flatten;

    type ProductIterator i1 i2 a b = unbox struct { iter1 : i1, iter2 : i2, e2 : Option b, iter1_org : i1 };
    impl [i1 : Iterator, i2 : Iterator, Item i1 = a, Item i2 = b] ProductIterator i1 i2 a b : Iterator {
        type Item (ProductIterator i1 i2 a b) = (Item i1, Item i2);
        advance = |ProductIterator { iter1 : iter1, iter2 : iter2, e2 : e2, iter1_org : iter1_org }| (
            match e2 {
                some(e2) => (
                    match iter1.advance {
                        some((iter1, e1)) => some $ (ProductIterator { iter1: iter1, iter2: iter2, e2: some(e2), iter1_org : iter1_org }, (e1, e2)),
                        none() => match iter2.advance {
                            none() => none(),
                            some((iter2, e2)) => ProductIterator { iter1: iter1_org, iter2: iter2, e2: some(e2), iter1_org : iter1_org }.advance
                        },
                    }
                ),
                none() => (
                    match iter2.advance {
                        none() => none(),
                        some((iter2, e2)) => ProductIterator { iter1: iter1, iter2: iter2, e2: some(e2), iter1_org : iter1_org }.advance
                    }
                ),
            }
        );
    }

    // Create an iterator that yields the Cartesian product of two iterators.
    // 
    // NOTE: Since this function is designed so that `iter1.product(iter2)` yields the Cartesian product, the elements of `product(iter2, iter1)` are in the opposite order.
    // 
    // Example:
    // ```fix
    // assert_eq(|_|"", range(1, 4).product(['a', 'b'].from_array).to_array, [(1, 'a'), (2, 'a'), (3, 'a'), (1, 'b'), (2, 'b'), (3, 'b')])
    // ```
    //
    // # Parameters
    //
    // * `second` - The second iterator.
    // * `first` - The first iterator.
    product : [?out : Iterator, Item ?out = (a, b), input1 : Iterator, input2 : Iterator, Item input1 = a, Item input2 = b] input2 -> input1 -> ?out;
    product = |iter2, iter1| ProductIterator { iter1: iter1, iter2: iter2, e2: none(), iter1_org: iter1 };

    type AppendIterator i1 i2 = unbox struct { iter1 : Option i1, iter2 : i2 };

    impl [i1 : Iterator, i2 : Iterator, Item i1 = a, Item i2 = a] AppendIterator i1 i2 : Iterator {
        type Item (AppendIterator i1 i2) = Item i2;
        advance = |AppendIterator { iter1 : iter1, iter2 : iter2 }| (
            match iter1 {
                none() => (
                    match iter2.advance {
                        none() => none(),
                        some((iter2, a)) => some $ (AppendIterator { iter1: none(), iter2: iter2 }, a)
                    }
                ),
                some(iter1) => (
                    match iter1.advance {
                        none() => AppendIterator { iter1: none(), iter2: iter2 }.advance,
                        some((iter1, a)) => some $ (AppendIterator { iter1: some(iter1), iter2: iter2 }, a)
                    }
                )
            }
        );
    }

    // Append two iterators.
    // 
    // NOTE: Since this function is designed so that `iter1.append(iter2)` appends `iter2` after `iter1`, `append(iter1, iter2)` appends iterators in the opposite order.
    //
    // # Parameters
    //
    // * `second` - The second iterator.
    // * `first` - The first iterator.
    append : [?out : Iterator, Item ?out = a, input1 : Iterator, input2 : Iterator, Item input1 = a, Item input2 = a] input2 -> input1 -> ?out;
    append = |iter2, iter1| AppendIterator { iter1 : some(iter1), iter2 : iter2 };

    type IntersperseIterator i a = unbox struct { iter : i, sep : a, next_is_sep : Bool };

    impl [i : Iterator, Item i = a] IntersperseIterator i a : Iterator {
        type Item (IntersperseIterator i a) = a;
        advance = |IntersperseIterator { iter : iter, sep : sep, next_is_sep : next_is_sep }| (
            if next_is_sep {
                some((IntersperseIterator { iter: iter, sep: sep, next_is_sep: false }, sep))
            } else {
                match iter.advance {
                    none() => none(),
                    some((iter, a)) => some((IntersperseIterator { iter: iter, sep: sep, next_is_sep: !iter.is_empty }, a))
                }
            }
        );
    }

    // Intersperse an element between elements of an iterator.
    //
    // Example:
    // ```fix
    // assert_eq(|_|"", [1, 2, 3].from_array.intersperse(0).to_array, [1, 0, 2, 0, 3])
    // ```
    //
    // # Parameters
    //
    // * `sep` - The element to be interspersed.
    // * `iter` - The iterator.
    intersperse : [?out : Iterator, Item ?out = a, input : Iterator, Item input = a] a -> input -> ?out;
    intersperse = |sep, iter| IntersperseIterator { iter: iter, sep: sep, next_is_sep: false };

    type ConsIterator i a = unbox struct { head : Option a, tail : i };
    impl [i : Iterator, Item i = a] ConsIterator i a : Iterator {
        type Item (ConsIterator i a) = a;
        advance = |ConsIterator { head : head, tail : tail }| (
            match head {
                none() => none(),
                some(v) => match tail.advance {
                    none() => some $ (ConsIterator { head: none(), tail: tail }, v),
                    some((tail, a)) => some $ (ConsIterator { head: some(a), tail: tail }, v)
                }
            }
        );
    }

    // Push an element to the front of an iterator.
    //
    // # Parameters
    //
    // * `head` - The element to be pushed.
    // * `tail` - The iterator to be pushed to.
    push_front : [?out : Iterator, Item ?out = a, input : Iterator, Item input = a] a -> input -> ?out;
    push_front = |head, tail| ConsIterator { head: some(head), tail: tail };

    type ReverseIterator i a = unbox struct { idx : I64, arr : Array a };
    impl [i : Iterator, Item i = a] ReverseIterator i a : Iterator {
        type Item (ReverseIterator i a) = a;
        advance = |ReverseIterator { idx : idx, arr : arr }| (
            if idx == -1 { none() }
            else { some $ (ReverseIterator { idx: idx - 1, arr: arr }, arr.@(idx)) }
        );
    }

    // Reverses an iterator.
    // 
    // NOTE: This function puts all elements of the iterator into an array, so it may consume a lot of memory.
    //
    // # Parameters
    //
    // * `iter` - The iterator to be reversed.
    reverse : [?out : Iterator, Item ?out = a, input : Iterator, Item input = a] input -> ?out;
    reverse = |iter| (
        let arr = iter.to_array;
        let n = arr.@size;
        let result : ReverseIterator input a = ReverseIterator { idx: n - 1, arr: arr };
        result
    );

    type TakeIterator i = unbox struct { iter : i, n : I64 };
    impl [i : Iterator] TakeIterator i : Iterator {
        type Item (TakeIterator i) = Item i;
        advance = |TakeIterator { iter : iter, n : n }| (
            if n <= 0 { none() };
            match iter.advance {
                none() => none(),
                some((iter, a)) => some((TakeIterator { iter: iter, n: n - 1 }, a))
            }
        );
    }

    // Take the first `n` elements of an iterator.
    // 
    // # Parameters
    //
    // * `n` - The number of elements to be taken.
    // * `iter` - The iterator to be taken from.
    take : [?out : Iterator, Item ?out = Item input, input : Iterator] I64 -> input -> ?out;
    take = |n, iter| TakeIterator { iter: iter, n: n };

    type TakeWhileIterator i a = unbox struct { iter : i, pred : a -> Bool };
    impl [i : Iterator, Item i = a] TakeWhileIterator i a : Iterator {
        type Item (TakeWhileIterator i a) = a;
        advance = |TakeWhileIterator { iter : iter, pred : pred }| (
            match iter.advance {
                none() => none(),
                some((iter, a)) => if pred(a) { 
                    some((TakeWhileIterator { iter: iter, pred: pred }, a))
                } else {
                    none()
                }
            }
        );
    }

    // Take elements from an iterator while a predicate holds.
    //
    // # Parameters
    //
    // * `predicate` - The predicate function to be applied to each element of the iterator.
    // * `iter` - The iterator to be taken from.
    take_while : [?out : Iterator, Item ?out = a, input : Iterator, Item input = a] (a -> Bool) -> input -> ?out;
    take_while = |pred, iter| TakeWhileIterator { iter: iter, pred: pred };

    type ZipIterator i1 i2 = unbox struct { iter1 : i1, iter2 : i2 };
    impl [i1 : Iterator, i2 : Iterator] ZipIterator i1 i2 : Iterator {
        type Item (ZipIterator i1 i2) = (Item i1, Item i2);
        advance = |ZipIterator { iter1 : iter1, iter2 : iter2 }| (
            match iter1.advance {
                none() => none(),
                some((iter1, a)) => match iter2.advance {
                    none() => none(),
                    some((iter2, b)) => some((ZipIterator { iter1: iter1, iter2: iter2 }, (a, b)))
                }
            }
        );
    }

    // Zip two iterators.
    // 
    // NOTE: Since this function is designed so that `iter1.zip(iter2)` zips `iter1` and `iter2`, the elements of `zip(iter2, iter1)` are in the opposite order.
    //
    // # Parameters
    //
    // * `second` - The second iterator.
    // * `first` - The first iterator.
    zip : [?out : Iterator, Item ?out = (Item input1, Item input2), input1 : Iterator, input2 : Iterator] input2 -> input1 -> ?out;
    zip = |iter2, iter1| ZipIterator { iter1: iter1, iter2: iter2 };

    type EnumerateIterator it = unbox struct { it : it, index : I64 };
    impl [it : Iterator] EnumerateIterator it : Iterator {
        type Item (EnumerateIterator it) = (I64, Item it);
        advance = |EnumerateIterator { it : it, index : idx }| (
            match it.advance {
                none() => none(),
                some((it, a)) => some $ (EnumerateIterator { it: it, index: idx + 1 }, (idx, a))
            }
        );
    }
    
    // Creates an iterator that yields elements along with their index.
    // 
    // # Parameters
    // * `iter` - The iterator to be enumerated.
    enumerate : [?out : Iterator, Item ?out = (I64, Item input), input : Iterator] input -> ?out;
    enumerate = |iter| EnumerateIterator { it: iter, index: 0 };

    // Check if all elements of an iterator satisfy a given predicate.
    // 
    // # Parameters
    //
    // * `pred` - The predicate function to be applied to each element of the iterator.
    // * `iter` - The iterator to be checked.
    check_all : [it : Iterator, Item it = a] (a -> Bool) -> it -> Bool;
    check_all = |pred, iter| (
        match iter.advance {
            none() => true,
            some((iter, a)) => if pred(a) { iter.check_all(pred) } else { false }
        }
    );

    // Check if any element of an iterator satisfies a given predicate.
    // 
    // # Parameters
    // 
    // * `pred` - The predicate function to be applied to each element of the iterator.
    // * `iter` - The iterator to be checked.
    check_any : [it : Iterator, Item it = a] (a -> Bool) -> it -> Bool;
    check_any = |pred, iter| (
        match iter.advance {
            none() => false,
            some((iter, a)) => if pred(a) { true } else { iter.check_any(pred) }
        }
    );

    /*
        Dynamic iterator.
    */

    // The type of dynamic iterators.
    // 
    // `DynIterator` has a field, `next`, which is a function that returns the next element and the next iterator.
    // Therefore, the process to advance `DynIterator` can be determined dynamically at runtime, not at compile time.
    // 
    // The main advantage of dynamic iterator is that since it has a simple type, `DynIterator a`,
    // - `DynIterator` can be instances of traits such as `Monad`, `Eq`, etc.
    // - it is possible to return two dynamic iterators with different constructions depending on the branch.
    // 
    // However, iterating over `DynIterator` are much slower than iterating over other iterators provided in this namespace.
    // Therefore, if performance is important, you should avoid using `DynIterator`.
    // In particular, if you iterate over the same `DynIterator` multiple times,
    // consider converting it to an `ArrayIterator` using `bang` before iterating.
    type DynIterator a = unbox struct { next: () -> Option (DynIterator a, a) };

    // Convert an iterator into a dynamic iterator.
    //
    // # Parameters
    //
    // * `iter` - The iterator to be converted.
    to_dyn : [iter : Iterator, Item iter = a] iter -> DynIterator a;
    to_dyn = |iter| DynIterator { next: |_| iter.advance.map(|(iter, elm)| (iter.to_dyn, elm)) };

    impl DynIterator a : Iterator {
        type Item (DynIterator a) = a;
        advance = |iter| (iter.@next)();
    }

    namespace DynIterator {
        // Creates an empty dynamic iterator.
        empty : DynIterator a;
        empty = DynIterator { next: |_| none() };

        // Creates an empty dynamic iterator.
        impl DynIterator a : Zero {
            zero = DynIterator::empty;
        }

        // Concatenates two dynamic iterators.
        impl DynIterator a : Add {
            add = |lhs, rhs| lhs.append(rhs).to_dyn;
        }

        impl [a : Eq] DynIterator a : Eq {
            eq = |lhs, rhs| lhs.is_equal(rhs);
        }

        impl DynIterator : Functor {
            map = |f, iter| iter.Iterator::map(f).to_dyn;
        }

        impl DynIterator : Monad {
            pure = |e| Iterator::empty.push_front(e).to_dyn;
            bind = |f, xs| xs.Iterator::map(f).flatten.to_dyn;
        }
    }
}

// The type of lazily generated values.
//
// You can create a lazy value by `|_| (...an expression to generate the value...)`, 
// and you can evaluate a lazy value `v` by `v()`.
type Lazy a = () -> a;

namespace LoopState {
    // Make a break value wrapped in a monad.
    // 
    // This is used with `loop_m` function.
    break_m : [m : Monad] r -> m (LoopState s r);
    break_m = break >> pure;

    // Make a continue value wrapped in a monad.
    // 
    // This is used with `loop_m` function.
    continue_m : [m : Monad] s -> m (LoopState s r);
    continue_m = continue >> pure;

}

type Option a = union { none: (), some: a };

namespace Option {

    // Unwrap an option value if it is `some`, or returns given default value if it is `none`.
    //
    // # Parameters
    //
    // * `default` - The default value to be returned if the option is `none`.
    // * `opt` - The option value to be unwrapped.
    as_some_or : a -> Option a -> a;
    as_some_or = |def, opt| (
        if opt.is_none { def } else { opt.as_some }
    );

    // Returns the provided default value if the option is none, or applies a function to the contained value if the option is some.
    //
    // # Parameters
    //
    // * `default` - The default value to be returned if the option is `none`.
    // * `f` - The function to be applied to the contained value if the option is `some`.
    map_or : b -> (a -> b) -> Option a -> b;
    map_or = |def, f, opt| if opt.is_some { f(opt.as_some) } else { def };

    // Converts an option into an iterator.
    to_iter : [?it : Iterator, Item ?it = a] Option a -> ?it;
    to_iter = |opt| OptionIterator { opt: opt };

    type OptionIterator opt = unbox struct { opt : opt };
    impl OptionIterator (Option a) : Iterator {
        type Item (OptionIterator (Option a)) = a;
        advance = |OptionIterator { opt : opt }| (
            match opt {
                none() => none(),
                some(a) => some((OptionIterator { opt: none() }, a))
            }
        );
    }
}

impl [a : Eq] Option a : Eq {
    eq = |lhs, rhs| (
        if lhs.is_some && rhs.is_some { lhs.as_some == rhs.as_some };
        lhs.is_none && rhs.is_none
    );
}

impl [a : ToString] Option a : ToString {
    to_string = |opt| if opt.is_some { "some(" + opt.as_some.to_string + ")" } else { "none()" };
}

impl Option : Functor {
    map = |f, opt| (
        if opt.is_none {
            Option::none()
        } else {
            Option::some $ f $ opt.as_some
        }
    );
}

impl Option : Monad {
    pure = Option::some;
    bind = |f, opt| match opt {
        none() => none(),
        some(a) => f(a)
    };
}

// The type for file path.
type Path = String;

// The type of punched arrays: an array with one element moved out. Used internally by `Array::act`.
type PunchedArray a = unbox struct { _arr : Array a, _idx : I64 };

// A type of result value for a computation that may fail.
type Result e o = unbox union { ok : o, err: e };

namespace Result {

    // Returns the containing value if the value is ok, or otherwise aborts the program.
    //
    // # Parameters
    //
    // * `res` - The result value to be unwrapped.
    unwrap : Result e o -> o;
    unwrap = |res| (
        if res.is_err {
            undefined("[Std::Result::unwrap] Try to unwrap an error value.")
        } else {
            res.as_ok
        }
    );
}

impl [e : Eq, a : Eq] Result e a : Eq {
    eq = |lhs, rhs| (
        if lhs.is_ok && rhs.is_ok { lhs.as_ok == rhs.as_ok };
        if lhs.is_err && rhs.is_err { lhs.as_err == rhs.as_err };
        false
    );
}

impl Result e : Functor {
    map = |f, res| (
        if res.is_err {
            Result::err $ res.as_err
        } else {
            Result::ok $ f $ res.as_ok
        }
    );
}

impl Result e : Monad {
    pure = Result::ok;
    bind = |f, res| match res {
        err(e) => err(e),
        ok(a) => f(a)
    };
}

impl [e : ToString, a : ToString] Result e a : ToString {
    to_string = |res| if res.is_ok { "ok(" + res.as_ok.to_string + ")" } else { "err(" + res.as_err.to_string + ")" };
}

// The string type. 
// 
// A string is represented as a null-terminated byte array.
type String = unbox struct { _data : Array U8 };

namespace String {

    // Get the null-terminated C string.
    // 
    // NOTE: 
    // This function is dangerous because it returns a dangling pointer if `_get_c_str` is the last use of `s`.
    // To avoid this problem, you should use `borrow_c_str` or `borrow_c_str_io` instead.
    _get_c_str : String -> Ptr;
    _get_c_str = |s| s.@_data.borrow_elements(|ptr| ptr);
    DEPRECATED[_get_c_str, "This function returns a dangling pointer if it is the last use of the string. Use `borrow_c_str` or `borrow_c_str_io` instead."];

    // Create a `String` from a byte array holding a text with a null after it.
    //
    // If the byte array doesn't include `\0`, this function causes undefined behavior.
    //
    // The byte array must be unshared: this function updates its length in place.
    _unsafe_from_c_str : Array U8 -> String;
    _unsafe_from_c_str = |buf| (
        let len = buf.borrow_elements(|ptr| FFI_CALL[CSizeT strlen(Ptr), ptr].i64);
        buf._unsafe_from_c_str_with_len(len)
    );

    // Create a `String` from a byte array holding a text of a known length, with a null after it.
    //
    // If the byte array holds fewer than `length + 1` bytes, or holds something other than `\0` at
    // `length`, this function causes undefined behavior.
    //
    // The byte array must be unshared: this function updates its length in place.
    //
    // # Parameters
    // * `length` - How many bytes the text holds, the null left out.
    _unsafe_from_c_str_with_len : I64 -> Array U8 -> String;
    _unsafe_from_c_str_with_len = |length, buf| String { _data : buf._unsafe_grow_size(length + 1) };

    // Create a `String` from a pointer to a null-terminated C string.
    //
    // If the pointer is not pointing to a valid null-terminated C string, this function causes undefined behavior.
    //
    // If you have an `Array U8` containing a null-terminated C string, use `FromBytes::from_bytes` instead.
    //
    // There is also an IO version of this function, `unsafe_from_c_str_ptr_io`.
    //
    // Since this function is not an `IO` action, the compiler does not guarantee the order of execution between this function and `IO` actions.
    // Do not use this function if you perform `IO` operations that modify the content pointed to by `ptr` or free `ptr`.
    //
    // For example,
    // ```fix ignore
    // let str = unsafe_from_c_str_ptr(ptr);
    // FFI_CALL_IO[() free(Ptr), ptr];;
    // ```
    // may be rewritten to:
    // ```fix ignore
    // FFI_CALL_IO[() free(Ptr), ptr];;
    // let str = unsafe_from_c_str_ptr(ptr);
    // ```
    // which can cause undefined behavior.
    //
    // # Parameters
    //
    // * `ptr` - The pointer to a null-terminated C string.
    unsafe_from_c_str_ptr : Ptr -> String;
    unsafe_from_c_str_ptr = |ptr| (
        let len = FFI_CALL[CSizeT strlen(Ptr), ptr].i64;
        let buf_len = len + 1;
        let buf = Array::empty(buf_len)._unsafe_grow_size(buf_len);
        let (buf, _) = buf.mutate_elements(|buf_ptr| FFI_CALL_IO[Ptr memcpy(Ptr, Ptr, CSizeT), buf_ptr, ptr, buf_len.c_size_t]);
        String { _data : buf }
    );

    _unsafe_from_c_str_ptr : Ptr -> String;
    _unsafe_from_c_str_ptr = unsafe_from_c_str_ptr;
    DEPRECATED[_unsafe_from_c_str_ptr, "Use `Std::String::unsafe_from_c_str_ptr` instead."];

    // Reads the whole of `str` as a decimal integer, and answers with its sign and its magnitude:
    // `(true, 5)` for `-5`. The text is an optional `+` or `-` followed by one or more decimal digits.
    //
    // # Parameters
    // * `positive_limit` - The greatest magnitude a text without `-` may name.
    // * `negative_limit` - The greatest magnitude a text with `-` may name.
    // * `str` - The text to read.
    _read_decimal_integer : U64 -> U64 -> String -> Result ErrMsg (Bool, U64);
    _read_decimal_integer = |positive_limit, negative_limit, str| (
        // The null after the text is not a digit, so it stops each loop below at the text's end.
        let bytes = str.@_data;
        let first = bytes.@(0);
        let negative = first == '-';
        let start = if negative || first == '+' { 1 } else { 0 };
        let limit = if negative { negative_limit } else { positive_limit };
        let limit_tens = limit / 10_U64;
        let limit_ones = limit % 10_U64;
        // The index of the first byte after the digits, and the magnitude they name, or none where
        // it exceeds `limit`.
        let (end, magnitude) = loop((start, 0_U64), |(i, magnitude)| (
            let digit = bytes.@(i) - '0';
            if digit >= 10_U8 { break $ (i, Option::some(magnitude)) };
            let digit = digit.u64;
            if magnitude > limit_tens || (magnitude == limit_tens && digit > limit_ones) {
                break $ (bytes._skip_decimal_digits(i), Option::none())
            };
            continue $ (i + 1, magnitude * 10_U64 + digit)
        ));
        if end == start || end != str.get_size {
            Result::err("Failed to convert string to integer (invalid format): " + str)
        };
        if magnitude.is_none {
            Result::err("Failed to convert string to integer (out of range): " + str)
        };
        Result::ok((negative, magnitude.as_some))
    );

    // Reads the whole of `str` as a decimal integer from `-max - 1` to `max`, the way
    // `_read_decimal_integer` reads one.
    //
    // # Parameters
    // * `max` - The greatest number the text may name.
    // * `str` - The text to read.
    _read_signed_decimal_integer : I64 -> String -> Result ErrMsg I64;
    _read_signed_decimal_integer = |max, str| (
        str._read_decimal_integer(max.u64, max.u64 + 1_U64).map(|(negative, magnitude)| (
            I64::_from_sign_and_magnitude(negative, magnitude)
        ))
    );

    // Reads the whole of `str` as a decimal integer from 0 to `max`, the way
    // `_read_decimal_integer` reads one. `-0` is read as 0.
    //
    // # Parameters
    // * `max` - The greatest number the text may name.
    // * `str` - The text to read.
    _read_unsigned_decimal_integer : U64 -> String -> Result ErrMsg U64;
    _read_unsigned_decimal_integer = |max, str| str._read_decimal_integer(max, 0_U64).map(|(_, magnitude)| magnitude);

    // Reads the whole of `str` as a decimal integer the way `_read_decimal_integer` reads one, with
    // magnitudes up to those of the 128-bit integers.
    //
    // # Parameters
    // * `positive_limit` - The greatest magnitude a text without `-` may name.
    // * `negative_limit` - The greatest magnitude a text with `-` may name.
    // * `str` - The text to read.
    _read_decimal_integer_128 : U128 -> U128 -> String -> Result ErrMsg (Bool, U128);
    _read_decimal_integer_128 = |positive_limit, negative_limit, str| (
        // The null after the text is not a digit, so it stops each loop below at the text's end.
        let bytes = str.@_data;
        let first = bytes.@(0);
        let negative = first == '-';
        let start = if negative || first == '+' { 1 } else { 0 };
        let limit = if negative { negative_limit } else { positive_limit };
        let limit_tens = limit / 10_U128;
        let limit_ones = limit % 10_U128;
        // The index of the first byte after the digits, and the magnitude they name, or none where
        // it exceeds `limit`.
        let (end, magnitude) = loop((start, 0_U128), |(i, magnitude)| (
            let digit = bytes.@(i) - '0';
            if digit >= 10_U8 { break $ (i, Option::some(magnitude)) };
            let digit = digit.u128;
            if magnitude > limit_tens || (magnitude == limit_tens && digit > limit_ones) {
                break $ (bytes._skip_decimal_digits(i), Option::none())
            };
            continue $ (i + 1, magnitude * 10_U128 + digit)
        ));
        if end == start || end != str.get_size {
            Result::err("Failed to convert string to integer (invalid format): " + str)
        };
        if magnitude.is_none {
            Result::err("Failed to convert string to integer (out of range): " + str)
        };
        Result::ok((negative, magnitude.as_some))
    );

    // Writes the bytes of `text` into `bytes` from `at`, and answers with the index after them and
    // the array.
    //
    // `bytes` must be unshared and hold at least `at + text.get_size` bytes. This function does not
    // check it, and violating it causes undefined behavior.
    //
    // # Parameters
    // * `at` - The index of the first byte.
    // * `text` - The text to write.
    // * `bytes` - The array to write into.
    _write_text_at : I64 -> String -> Array U8 -> (I64, Array U8);
    _write_text_at = |at, text, bytes| (
        let size = text.get_size;
        (at + size, bytes._unsafe_copy_range_bounds_unchecked(text.@_data, 0, size, at))
    );

    // The text `to_string` writes for an infinity, a NaN or a zero: `inf`, `-inf`, `nan`, `0.0` or
    // `-0.0`. A NaN is `nan` whatever its sign.
    //
    // # Parameters
    // * `is_zero` - Whether the number is a zero, where it is not an infinity or a NaN.
    // * `is_nan` - Whether the number is a NaN.
    // * `negative` - Whether the sign of the number is negative.
    _special_float_text : Bool -> Bool -> Bool -> String;
    _special_float_text = |is_zero, is_nan, negative| (
        if is_zero { if negative { "-0.0" } else { "0.0" } };
        if is_nan { "nan" };
        if negative { "-inf" } else { "inf" }
    );

    // Writes `_special_float_text(is_zero, is_nan, negative)` into `bytes` from `at`, and answers
    // with the index after it and the array.
    //
    // `bytes` must be unshared and hold at least `at + 4` bytes. This function does not check it,
    // and violating it causes undefined behavior.
    //
    // # Parameters
    // * `at` - The index of the first byte.
    // * `is_zero` - Whether the number is a zero, where it is not an infinity or a NaN.
    // * `is_nan` - Whether the number is a NaN.
    // * `negative` - Whether the sign of the number is negative.
    // * `bytes` - The array to write into.
    _write_special_float : I64 -> Bool -> Bool -> Bool -> Array U8 -> (I64, Array U8);
    _write_special_float = |at, is_zero, is_nan, negative, bytes| (
        bytes._write_text_at(at, _special_float_text(is_zero, is_nan, negative))
    );

    // Writes `e` and the power of ten `power` into `bytes` from `at`, as a floating point literal of
    // Fix writes them: `e300`, `e-5`, `e0`. Answers with the index after them and the array.
    //
    // `bytes` must be unshared and hold the text from `at`. This function does not check it, and
    // violating it causes undefined behavior.
    //
    // # Parameters
    // * `at` - The index of the `e`.
    // * `power` - The power of ten.
    // * `bytes` - The array to write into.
    _write_power_of_ten : I64 -> I64 -> Array U8 -> (I64, Array U8);
    _write_power_of_ten = |at, power, bytes| (
        let bytes = bytes.unsafe_set_bounds_unchecked(at, 'e');
        let end = at + 1 + _decimal_integer_length(power < 0, power.abs.u64);
        (end, bytes._write_decimal_integer(end, power < 0, power.abs.u64))
    );

    // Stops the program where `bytes` holds fewer than `at + max_length` bytes, naming the sizes.
    // A function writing the text of a number calls this with the most bytes it writes, so that a
    // buffer sized short of its text stops the program before the text is written past it.
    //
    // # Parameters
    // * `at` - The index the text starts at.
    // * `max_length` - The most bytes the text takes.
    // * `bytes` - The array the text is written into.
    _check_text_fits : I64 -> I64 -> Array U8 -> Array U8;
    _check_text_fits = |at, max_length, bytes| (
        if at + max_length <= bytes.@size { bytes };
        _stop_on_text_past_buffer(at, max_length, bytes.@size)
    );

    // Stops the program, naming the sizes `_check_text_fits` found short.
    //
    // # Parameters
    // * `at` - The index the text starts at.
    // * `max_length` - The most bytes the text takes.
    // * `size` - The bytes the array holds.
    _stop_on_text_past_buffer : I64 -> I64 -> I64 -> Array U8;
    _stop_on_text_past_buffer = |at, max_length, size| (
        undefined("A number's text takes up to " + max_length.to_string + " bytes from index " + at.to_string
            + ", and its buffer holds " + size.to_string + " bytes.")
    );

    // Writes the text of a finite number other than zero from its shortest decimal digits into
    // `bytes` from `at`, the way `to_string` writes it, and answers with the index after it and the
    // array.
    //
    // The digits are written positionally where the point falls inside or near them, and with a
    // power of ten otherwise, so that the text stays about as wide as the digits it carries:
    // `1e300` is written `1.0e300`. Either way the text has a point and a digit on each side of it.
    //
    // `bytes` must be unshared and hold the text from `at`. This function does not check it, and
    // violating it causes undefined behavior.
    //
    // # Examples
    // With the window of an `F64`, a mantissa of 1234 with 4 digits is written `12.34` at the
    // exponent -2, `123400.0` at 2, `0.00001234` at -8, and `1.234e300` at 297.
    //
    // # Parameters
    // * `at` - The index of the first byte.
    // * `positional_low`, `positional_high` - The window the point is written positionally in:
    //   `positional_low < point <= positional_high`, where `point - 1` is the power of ten the first
    //   digit carries. A wider window costs zeros, so it is drawn around the digits the type
    //   carries.
    // * `negative` - Whether the number is below zero.
    // * `(mantissa, exponent, digit_count)` - The number's magnitude, `mantissa * 10 ^ exponent`,
    //   where `mantissa` has `digit_count` digits.
    // * `bytes` - The array to write into.
    _write_float_decimal : I64 -> I64 -> I64 -> Bool -> (U64, I64, I64) -> Array U8 -> (I64, Array U8);
    _write_float_decimal = |at, positional_low, positional_high, negative, (mantissa, exponent, digit_count), bytes| (
        // Where the point falls among the digits: the first digit carries `10 ^ (point - 1)`.
        let point = exponent + digit_count;
        let positional = point > positional_low && point <= positional_high;
        // The power of ten written after the digits when the text is not positional.
        let power = point - 1;
        // Where the magnitude starts, after the sign.
        let start = if negative { at + 1 } else { at };
        let bytes = if negative { bytes.unsafe_set_bounds_unchecked(at, '-') } else { bytes };
        if !positional {
            // 1234e30 -> 1.234e33, and 1e30 -> 1.0e30.
            let bytes = bytes._write_decimal_with_point(start, digit_count, mantissa);
            let after_digits = start + digit_count + 1;
            let (after_digits, bytes) = if digit_count == 1 { (after_digits + 1, bytes.unsafe_set_bounds_unchecked(after_digits, '0')) } else { (after_digits, bytes) };
            bytes._write_power_of_ten(after_digits, power)
        };
        if point >= digit_count {
            // 1234e3 -> 1234000.0
            let bytes = bytes._write_decimal_integer(start + digit_count, false, mantissa);
            let bytes = bytes._fill_bytes(start + digit_count, point - digit_count, '0');
            let bytes = bytes.unsafe_set_bounds_unchecked(start + point, '.');
            (start + point + 2, bytes.unsafe_set_bounds_unchecked(start + point + 1, '0'))
        };
        if point > 0 {
            // 1234e-2 -> 12.34. The digits are written one place to the right, and those before the
            // point are moved back in front of it.
            let bytes = bytes._write_decimal_integer(start + 1 + digit_count, false, mantissa);
            let bytes = loop((start, bytes), |(i, bytes)| (
                if i >= start + point { break $ bytes };
                continue $ (i + 1, bytes.unsafe_set_bounds_unchecked(i, bytes._unsafe_get_bounds_unchecked(i + 1)))
            ));
            (start + digit_count + 1, bytes.unsafe_set_bounds_unchecked(start + point, '.'))
        };
        // 1234e-6 -> 0.001234
        let bytes = bytes.unsafe_set_bounds_unchecked(start, '0');
        let bytes = bytes.unsafe_set_bounds_unchecked(start + 1, '.');
        let bytes = bytes._fill_bytes(start + 2, -point, '0');
        let end = start + 2 - point + digit_count;
        (end, bytes._write_decimal_integer(end, false, mantissa))
    );

    // Writes the `count` decimal digits of `value` into `bytes` from `at`, with a point after the
    // first digit: 1234 is written `1.234`, and 7 is written `7.`. The text takes `count + 1`
    // bytes.
    //
    // `bytes` must be unshared and hold at least `at + count + 1` bytes, and `value` must have
    // `count` digits. This function checks neither, and violating them causes undefined behavior.
    //
    // # Parameters
    // * `at` - The index of the first digit.
    // * `count` - The number of digits of `value`.
    // * `value` - The number to write.
    // * `bytes` - The array to write into.
    _write_decimal_with_point : I64 -> I64 -> U64 -> Array U8 -> Array U8;
    _write_decimal_with_point = |at, count, value, bytes| (
        // The digits are written one place to the right, and the first of them is moved in front
        // of the point.
        let bytes = bytes._write_decimal_integer(at + 1 + count, false, value);
        let bytes = bytes.unsafe_set_bounds_unchecked(at, bytes._unsafe_get_bounds_unchecked(at + 1));
        bytes.unsafe_set_bounds_unchecked(at + 1, '.')
    );

    // Sets the `count` bytes of `bytes` from `from` to `byte`.
    //
    // `bytes` must be unshared and hold at least `from + count` bytes. This function does not check
    // it, and violating it causes undefined behavior.
    //
    // # Parameters
    // * `from` - The index of the first byte to set.
    // * `count` - The number of bytes to set.
    // * `byte` - The value to set them to.
    // * `bytes` - The array to write into.
    _fill_bytes : I64 -> I64 -> U8 -> Array U8 -> Array U8;
    _fill_bytes = |from, count, byte, bytes| loop((from, bytes), |(i, bytes)| (
        if i >= from + count { break $ bytes };
        continue $ (i + 1, bytes.unsafe_set_bounds_unchecked(i, byte))
    ));

    // Adds one to the last digit of the decimal text written in `bytes` from `start` to `end`,
    // carrying into the digits before it, and answers whether the carry ran past the first digit.
    //
    // A carry past the first digit turns the digits into a `1` followed by zeros: `-99.9` becomes
    // `-10.0` with the point left where it was, and the caller moves the point or the power of ten.
    // With `round_up` 2, nothing is added where the last digit is even.
    //
    // # Parameters
    // * `start` - The index of the first byte of the text.
    // * `end` - The index just after the last digit.
    // * `round_up` - 1 to add one, 2 to add one only where the last digit is odd.
    // * `bytes` - The text, which is an optional `-`, then digits with at most one `.` among them.
    _round_up_decimal_text : I64 -> I64 -> I64 -> Array U8 -> (Bool, Array U8);
    _round_up_decimal_text = |start, end, round_up, bytes| loop((end - 1, round_up, bytes), |(i, round_up, bytes)| (
        let c = if i < start { '-' } else { bytes._unsafe_get_bounds_unchecked(i) };
        if c == '-' { break $ (true, bytes.unsafe_set_bounds_unchecked(i + 1, '1')) };
        if c == '.' { continue $ (i - 1, round_up, bytes) };
        if c == '9' { continue $ (i - 1, 1, bytes.unsafe_set_bounds_unchecked(i, '0')) };
        if round_up == 2 && c % 2_U8 == 0_U8 { break $ (false, bytes) };
        break $ (false, bytes.unsafe_set_bounds_unchecked(i, c + 1_U8))
    ));

    // Creates a string from the first `length` bytes written into `bytes`.
    //
    // `bytes` must be unshared and hold more than `length` bytes, which the null after the text
    // takes. This function does not check it, and violating it causes undefined behavior.
    //
    // # Parameters
    // * `(length, bytes)` - The length of the text and the array it is written in.
    _from_written_bytes : (I64, Array U8) -> String;
    _from_written_bytes = |(length, bytes)| (
        let bytes = bytes.unsafe_set_bounds_unchecked(length, 0_U8);
        String { _data : bytes._unsafe_truncate_bounds_unchecked(length + 1) }
    );

    // Turns what the reader in `float_text.c` answered for `str` into the result of `from_string`.
    // The literals below must stay in sync with the `FLOAT_TEXT_*` values there.
    //
    // # Parameters
    // * `outcome` - The `FLOAT_TEXT_*` value the reader recorded.
    // * `v` - The number the reader answered with.
    // * `str` - The text the reader read.
    _float_text_result : U8 -> a -> String -> Result ErrMsg a;
    _float_text_result = |outcome, v, str| (
        if outcome == 0_U8 { Result::ok(v) };
        if outcome == 1_U8 { Result::err("Failed to convert string to number (invalid format): " + str) };
        if outcome == 2_U8 { Result::err("Failed to convert string to number (out of range): " + str) };
        undefined("[Std::String::_float_text_result] The reader recorded an outcome it does not define: " + outcome.to_string)
    );

    // Answers with the index of the first byte at or after `i` that is not a decimal digit.
    //
    // # Parameters
    // * `i` - The index to start at.
    // * `bytes` - The bytes to scan, which must hold a byte other than a digit after the digits, as
    //   the null at the end of a `String`'s data is.
    _skip_decimal_digits : I64 -> Array U8 -> I64;
    _skip_decimal_digits = |i, bytes| loop(i, |i| (
        if bytes.@(i) - '0' < 10_U8 { continue $ i + 1 };
        break $ i
    ));

    // Counts the bytes `_write_decimal_integer` writes for the integer whose sign is
    // `negative` and whose magnitude is `magnitude`: the digits, and the `-` where `negative` is
    // true.
    //
    // # Parameters
    // * `negative` - Whether the integer is below zero.
    // * `magnitude` - The absolute value of the integer.
    _decimal_integer_length : Bool -> U64 -> I64;
    _decimal_integer_length = |negative, magnitude| (
        let sign_length = if negative { 1 } else { 0 };
        // Four digits are counted at each step, so that most integers take one step.
        let digit_count = loop((1, magnitude), |(count, rest)| (
            if rest < 10_U64 { break $ count };
            if rest < 100_U64 { break $ count + 1 };
            if rest < 1000_U64 { break $ count + 2 };
            if rest < 10000_U64 { break $ count + 3 };
            continue $ (count + 4, rest / 10000_U64)
        ));
        sign_length + digit_count
    );

    // Writes the integer whose sign is `negative` and whose magnitude is `magnitude` into `bytes` in
    // decimal, so that its text ends just before `end`: `-` where `negative` is true, then the
    // digits. The text starts at `end - _decimal_integer_length(negative, magnitude)`.
    //
    // `bytes` must be unshared and hold at least `end` bytes, and `end` must leave room for the whole
    // text before it. This function checks neither, and violating them causes undefined behavior.
    //
    // # Parameters
    // * `end` - The index just after the last digit.
    // * `negative` - Whether the integer is below zero.
    // * `magnitude` - The absolute value of the integer.
    // * `bytes` - The array to write into.
    _write_decimal_integer : I64 -> Bool -> U64 -> Array U8 -> Array U8;
    _write_decimal_integer = |end, negative, magnitude, bytes| (
        // The digits are written from the last one backward, two at each step.
        let (end, rest, bytes) = loop((end, magnitude, bytes), |(end, rest, bytes)| (
            if rest < 100_U64 { break $ (end, rest, bytes) };
            let higher = rest / 100_U64;
            let bytes = bytes._write_decimal_digit_pair(end - 2, rest - higher * 100_U64);
            continue $ (end - 2, higher, bytes)
        ));
        let (start, bytes) = if rest < 10_U64 {
            (end - 1, bytes.unsafe_set_bounds_unchecked(end - 1, '0' + rest.u8))
        } else {
            (end - 2, bytes._write_decimal_digit_pair(end - 2, rest))
        };
        if negative { bytes.unsafe_set_bounds_unchecked(start - 1, '-') };
        bytes
    );

    // Writes the two decimal digits of `pair` into `bytes` at `at` and `at + 1`, with a leading
    // zero where `pair` is below 10.
    //
    // `bytes` must be unshared and hold at least `at + 2` bytes, and `pair` must be below 100. This
    // function checks neither, and violating them causes undefined behavior.
    //
    // # Parameters
    // * `at` - The index of the first digit.
    // * `pair` - The number to write.
    // * `bytes` - The array to write into.
    _write_decimal_digit_pair : I64 -> U64 -> Array U8 -> Array U8;
    _write_decimal_digit_pair = |at, pair, bytes| (
        let from = pair.i64 * 2;
        let bytes = bytes.unsafe_set_bounds_unchecked(at, _decimal_digit_pairs._unsafe_get_bounds_unchecked(from));
        bytes.unsafe_set_bounds_unchecked(at + 1, _decimal_digit_pairs._unsafe_get_bounds_unchecked(from + 1))
    );

    // The two decimal digits of each number from 0 to 99, in order: `0` is `00` at index 0, and `n`
    // is at index `2 * n`. The digits are written as numbers, which makes the array a constant of
    // the program.
    _decimal_digit_pairs : Array U8;
    _decimal_digit_pairs = [
        48_U8, 48_U8, 48_U8, 49_U8, 48_U8, 50_U8, 48_U8, 51_U8, 48_U8, 52_U8, 48_U8, 53_U8, 48_U8, 54_U8, 48_U8, 55_U8, 48_U8, 56_U8, 48_U8, 57_U8,
        49_U8, 48_U8, 49_U8, 49_U8, 49_U8, 50_U8, 49_U8, 51_U8, 49_U8, 52_U8, 49_U8, 53_U8, 49_U8, 54_U8, 49_U8, 55_U8, 49_U8, 56_U8, 49_U8, 57_U8,
        50_U8, 48_U8, 50_U8, 49_U8, 50_U8, 50_U8, 50_U8, 51_U8, 50_U8, 52_U8, 50_U8, 53_U8, 50_U8, 54_U8, 50_U8, 55_U8, 50_U8, 56_U8, 50_U8, 57_U8,
        51_U8, 48_U8, 51_U8, 49_U8, 51_U8, 50_U8, 51_U8, 51_U8, 51_U8, 52_U8, 51_U8, 53_U8, 51_U8, 54_U8, 51_U8, 55_U8, 51_U8, 56_U8, 51_U8, 57_U8,
        52_U8, 48_U8, 52_U8, 49_U8, 52_U8, 50_U8, 52_U8, 51_U8, 52_U8, 52_U8, 52_U8, 53_U8, 52_U8, 54_U8, 52_U8, 55_U8, 52_U8, 56_U8, 52_U8, 57_U8,
        53_U8, 48_U8, 53_U8, 49_U8, 53_U8, 50_U8, 53_U8, 51_U8, 53_U8, 52_U8, 53_U8, 53_U8, 53_U8, 54_U8, 53_U8, 55_U8, 53_U8, 56_U8, 53_U8, 57_U8,
        54_U8, 48_U8, 54_U8, 49_U8, 54_U8, 50_U8, 54_U8, 51_U8, 54_U8, 52_U8, 54_U8, 53_U8, 54_U8, 54_U8, 54_U8, 55_U8, 54_U8, 56_U8, 54_U8, 57_U8,
        55_U8, 48_U8, 55_U8, 49_U8, 55_U8, 50_U8, 55_U8, 51_U8, 55_U8, 52_U8, 55_U8, 53_U8, 55_U8, 54_U8, 55_U8, 55_U8, 55_U8, 56_U8, 55_U8, 57_U8,
        56_U8, 48_U8, 56_U8, 49_U8, 56_U8, 50_U8, 56_U8, 51_U8, 56_U8, 52_U8, 56_U8, 53_U8, 56_U8, 54_U8, 56_U8, 55_U8, 56_U8, 56_U8, 56_U8, 57_U8,
        57_U8, 48_U8, 57_U8, 49_U8, 57_U8, 50_U8, 57_U8, 51_U8, 57_U8, 52_U8, 57_U8, 53_U8, 57_U8, 54_U8, 57_U8, 55_U8, 57_U8, 56_U8, 57_U8, 57_U8
    ];

    // Creates the decimal text of the integer whose sign is `negative` and whose magnitude is
    // `magnitude`: `-` where `negative` is true, then the digits.
    //
    // # Parameters
    // * `negative` - Whether the integer is below zero.
    // * `magnitude` - The absolute value of the integer.
    _from_decimal_integer : Bool -> U64 -> String;
    _from_decimal_integer = |negative, magnitude| (
        let length = _decimal_integer_length(negative, magnitude);
        let bytes = Array::empty(length + 1)._unsafe_grow_size(length + 1);
        let bytes = bytes._write_decimal_integer(length, negative, magnitude);
        String { _data : bytes.unsafe_set_bounds_unchecked(length, 0_U8) }
    );

    // The number of decimal digits `_from_decimal_integer_128` writes from each chunk it cuts off the
    // end of a 128-bit magnitude: the most digits a `U64` holds every value of.
    _decimal_chunk_length : I64;
    _decimal_chunk_length = 19;

    // `10 ^ _decimal_chunk_length`, the number `_from_decimal_integer_128` divides a magnitude by to
    // cut a chunk off its end. It must stay in sync with `_decimal_chunk_length`.
    _decimal_chunk_divisor : U128;
    _decimal_chunk_divisor = 10000000000000000000_U128;

    // Writes `value` into `bytes` as exactly `count` decimal digits, with leading zeros, so that they
    // end just before `end`: `_write_padded_decimal_digits(5, 3, 42_U64)` writes `042` at 2, 3 and
    // 4.
    //
    // `bytes` must be unshared and hold at least `end` bytes, `end` must be at least `count`, and
    // `value` must be below `10 ^ count`. This function checks none of these, and violating them
    // causes undefined behavior.
    //
    // # Parameters
    // * `end` - The index just after the last digit.
    // * `count` - The number of digits to write.
    // * `value` - The number to write.
    // * `bytes` - The array to write into.
    _write_padded_decimal_digits : I64 -> I64 -> U64 -> Array U8 -> Array U8;
    _write_padded_decimal_digits = |end, count, value, bytes| (
        let start = end - count;
        // The digits are written from the last one backward, two at each step while two places
        // are left, and then one where one place is left.
        let (unwritten_end, rest, bytes) = loop((end, value, bytes), |(pair_end, rest, bytes)| (
            if pair_end - start < 2 { break $ (pair_end, rest, bytes) };
            let higher = rest / 100_U64;
            let bytes = bytes._write_decimal_digit_pair(pair_end - 2, rest - higher * 100_U64);
            continue $ (pair_end - 2, higher, bytes)
        ));
        if unwritten_end == start { bytes };
        bytes.unsafe_set_bounds_unchecked(start, '0' + rest.u8)
    );

    // Creates the decimal text of the integer whose sign is `negative` and whose magnitude is
    // `magnitude`, the way `_from_decimal_integer` creates one, with magnitudes up to those of the
    // 128-bit integers.
    //
    // # Parameters
    // * `negative` - Whether the integer is below zero.
    // * `magnitude` - The absolute value of the integer.
    _from_decimal_integer_128 : Bool -> U128 -> String;
    _from_decimal_integer_128 = |negative, magnitude| (
        // Chunks of `_decimal_chunk_length` digits are cut off the end until the leading digits fit
        // in a `U64`.
        let (chunk_count, leading) = loop((0, magnitude), |(count, rest)| (
            if rest <= U64::maximum.u128 { break $ (count, rest.u64) };
            continue $ (count + 1, rest / _decimal_chunk_divisor)
        ));
        let length = _decimal_integer_length(negative, leading) + _decimal_chunk_length * chunk_count;
        let bytes = Array::empty(length + 1)._unsafe_grow_size(length + 1);
        let bytes = loop((length, magnitude, bytes), |(end, rest, bytes)| (
            if rest <= U64::maximum.u128 { break $ bytes._write_decimal_integer(end, negative, rest.u64) };
            let bytes = bytes._write_padded_decimal_digits(end, _decimal_chunk_length, (rest % _decimal_chunk_divisor).u64);
            continue $ (end - _decimal_chunk_length, rest / _decimal_chunk_divisor, bytes)
        ));
        String { _data : bytes.unsafe_set_bounds_unchecked(length, 0_U8) }
    );

    // Creates the decimal text of `v`, with `-` before the digits where `v` is below zero.
    //
    // # Parameters
    // * `v` - The integer to write.
    _from_signed_decimal_integer : I64 -> String;
    _from_signed_decimal_integer = |v| (
        let (negative, magnitude) = v._sign_and_magnitude;
        _from_decimal_integer(negative, magnitude)
    );

    // How many hexadecimal digits `_write_address` writes: every digit a 64-bit address holds.
    _address_length : I64;
    _address_length = 16;

    // Writes the address `ptr` holds into `bytes` from `at`, as `_address_length` hexadecimal digits
    // in lowercase, leading zeros among them.
    //
    // `bytes` must be unshared and hold at least `at + _address_length` bytes. This function does not
    // check it, and violating it causes undefined behavior.
    //
    // # Parameters
    // * `at` - The index of the first digit.
    // * `ptr` - The pointer whose address is written.
    // * `bytes` - The array to write into.
    _write_address : I64 -> Ptr -> Array U8 -> Array U8;
    _write_address = |at, ptr, bytes| (
        // The digits are written from the last one backward, four bits at each step.
        loop((at + _address_length, ptr.offset_from(nullptr).u64, bytes), |(end, rest, bytes)| (
            if end == at { break $ bytes };
            let digit = rest.bit_and(15_U64).u8;
            let text = if digit < 10_U8 { '0' + digit } else { 'a' + (digit - 10_U8) };
            continue $ (end - 1, rest.shift_right(4_U64), bytes.unsafe_set_bounds_unchecked(end - 1, text))
        ))
    );

    // Creates the text of the address `ptr` holds, as `_write_address` writes it.
    //
    // # Parameters
    // * `ptr` - The pointer whose address is written.
    _from_address : Ptr -> String;
    _from_address = |ptr| (
        let bytes = Array::empty(_address_length + 1)._unsafe_grow_size(_address_length + 1);
        let bytes = bytes._write_address(0, ptr);
        String { _data : bytes.unsafe_set_bounds_unchecked(_address_length, 0_U8) }
    );

    // Create a `String` from a pointer to a null-terminated C string, via an IO action.
    // 
    // If the pointer is not pointing to a valid null-terminated C string, this function causes undefined behavior.
    // 
    // If you have an `Array U8` containing a null-terminated C string, use `FromBytes::from_bytes` instead.
    unsafe_from_c_str_ptr_io : Ptr -> IO String;
    unsafe_from_c_str_ptr_io = |ptr| (
        let len = (*FFI_CALL_IO[CSizeT strlen(Ptr), ptr]).i64;
        let buf_len = len + 1;
        let buf = Array::empty(buf_len)._unsafe_grow_size(buf_len);
        let (buf, _) = *buf.mutate_elements_io(|buf_ptr| FFI_CALL_IO[Ptr memcpy(Ptr, Ptr, CSizeT), buf_ptr, ptr, buf_len.c_size_t]);
        String { _data : buf }.pure
    );

    // Call a function with a null-terminated C string.
    //
    // # Parameters
    //
    // * `borrower` - The function to be called with the C string.
    // * `str` - The string.
    borrow_c_str : (Ptr -> a) -> String -> a;
    borrow_c_str = |borrower, str| str.@_data.borrow_elements(borrower);

    // Call an IO action with a null-terminated C string.
    //
    // # Parameters
    //
    // * `borrower` - The IO action to be called with the C string.
    // * `str` - The string.
    borrow_c_str_io : (Ptr -> IO a) -> String -> IO a;
    borrow_c_str_io = |borrower, str| IO::from_runner $ |ios| (
        str.borrow_c_str(|c_str| (borrower(c_str).@runner)(ios))
    );

    // Concatenate two strings.
    // 
    // Note: Since `s1.concat(s2)` puts `s2` after `s1`, the argument written first is the one that
    // goes second in the result.
    //
    // # Parameters
    //
    // * `rhs` - The string that goes second.
    // * `lhs` - The string that goes first.
    concat : String -> String -> String;
    concat = |rhs, lhs| (
        // Remove null terminator from lhs and append rhs.
        String { _data : lhs.@_data.pop_back.append(rhs.@_data) }
    );

    // Concatenate an iterator of strings.
    //
    // # Parameters
    //
    // * `iter` - The iterator of strings.
    concat_iter : [strs : Iterator, Item strs = String] strs -> String;
    concat_iter = |iter| (
        let len = iter.map(@size).fold(0, add);
        let data_len = len + 1; // Add space for null terminator.
        let data = "".@_data.reserve(data_len);
        let data = iter.fold(data, |str, data| data.pop_back.append(str.@_data));
        String { _data : data }
    );

    // Create an empty string with a given capacity.
    //
    // # Parameters
    //
    // * `capacity` - The capacity of the string to be created.
    empty : I64 -> String;
    empty = |capacity| String { _data : Array::empty(capacity+1).push_back(0_U8) };

    // `str.find(token, start_idx)` finds the index where `token` first appears in `str`, searching
    // from `start_idx`.
    // 
    // The index it answers with is at least `start_idx`, with one exception:
    // `str.find("", start_idx)` with `start_idx >= str.@size` answers with `str.@size`.
    //
    // # Parameters
    //
    // * `token` - The token to be searched.
    // * `start_idx` - The index to start searching from.
    // * `str` - The string to be searched.
    find : String -> I64 -> String -> Option I64;
    find = |token, start_idx, str| (
        str.borrow_c_str(|c_str|
            let start_idx = min(start_idx, str.@size);
            let pos = token.borrow_c_str(|token_c_str| FFI_CALL[Ptr strstr(Ptr, Ptr), c_str.add_offset(start_idx), token_c_str]);
            if pos == nullptr {
                Option::none()
            };
            let pos = pos.offset_from(c_str);
            Option::some(pos)
        )
    );

    // Checks if a string contains a given substring.
    //
    // # Parameters
    // * `substr` - The substring to be checked.
    // * `str` - The string to be searched.
    contains : String -> String -> Bool;
    contains = |substr, str| str.find(substr, 0).is_some;

    // Checks if a string starts with a given prefix.
    // 
    // # Parameters
    // * `prefix` - The prefix to be checked.
    // * `str` - The string
    starts_with : String -> String -> Bool = |prefix, str| (
        let prefix_len = prefix.@size;
        let str_len = str.@size;
        if prefix_len > str_len { false };
        str.borrow_c_str(|str_c_str|
            prefix.borrow_c_str(|prefix_c_str|
                FFI_CALL[CInt strncmp(Ptr, Ptr, CSizeT), str_c_str, prefix_c_str, prefix_len.c_size_t] == 0.c_int
            )
        )
    );

    // Checks if a string ends with a given suffix.
    // 
    // # Parameters
    // * `suffix` - The suffix to be checked.
    // * `str` - The string
    ends_with : String -> String -> Bool = |suffix, str| (
        let suffix_len = suffix.@size;
        let str_len = str.@size;
        if suffix_len > str_len { false };
        str.borrow_c_str(|str_c_str|
            suffix.borrow_c_str(|suffix_c_str|
                FFI_CALL[CInt strncmp(Ptr, Ptr, CSizeT), str_c_str.add_offset(str_len - suffix_len), suffix_c_str, suffix_len.c_size_t] == 0.c_int
            )
        )
    );

    // Gets the byte array of a string, containing null-terminator.
    //
    // # Parameters
    //
    // * `str` - The string to be converted.
    get_bytes : String -> Array U8;
    get_bytes = @_data;

    // The iterator over bytes of a string, excluding null-terminator.
    type StringBytesIterator = struct { _s : String, _i : I64 };

    impl StringBytesIterator : Iterator {
        type Item StringBytesIterator = U8;
        advance = |it| (
            let i = it.@_i;
            if i == it.@_s.@size { none() };
            let c = it.@_s[i].iget;
            let it = it[^_i].imod(add(1));
            (it, c).some
        );
    }

    // Creates an iterator over the bytes of a string, excluding null-terminator.
    //
    // # Parameters
    //
    // * `s` - The string to iterate over.
    to_iter_bytes : [?it : Iterator, Item ?it = U8] String -> ?it;
    to_iter_bytes = |s| StringBytesIterator { _s: s, _i: 0 };

    // Gets the first byte of a string. Returns none if the string is empty.
    //
    // # Parameters
    //
    // * `str` - The string to be converted.
    get_first_byte : String -> Option U8;
    get_first_byte = |str| (
        if str.is_empty { Option::none() };
        Option::some $ str.@_data.@(0)
    );

    // Gets the last byte of a string. Returns none if the string is empty.
    // 
    // # Parameters
    //
    // * `str` - The string to be converted.
    get_last_byte : String -> Option U8;
    get_last_byte = |str| (
        let len = str.@size;
        if len == 0 { Option::none() };
        Option::some $ str.@_data.@(len - 1)
    );

    // Gets the length of a string without counting the null-terminator.
    //
    // # Parameters
    //
    // * `str` - The string to be converted.
    get_size : String -> I64;
    get_size = |str| str.@_data.@size - 1; // exclude null terminator
    DEPRECATED[get_size, "Use `Std::String::@size` instead."];

    // Gets the size of a string without counting the null-terminator.
    // 
    // # Parameters
    // * `string` - The string to get the size from.
    @size : String -> I64 = |s| s.@_data.@size - 1; // exclude null terminator

    // `String` version of `Array::get_sub`.
    //
    // # Parameters
    //
    // * `start` - The start index of the substring.
    // * `end` - The end index of the substring.
    // * `str` - The string to be sliced.
    get_sub : I64 -> I64 -> String -> String;
    get_sub = |start, end, str| (
        let len = str.@size;
        String::_unsafe_from_c_str $ str.get_bytes._get_sub_size_with_length_and_additional_capacity(len, 1, start, end).push_back('\0')
    );

    // Returns if the string is empty or not.
    //
    // # Parameters
    //
    // * `str` - The string to be checked.
    is_empty : String -> Bool;
    is_empty = |str| str.@size == 0;

    // Joins (an iterator of) strings by a separator.
    //
    // # Parameters
    //
    // * `sep` - The separator to be used for joining.
    // * `iter` - The iterator of strings to be joined.
    join : [ss : Iterator, Item ss = String] String -> ss -> String;
    join = |sep, iter| (
        iter.intersperse(sep).concat_iter
    );

    // Removes the last byte.
    // 
    // If the string is empty, this function does nothing.
    //
    // # Parameters
    //
    // * `str` - The string to be modified.
    pop_back_byte : String -> String;
    pop_back_byte = |str| (
        if str.is_empty { str };
        str.mod__data(|bytes| bytes.pop_back.pop_back.push_back(0_U8))
    );

    // `str.split(sep)` splits `str` by `sep` into an iterator.
    // 
    // Example:
    // ```fix
    // assert_eq(|_|"Ex. 1", "ab,c,".split(",").to_array, ["ab", "c", ""]);;
    // assert_eq(|_|"Ex. 2", "abc".split(",").to_array, ["abc"]);;
    // assert_eq(|_|"Ex. 3", "abc".split("").to_array, ["a", "b", "c"]) // Special behavior when the separator is empty.
    // ```
    //
    // # Parameters
    //
    // * `sep` - The separator to be used for splitting.
    // * `str` - The string to be split.
    split : [?it : Iterator, Item ?it = String] String -> String -> ?it;
    split = |sep, str| StringSplitIterator { idx: 0, str: str, strlen: str.@size, sep: sep, sep_len: sep.@size };

    // The iterator over the parts a string is split into by a separator.
    type StringSplitIterator = unbox struct { idx : I64, str : String, strlen : I64, sep : String, sep_len : I64 };

    impl StringSplitIterator : Iterator {
        type Item StringSplitIterator = String;
        advance = |iter| (
            let StringSplitIterator { idx: idx, str: str, strlen: strlen, sep: sep, sep_len: sep_len } = iter;
            if sep_len == 0 {
                if idx == strlen { none() };
                let c_str = String::from_U8 $ str.get_bytes.@(idx);
                some $ (iter.set_idx(idx + 1), c_str)
            };
            if idx == -1 { none() };
            match str.find(sep, idx) {
                none() => some $ (iter.set_idx(-1), str.get_sub(idx, strlen)),
                some(pos) => some $ (iter.set_idx(pos + sep_len), str.get_sub(idx, pos))
            }
        );
    }

    // Creates a string from a byte.
    // 
    // Example:
    // ```fix
    // assert_eq(|_|"", String::from_U8('a'), "a");;
    // assert_eq(|_|"", String::from_U8('\x00'), "")
    // ```
    //
    // # Parameters
    //
    // * `byte` - The byte to be converted.
    from_U8 : U8 -> String;
    from_U8 = |byte| String::_unsafe_from_c_str([byte, '\x00']);

    // Removes the first byte of a string while it satisifies the specified condition.
    //
    // # Parameters
    //
    // * `cond` - The condition for the byte to be removed.
    // * `str` - The string to be modified.
    strip_first_bytes : (U8 -> Bool) -> String -> String;
    strip_first_bytes = |cond, str| (
        let len = str.@size;
        let bytes = str.get_bytes;
        let n = loop(0, |i| (
            if i == len { break $ i };
            if !cond(bytes.@(i)) { break $ i };
            continue $ i + 1
        ));
        str.get_sub(n, len)
    );

    // Removes leading whitespace characters.
    //
    // # Parameters
    //
    // * `str` - The string to be modified.
    strip_first_spaces : String -> String;
    strip_first_spaces = strip_first_bytes(|c| FFI_CALL[CInt isspace(CInt), c.c_int] != 0.c_int);

    // Removes the last byte of a string while it satisifies the specified condition.
    // 
    // # Parameters
    //
    // * `cond` - The condition for the byte to be removed.
    strip_last_bytes : (U8 -> Bool) -> String -> String;
    strip_last_bytes = |cond, str| (
        loop(str, |s|
            if s.is_empty { break $ s };
            if cond(s.get_last_byte.as_some) { 
                continue $ s.pop_back_byte
            } else {
                break $ s
            }
        )
    );

    // Removes newlines and carriage returns at the end of the string.
    //
    // # Parameters
    //
    // * `str` - The string to be modified.
    strip_last_newlines : String -> String;
    strip_last_newlines = strip_last_bytes(|c| c == '\n' || c == '\r');

    // Removes trailing whitespace characters.
    //
    // # Parameters
    //
    // * `str` - The string to be modified.
    strip_last_spaces : String -> String;
    strip_last_spaces = strip_last_bytes(|c| FFI_CALL[CInt isspace(CInt), c.c_int] != 0.c_int);

    // Strips leading and trailing whitespace characters.
    //
    // # Parameters
    //
    // * `str` - The string to be modified.
    strip_spaces : String -> String;
    strip_spaces = |str| str.strip_last_spaces.strip_first_spaces;

    // Populate strings into a template string, similar to "format" function in other languages.
    //
    // i-th "{}" in the template string is replaced by i-th string.
    //
    // Example:
    // `"{}, {}!".populate(["Hello", "world"])` => "Hello, world!"
    //
    //  "{{" and "}}" are escaped to "{" and "}".
    // 
    // Example:
    // `"{{ x = {}, y = {} }}".populate([1.to_string, 2.to_string])` => "{ x = 1, y = 2 }",
    // 
    // If the number of placeholders does not match with the number of strings, this function halts the program.
    // 
    // # Parameters
    // - `vs`: The array of strings ("values") to be inserted into the template string.
    // - `template`: The template string.
    populate : Array String -> String -> String;
    populate = |vs, template| (
        let template = template.get_bytes;
        let end = template.@size - 1;
        let out = [];
        let (out, vi) = loop((out, 0, 0), |(out, i, vi)|
            if i == end { break $ (out, vi) };
            let c = template.@(i);

            // replace "{{" to "{"
            if c == '{' &&
            i + 1 < end && template.@(i+1) == '{' {
                continue $ (out.push_back('{'), i + 2, vi)
            };

            // replace "}}" to "}"
            if c == '}' &&
            i + 1 < end && template.@(i+1) == '}' {
                continue $ (out.push_back('}'), i + 2, vi)
            };

            // replace "{}" to `vs.@(vi)`
            if c == '{' &&
            i + 1 < end && template.@(i+1) == '}' {
                if vi >= vs.@size { undefined("[populate] Too many placeholders!") };
                let out = out.append(vs.@(vi).get_bytes.pop_back);
                continue $ (out, i + 2, vi + 1)
            };

            // raise error for other usage of '{' and '}'
            if c == '{' || c == '}' {
                undefined("[populate] Invalid template string!")
            };

            let out = out.push_back(c);
            
            continue $ (out, i + 1, vi)
        );

        if vi < vs.@size {
            undefined("[populate] Not enough placeholders!")
        };

        String { _data : out.push_back('\0') }
    );
}

// The empty string.
impl String : Zero {
    zero = "";
}

// Concatenates two strings.
impl String : Add {
    add = |lhs, rhs| lhs.concat(rhs);
}

impl String : Eq {
    eq = |lhs, rhs| (lhs.@_data == rhs.@_data);
}

impl String : LessThan {
    less_than = |lhs, rhs| lhs.@_data < rhs.@_data;
}

impl String : LessThanOrEq {
    less_than_or_eq = |lhs, rhs| lhs.@_data <= rhs.@_data;
}

impl String : ToString {
    to_string = |s| s;
}

impl () : Eq {
    eq = |_, _| true;
}

// Creates a string from a byte array.
// 
// The byte array must include a null terminator (`'\0'`). If not, `from_bytes` returns an error.
// 
// The length of the string is the number of bytes until the first null character.
// 
// If you have a pointer to a null-terminated byte array, use `String::unsafe_from_c_str_ptr` instead.
impl String : FromBytes {
    from_bytes = |buf| (
        // Search for null terminator.
        let buf_n = buf.@size;
        let null_idx = range(0, buf_n).loop_iter(buf_n, |i, _|
            if buf.@(i) == '\0' { break $ i };
            continue $ buf_n
        );
        // If the byte array doesn't include a null terminator, return an error.
        if null_idx == buf_n { Result::err("The byte array doesn't include a null terminator.") };

        // Create a string.
        let buf = buf.truncate(null_idx + 1);
        Result::ok $ String { _data : buf }
    );
}

// Converts a string into a byte array.
// 
// The byte array ends with a null terminator (`'\0'`).
impl String : ToBytes {
    to_bytes = |s| s.@_data;
}

// Functions

// Composes two functions. Composition operators `<<` and `>>` is translated to use of `compose`. 
//
// # Parameters
//
// * `first` - The first function to be composed.
// * `second` - The second function to be composed.
compose : (a -> b) -> (b -> c) -> a -> c;
compose = |f, g, a| g(f(a));

// Monadic loop function. This is similar to `loop` but can be used to perform monadic action at each loop.
// 
// It is convenient to use `continue_m` and `break_m` to create monadic loop body function.
// 
// The following program prints "Hello World! (i)" for i = 0, 1, 2.
// 
// ```fix
// # module DocTest;
// #
// main : IO ();
// main = (
//     loop_m(0, |i| (
//         if i == 3 { break_m $ () };
//         println("Hello World! (" + i.to_string + ")");;
//         continue_m $ i + 1
//     ))
// );
// ```
//
// # Parameters
//
// * `s0` - The initial state of the loop.
// * `body` - The body of the loop. It takes the current state and returns a monadic action that produces a new state or a break value.
loop_m : [m : Monad] s -> (s -> m (LoopState s r)) -> m r;
loop_m = |s, f| (
    let res = *f(s);
    if res.is_break { pure $ res.as_break };
    loop_m(res.as_continue, f)
);

