        if v >= 100000000000000_U64 { 15 };
        if v >= 10000000000000_U64 { 14 };
        if v >= 1000000000000_U64 { 13 };
        if v >= 100000000000_U64 { 12 };
        if v >= 10000000000_U64 { 11 };
        if v >= 1000000000_U64 { 10 };
        if v >= 100000000_U64 { 9 };
        if v >= 10000000_U64 { 8 };
        if v >= 1000000_U64 { 7 };
        if v >= 100000_U64 { 6 };
        if v >= 10000_U64 { 5 };
        if v >= 1000_U64 { 4 };
        if v >= 100_U64 { 3 };
