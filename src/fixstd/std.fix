impl F32 : ToString {
    // Writes this number in its shortest round-trip decimal form.
    //
    // A number whose magnitude is at least `1.0e-6` and less than `1.0e13` is written positionally:
    // `1.0`, `0.1`, `3.14159`, `0.000001`. Any other is written with a power of ten: `1.0e13`,
    // `9.99e-7`.
    to_string = |v| (
        // An infinity, a NaN and a zero are string literals, which need no buffer.
        let (negative, ieee_exponent, ieee_mantissa) = F32::_decode_bits(v.to_bits);
        let is_zero = ieee_exponent == 0 && ieee_mantissa == 0_U32;
        if ieee_exponent == 0xFF || is_zero { String::_special_float_text(is_zero, ieee_mantissa != 0_U32, negative) };
        let size = F32::_shortest_text_max_length + 1;
        String::_from_written_bytes $ Array::empty(size)._unsafe_grow_size(size).F32::_write_shortest_text(0, v)
    );
}
namespace F32 {
    // Writes this number with one digit before the point, six after it, and a power of ten, as
    // `to_string_exp_precision(6_U8)` does: `123.456_F32` is written `1.234560e2`.
    to_string_exp : F32 -> String;
    to_string_exp = |v| v.to_string_exp_precision(6_U8);

    // Writes this number with one digit before the point, `prec` digits after it, and a power of
    // ten. The last digit is rounded to the nearest, a tie to the even one.
    //
    // With `prec` 0, no point is written.
    //
    // # Examples
    // `123.456_F32.to_string_exp_precision(2_U8)` is `1.23e2`,
    // `0.0123_F32.to_string_exp_precision(1_U8)` is `1.2e-2`, and
    // `123.456_F32.to_string_exp_precision(0_U8)` is `1e2`.
    //
    // # Parameters
    // * `prec` - The number of digits after the point.
    // * `v` - The number to write.
    to_string_exp_precision : U8 -> F32 -> String;
    to_string_exp_precision = |prec, v| (
        // An infinity and a NaN are string literals, which need no buffer.
        if !v.f64.F64::_is_finite { v.f64.F64::_non_finite_text };
        let size = F32::_exp_text_max_length(prec.i64) + 1;
        String::_from_written_bytes $ Array::empty(size)._unsafe_grow_size(size).F32::_write_exp_text(0, prec.i64, v)
    );

    // Writes this number positionally with `prec` digits after the point. The last digit is
    // rounded to the nearest, a tie to the even one.
    //
    // With `prec` 0, no point is written.
    //
    // # Examples
    // `3.14159_F32.to_string_precision(2_U8)` is `3.14`, and `2.5_F32.to_string_precision(0_U8)`
    // is `2`.
    //
    // # Parameters
    // * `prec` - The number of digits after the point.
    // * `v` - The number to write.
    to_string_precision : U8 -> F32 -> String;
    to_string_precision = |prec, v| (
        // An infinity and a NaN are string literals, which need no buffer.
        if !v.f64.F64::_is_finite { v.f64.F64::_non_finite_text };
        let size = F32::_fixed_text_max_length(prec.i64) + 1;
        String::_from_written_bytes $ Array::empty(size)._unsafe_grow_size(size).F32::_write_fixed_text(0, prec.i64, v)
    );

    // The most bytes `_write_shortest_text` writes. Two shapes reach it: a sign, `0.` and the five
    // zeros the lower edge of the window allows before the eight digits an `F32` needs at that
    // scale, and the same with four zeros and nine digits. Nine digits never meet five zeros, since
    // no `F32` between `1e-6` and `1e-5` needs that many. Widening the window of `_positional_low`
    // and `_positional_high` widens this.
    _shortest_text_max_length : I64;
    _shortest_text_max_length = 16;

    // Writes `v` into `bytes` from `at` the way `to_string` writes it, and answers with the index
    // after the text and the array.
    //
    // `bytes` must be unshared. Where it holds fewer than `at + _shortest_text_max_length` bytes, the
    // program stops before the text is written.
    //
    // # Parameters
    // * `at` - The index of the first byte.
    // * `v` - The number to write.
    // * `bytes` - The array to write into.
    _write_shortest_text : I64 -> F32 -> Array U8 -> (I64, Array U8);
    _write_shortest_text = |at, v, bytes| (
        let bytes = bytes._check_text_fits(at, F32::_shortest_text_max_length);
        let (negative, ieee_exponent, ieee_mantissa) = F32::_decode_bits(v.to_bits);
        let is_zero = ieee_exponent == 0 && ieee_mantissa == 0_U32;
        if ieee_exponent == 0xFF || is_zero { bytes._write_special_float(at, is_zero, ieee_mantissa != 0_U32, negative) };
        let decimal = F32::_find_shortest_decimal(ieee_exponent, ieee_mantissa);
        bytes._write_float_decimal(at, F32::_positional_low, F32::_positional_high, negative, decimal)
    );

    // Answers with the sign, the biased exponent and the stored significand of the `F32` whose bits
    // are `bits`.
    //
    // # Parameters
    // * `bits` - The bits of the number.
    _decode_bits : U32 -> (Bool, I64, U32);
    _decode_bits = |bits| (bits.shift_right(31_U32) == 1_U32, bits.shift_right(23_U32).bit_and(0xFF_U32).i64, bits.bit_and(0x7FFFFF_U32));

    // The window `to_string` writes an `F32` positionally in: the number is written positionally
    // where `_positional_low < point <= _positional_high`, and the first of its shortest digits
    // carries `10 ^ (point - 1)`. The window is drawn around the digits an `F32` carries, since a
    // wider one costs zeros.
    _positional_low : I64;
    _positional_low = -6;

    // The upper edge of the window `_positional_low` describes.
    _positional_high : I64;
    _positional_high = 13;

    // The most bytes `to_string_precision` writes for an `F32` with `precision` digits after the
    // point: a sign, the 39 digits the greatest `F32` takes in its whole part, a point and the
    // digits after it. The point is counted at a precision of 0 too, where none is written.
    //
    // # Parameters
    // * `precision` - The number of digits after the point.
    _fixed_text_max_length : I64 -> I64;
    _fixed_text_max_length = |precision| 41 + precision;

    // The most bytes `to_string_exp_precision` writes for an `F32` with `precision` digits after the
    // point: a sign, a digit, a point, the digits after it, `e`, the `-` of a negative power and the
    // 2 digits an `F32` power reaches. The point is counted at a precision of 0 too, where none is
    // written.
    //
    // # Parameters
    // * `precision` - The number of digits after the point.
    _exp_text_max_length : I64 -> I64;
    _exp_text_max_length = |precision| 7 + precision;

    // Writes `v` into `bytes` from `at` the way `to_string_precision` writes it, and answers with the
    // index after the text and the array.
    //
    // `bytes` must be unshared. Where it holds fewer than `at + _fixed_text_max_length(precision)`
    // bytes, the program stops before the text is written.
    //
    // # Parameters
    // * `at` - The index of the first byte.
    // * `precision` - The number of digits after the point.
    // * `v` - The number to write.
    // * `bytes` - The array to write into.
    _write_fixed_text : I64 -> I64 -> F32 -> Array U8 -> (I64, Array U8);
    _write_fixed_text = |at, precision, v, bytes| (
        let bytes = bytes._check_text_fits(at, F32::_fixed_text_max_length(precision));
        bytes.F64::_write_fixed_text_unchecked(at, precision, v.f64)
    );

    // Writes `v` into `bytes` from `at` the way `to_string_exp_precision` writes it, and answers with
    // the index after the text and the array.
    //
    // `bytes` must be unshared. Where it holds fewer than `at + _exp_text_max_length(precision)`
    // bytes, the program stops before the text is written.
    //
    // # Parameters
    // * `at` - The index of the first byte.
    // * `precision` - The number of digits after the point.
    // * `v` - The number to write.
    // * `bytes` - The array to write into.
    _write_exp_text : I64 -> I64 -> F32 -> Array U8 -> (I64, Array U8);
    _write_exp_text = |at, precision, v, bytes| (
        let bytes = bytes._check_text_fits(at, F32::_exp_text_max_length(precision));
        bytes.F64::_write_exp_text_unchecked(at, precision, v.f64)
    );
}
impl F32 : FromString {
    // Reads a decimal number: an optional `+` or `-`, digits with an optional point among them, and
    // an optional power of ten, such as `3.14`, `-1e10`, `.5` or `2.5E-3`. Also reads `inf`,
    // `infinity` and `nan` in any case, with an optional sign, and `nan` followed by letters,
    // digits and underscores in parentheses, such as `nan(1)`.
    //
    // The number is rounded to the nearest `F32`. A text naming a number too large for `F32`, or a
    // number other than zero too small for it to hold at all, is an error.
    from_string = |str| (
        let (v, outcome) = str.borrow_c_str_io(|c_str| (
            let v = *FFI_CALL_IO[F32 fixruntime_read_f32(Ptr), c_str];
            let outcome = *FFI_CALL_IO[U8 fixruntime_float_text_outcome()];
            (v, outcome).pure
        )).unsafe_perform;
        str._float_text_result(outcome, v)
    );
}

// The functions of this namespace whose names begin with `_` and that find the decimal digits of a
// floating point number are translated from Ryu, under the license the namespace `F64` names.
namespace F32 {
    // Computes `floor(m * factor / 2 ^ shift)`, for `shift` from 33 to 95, where the answer fits in
    // 32 bits: Ryu's `mulShift32`.
    //
    // # Parameters
    // * `m` - The number to multiply.
    // * `factor` - The multiplier.
    // * `shift` - The power of two to divide by.
    _multiply_shift_32 : U32 -> U64 -> I64 -> U32;
    _multiply_shift_32 = |m, factor, shift| (
        let low = m.u64 * factor.bit_and(0xFFFFFFFF_U64);
        let high = m.u64 * factor.shift_right(32_U64);
        (low.shift_right(32_U64) + high).shift_right((shift - 32).u64).u32
    );

    // Computes `floor(m / 5 ^ q / 2 ^ j)` with the multipliers of `F64`: Ryu's
    // `mulPow5InvDivPow2`.
    //
    // # Parameters
    // * `m` - The number to divide.
    // * `q` - The power of five.
    // * `j` - The power of two.
    _multiply_pow5_inv_shift : U32 -> I64 -> I64 -> U32;
    _multiply_pow5_inv_shift = |m, q, j| (
        // The high word of the multiplier of `F64`, which it rounds down, is rounded up here.
        _multiply_shift_32(m, F64::_pow5_inv_split._unsafe_get_bounds_unchecked(2 * q + 1) + 1_U64, j)
    );

    // Computes `floor(m * 5 ^ i / 2 ^ j)` with the multipliers of `F64`: Ryu's `mulPow5divPow2`.
    //
    // # Parameters
    // * `m` - The number to multiply.
    // * `i` - The power of five.
    // * `j` - The power of two.
    _multiply_pow5_shift : U32 -> I64 -> I64 -> U32;
    _multiply_pow5_shift = |m, i, j| _multiply_shift_32(m, F64::_pow5_split._unsafe_get_bounds_unchecked(2 * i + 1), j);

    // The bits of the multipliers `_multiply_pow5_inv_shift` and `_multiply_pow5_shift` read: Ryu's
    // `FLOAT_POW5_INV_BITCOUNT` and `FLOAT_POW5_BITCOUNT`, which are `F64::_pow5_inv_bitcount` and
    // `F64::_pow5_bitcount` less the word these leave out.
    _pow5_bitcount : I64;
    _pow5_bitcount = 61;

    // Counts the factors of five of `value`, which is other than zero: Ryu's `pow5factor_32`.
    //
    // # Parameters
    // * `value` - The number whose factors are counted.
    _count_factors_of_5 : U32 -> I64;
    _count_factors_of_5 = |value| loop((value, 0), |(value, count)| (
        let q = value / 5_U32;
        if value - 5_U32 * q != 0_U32 { break $ count };
        continue $ (q, count + 1)
