            let (vr, vm, removed, last_removed_digit) = loop((vr, vp, vm, 0, last_removed_digit), |(vr, vp, vm, removed, last_removed_digit)| (
                if vp / 10_U32 <= vm / 10_U32 { break $ (vr, vm, removed, last_removed_digit) };
                continue $ (vr / 10_U32, vp / 10_U32, vm / 10_U32, removed + 1, vr % 10_U32)
