    // biased exponent is `ieee_exponent` and whose stored significand is `ieee_mantissa`, and
    // answers with them as a number, the power of ten they are multiplied by, and their count:
    // Ryu's `f2d` and `f2s_shortest`. `0.25_F32` gives `(25, -2, 2)`.
    //
    // # Parameters
    // * `ieee_exponent` - The biased exponent.
    // * `ieee_mantissa` - The stored significand.
    _find_shortest_decimal : I64 -> U32 -> (U64, I64, I64);
    _find_shortest_decimal = |ieee_exponent, ieee_mantissa| (
        // Two more bits below the significand leave room for the bounds of the interval.
        let (e2, m2) = if ieee_exponent == 0 {
            (1 - 127 - 23 - 2, ieee_mantissa)
        } else {
            (ieee_exponent - 127 - 23 - 2, 1_U32.shift_left(23_U32).bit_or(ieee_mantissa))
        };
        let accept_bounds = m2.bit_and(1_U32) == 0_U32;
        let mv = 4_U32 * m2;
        let mp = mv + 2_U32;
        let mm_shift = if ieee_mantissa != 0_U32 || ieee_exponent <= 1 { 1_U32 } else { 0_U32 };
        let mm = mv - 1_U32 - mm_shift;
        // The decimal numbers below the number, at it and above it, at the power of ten `e10`, and
        // the digit removed from `vr` last where it was found.
        let (vr, vp, vm, e10, vm_is_trailing_zeros, vr_is_trailing_zeros, last_removed_digit) = if e2 >= 0 {
            let q = F64::_compute_log10_pow2(e2);
            let i = -e2 + q + F32::_pow5_bitcount + F64::_compute_pow5_bits(q) - 1;
            let vr = _multiply_pow5_inv_shift(mv, q, i);
            let vp = _multiply_pow5_inv_shift(mp, q, i);
            let vm = _multiply_pow5_inv_shift(mm, q, i);
            // Where the digits from `vr` are about to be removed, the first of them is found from
            // one power of ten less.
            let last_removed_digit = if q != 0 && (vp - 1_U32) / 10_U32 <= vm / 10_U32 {
                let l = F32::_pow5_bitcount + F64::_compute_pow5_bits(q - 1) - 1;
                _multiply_pow5_inv_shift(mv, q - 1, -e2 + q - 1 + l) % 10_U32
