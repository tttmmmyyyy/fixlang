impl F64 : ToBytes {
    to_bytes = F64::_to_bytes;
}
impl F64 : FromBytes {
    from_bytes = |bs| (
        if bs.@size != 8 {
            Result::err $ "Byte array of length " + bs.@size.to_string + " cannot be interpreted as F64."
        };
        Result::ok $ F64::_unsafe_from_bytes_size_unchecked(bs)
    );
}
