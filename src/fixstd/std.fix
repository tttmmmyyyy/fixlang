impl I128 : FromString {
    // Reads a decimal integer: an optional `+` or `-` followed by one or more digits, such as
    // `42`, `-7` or `+007`. A text naming a number outside `I128` is an error.
    from_string = |str| (
        let max = I128::maximum.u128;
        str._read_decimal_integer_128(max, max + 1_U128).map(|(negative, magnitude)| (
            I128::_from_sign_and_magnitude(negative, magnitude)
        ))
    );
}

