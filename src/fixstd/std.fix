// Returns "()".
impl () : ToString {
    to_string = |_| "()";
}

namespace Debug {

    // Asserts that a condition (boolean value) is true. 
    // 
    // If the assertion failed, prints a message to the stderr and aborts the program.
    //
    // # Parameters
    //
    // * `lazy_msg`
    // * `condition`
    assert : Lazy String -> Bool -> IO ();
    assert = |lazy_msg, condition| IO::from_runner $ |state| (
        if condition {
            (state, ())
        } else {
            undefined("Assertion failed!: " + lazy_msg())
        }
    );

    // Asserts that two values are equal.
    // 
    // If the assertion failed, prints a message to the stderr and aborts the program.
    //
    // # Parameters
    //
    // * `lazy_msg`
    // * `lhs`
    // * `rhs`
    assert_eq : [a: Eq] Lazy String -> a -> a -> IO ();
    assert_eq = |lazy_msg, lhs, rhs| assert(lazy_msg, lhs == rhs);

    // Asserts that the given boxed value is unique, and returns the given value.
    // If the assertion failed, prints a message to the stderr and aborts the program.
    //
    // An `Array` is unboxed, but it keeps its elements in reference-counted heap memory. To
    // assert that an array's element storage is uniquely referenced, use `assert_unique_array`.
    //
    // The `[a : Boxed]` constraint was added in Fix 1.5.0. Before 1.5.0 the constraint was absent
    // and this treated any unboxed value as unique, so it never aborted for an unboxed argument.
    //
    // This function should be limited to temporary use for debugging purposes and should be removed from the final code.
    //
    // # Parameters
    //
    // * `lazy_msg`
    // * `value`
    assert_unique : [a : Boxed] Lazy String -> a -> a;
    assert_unique = |lazy_msg, value| (
        let (unique, value) = value.unsafe_is_unique;
        if !unique { undefined("Value is not unique: " + lazy_msg()) };
        value
    );

    // Asserts that the storage buffer of the given array is uniquely referenced (not shared),
    // and returns the array. If the assertion failed, prints a message to the stderr and aborts
    // the program.
    //
    // This function should be limited to temporary use for debugging purposes and should be removed from the final code.
    //
    // # Parameters
    //
    // * `lazy_msg`
    // * `array`
    assert_unique_array : Lazy String -> Array a -> Array a;
    assert_unique_array = |lazy_msg, arr| (
        let (unique, arr) = arr._unsafe_is_storage_unique;
        if !unique { undefined("Array storage is not unique: " + lazy_msg()) };
        arr
    );

    // Get clocks (cpu time) elapsed while executing an I/O action.
    //
    // # Parameters
    //
    // * `action`
    consumed_time_while_io : IO a -> IO (a, F64);
    consumed_time_while_io = |io| (
        let s = *FFI_CALL_IO[I64 fixruntime_clock()];
        let r = *io;
        let t = *FFI_CALL_IO[I64 fixruntime_clock()];
        let t = FFI_CALL[F64 fixruntime_clocks_to_sec(I64), t - s];
        pure $ (r, t)
    );

    // Get clocks (cpu time) elapsed while evaluating a lazy value.
    // 
    // NOTE: This function is not pure and should only be used for temporary debugging purposes.
    //
    // # Parameters
    //
    // * `lazy_value`
    consumed_time_while_lazy : Lazy a -> (a, F64);
    consumed_time_while_lazy = |l| (
        let io = IO::from_runner $ |ios| (ios, l());
        consumed_time_while_io(io).unsafe_perform
    );

    // Prints a string to stderr and flushes.
    // 
    // NOTE: This function is not pure and should only be used for temporary debugging purposes.
    //
    // # Parameters
    //
    // * `msg` - The string to be printed.
    debug_eprint : String -> ();
    debug_eprint = |msg| (eprint(msg);; stderr.flush;; pure()).unsafe_perform;

    // Prints a string followed by a newline to stderr and flushes.
    //
    // NOTE: This function is not pure and should only be used for temporary debugging purposes.
    //
    // # Parameters
    //
    // * `msg` - The string to be printed.
    debug_eprintln : String -> ();
    debug_eprintln = |msg| (eprintln(msg);; stderr.flush;; pure()).unsafe_perform;

    // Prints a string to stdout and flushes.
    // 
    // NOTE: This function is not pure and should only be used for temporary debugging purposes.
    //
    // # Parameters
    //
    // * `msg` - The string to be printed.
    debug_print : String -> ();
    debug_print = |msg| (print(msg);; stdout.flush;; pure()).unsafe_perform;

    // Prints a string followed by a newline to stdout and flushes.
    //
    // NOTE: This function is not pure and should only be used for temporary debugging purposes.
    //
    // # Parameters
    //
    // * `msg` - The string to be printed.
    debug_println : String -> ();
    debug_println = |msg| (println(msg);; stdout.flush;; pure()).unsafe_perform;
}

// The trait for indexable types.
// 
// Implementing this trait for an aggregate value `xs` enables the use of the index syntax `xs[i]`.
// 
// The index syntax `xs[i]` returns a "store", which is a value of type `[f : Functor] Elem c -> f (Elem c) -> f c`.
// By applying `Indexable::iget`, `Indexable::iset`, `Indexable::imod`, and `Indexable::iact` to the store, 
// various operations can be performed on the specified index.
trait c : Indexable {
    // The type of elements.
    type Elem c;
    // The type of indices.
    type Index c;
    // Act on an index.
    // 
    // # Parameters
    // * `i` - The index.
    // * `f` - The functorial action to be performed on the element at the specified index.
    // * `c` - The collection.
    act_at_index : [f : Functor] Index c -> (Elem c -> f (Elem c)) -> c -> f c;
}

impl Array a : Indexable {
    type Elem (Array a) = a;
    type Index (Array a) = I64;
    act_at_index = Array::act;
}

impl String : Indexable {
    type Elem String = U8;
    type Index String = I64;
    act_at_index = |i, f, s| (
        let i = _check_range(i, s.@size);
        s[^_data].iact(Array::_unsafe_act_bounds_unchecked(i, f))
    );
}

// The identity functor.
type Identity a = struct { data : a };
impl Identity : Functor {
    map = |f, Identity { data : x }| ( Identity { data : f(x) } );
}
impl Identity : Monad {
    pure = |x| Identity { data : x };
    bind = |f, Identity { data : x }| f(x);
}

// The constant functor.
type Const a b = struct { data : a };
impl Const a : Functor {
    map = |_, Const { data : x }| ( Const { data : x } );
}

namespace Indexable {
    // Get a value from a store.
    // 
    // Stores can be created using index syntax on `Indexable`s or structs.
    // 
    // # Examples
    // 
    // ```fix
    // let arr = [1, 2, 3];
    // assert_eq(|_|"", arr[1].iget, 2)
    // ```
    // 
    // # Parameters
    // 
    // * `store` - The store.
    iget : ((a -> Const a a) -> Const a b) -> a;
    iget = |store| store(|x| Const { data : x }).@data;

    // Set a value into a store.
    // 
    // Stores can be created using index syntax on `Indexable`s or structs.
    // 
    // # Examples
    // ```fix
    // let arr = [1, 2, 3];
    // let arr = arr[1].iset(42);
    // assert_eq(|_|"", arr, [1, 42, 3])
    // ```
    //
    // # Parameters
    // * `x` - The value to be set.
    // * `store` - The store.
    iset : a -> ((a -> Identity a) -> Identity b) -> b;
    iset = |x, store| store(|_| Identity { data : x }).@data;

    // Modify a value in a store using a function.
    // 
    // Stores can be created using index syntax on `Indexable`s or structs.
    //
    // # Examples
    // ```fix
    // let arr = [1, 2, 3];
    // let arr = arr[1].imod(|x| x * 10);
    // assert_eq(|_|"", arr, [1, 20, 3])
    // ```
    //
    // # Parameters
    // * `f` - The function to modify the value.
    // * `store` - The store.
    imod : (a -> a) -> ((a -> Identity a) -> Identity b) -> b;
    imod = |f, store| store(|x| Identity { data : f(x) }).@data;

    // Exchange a value in a store with a new value.
    // 
    // Stores can be created using index syntax on `Indexable`s or structs.
    // 
    // # Examples
    // ```fix
    // let arr = [1, 2, 3];
    // let (arr, x) = arr[1].ixchg(42);
    // assert_eq(|_|"", x, 2);;
    // assert_eq(|_|"", arr, [1, 42, 3])
    // ```
    // 
    // # Parameters
    // * `new` - The new value to be set.
    // * `store` - The store.
    ixchg : a -> ((a -> (a, a)) -> (a, b)) -> (b, a);
    ixchg = |new, store| let (x, y) = store(|old| (old, new)); (y, x);

    // Modify a value in a store using a functorial action.
    // 
    // Stores can be created using index syntax on `Indexable`s or structs.
    // 
    // # Examples
    // ```fix
    // let arr = [1, 2, 3];
    // let arr = arr[1].iact(|x| some(x * 10));
    // assert_eq(|_|"", arr, some([1, 20, 3]))
    // ```
    // 
    // # Parameters
    // * `f` - The functorial action to modify the value.
    // * `store` - The store.
    iact : [f : Functor] (a -> f a) -> ((a -> f a) -> f b) -> f b;
    iact = |f, store| store(f);
}