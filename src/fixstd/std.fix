    // A number whose magnitude is at least `1.0e-5` and less than `1.0e16` is written positionally:
    // `1.0`, `0.1`, `123456.789`, `0.00001`. Any other is written with a power of ten: `1.0e16`,
    // `9.99e-6`, `1.0e300`.
    to_string = |v| (
        // An infinity, a NaN and a zero are string literals, which need no buffer.
        let (negative, ieee_exponent, ieee_mantissa) = F64::_decode_bits(v.to_bits);
        let is_zero = ieee_exponent == 0 && ieee_mantissa == 0_U64;
        if ieee_exponent == 0x7FF || is_zero { String::_special_float_text(is_zero, ieee_mantissa != 0_U64, negative) };
        let size = F64::_shortest_text_max_length + 1;
        String::_from_written_bytes $ Array::empty(size)._unsafe_grow_size(size).F64::_write_shortest_text(0, v)
    );
}
