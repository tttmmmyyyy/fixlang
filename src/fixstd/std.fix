        if v >= 10000_U32 { 5 };
        if v >= 1000_U32 { 4 };
        if v >= 100_U32 { 3 };
        if v >= 10_U32 { 2 };
        1
    );

    // Computes `ceil(log2(5 ^ e))`, and 1 for `e` 0: Ryu's `pow5bits`. `e` is from 0 to 3528.
    //
    // # Parameters
    // * `e` - The power of five.
    _compute_pow5_bits : I64 -> I64;
    _compute_pow5_bits = |e| (e.u32 * 1217359_U32).shift_right(19_U32).i64 + 1;

    // Computes `floor(log10(2 ^ e))`: Ryu's `log10Pow2`. `e` is from 0 to 1650.
    //
    // # Parameters
    // * `e` - The power of two.
    _compute_log10_pow2 : I64 -> I64;
    _compute_log10_pow2 = |e| (e.u32 * 78913_U32).shift_right(18_U32).i64;

    // Computes `floor(log10(5 ^ e))`: Ryu's `log10Pow5`. `e` is from 0 to 2620.
    //
    // # Parameters
    // * `e` - The power of five.
    _compute_log10_pow5 : I64 -> I64;
    _compute_log10_pow5 = |e| (e.u32 * 732923_U32).shift_right(20_U32).i64;

    // Counts the factors of five of `value`, which is other than zero: Ryu's `pow5Factor`.
    //
    // # Parameters
    // * `value` - The number whose factors are counted.
    _count_factors_of_5 : U64 -> I64;
    _count_factors_of_5 = |value| loop((value, 0), |(value, count)| (
        // Multiplying by the inverse of 5 modulo `2 ^ 64` divides a multiple of 5 exactly, and
        // takes any other number above `(2 ^ 64 - 1) / 5`.
        let value = value * 14757395258967641293_U64;
        if value > 3689348814741910323_U64 { break $ count };
        continue $ (value, count + 1)
    ));

    // Answers whether `5 ^ p` divides `value`, which is other than zero: Ryu's
    // `multipleOfPowerOf5`.
    //
    // # Parameters
    // * `p` - The power of five.
    // * `value` - The number to divide.
    _is_multiple_of_power_of_5 : I64 -> U64 -> Bool;
    _is_multiple_of_power_of_5 = |p, value| F64::_count_factors_of_5(value) >= p;

    // Answers whether `2 ^ p` divides `value`, for `p` from 0 to 63: Ryu's `multipleOfPowerOf2`.
    //
    // # Parameters
    // * `p` - The power of two.
    // * `value` - The number to divide.
    _is_multiple_of_power_of_2 : I64 -> U64 -> Bool;
    _is_multiple_of_power_of_2 = |p, value| value.bit_and(1_U64.shift_left(p.u64) - 1_U64) == 0_U64;

    // Computes `floor(m * mul / 2 ^ j)`, where `mul` is the 128-bit number whose low and high words
    // are `mul_low` and `mul_high`: Ryu's `mulShift64`. `j` is from 64 to 191, and the answer fits in
    // 64 bits.
    //
    // # Parameters
    // * `m` - The number to multiply.
    // * `mul_low`, `mul_high` - The words of the multiplier.
    // * `j` - The power of two to divide by.
    _multiply_shift_64 : U64 -> U64 -> U64 -> I64 -> U64;
    _multiply_shift_64 = |m, mul_low, mul_high, j| (
        let low = m.u128 * mul_low.u128;
        let high = m.u128 * mul_high.u128;
        (low.shift_right(64_U128) + high).shift_right((j - 64).u128).u64
    );

    // Finds the shortest decimal digits that read back as the finite number other than zero whose
    // biased exponent is `ieee_exponent` and whose stored significand is `ieee_mantissa`, and
    // answers with them as a number and the power of ten they are multiplied by: Ryu's `d2d`.
    //
    // # Parameters
    // * `ieee_exponent` - The biased exponent.
    // * `ieee_mantissa` - The stored significand.
    _find_shortest_decimal_general : I64 -> U64 -> (U64, I64);
    _find_shortest_decimal_general = |ieee_exponent, ieee_mantissa| (
        let (e2, m2) = _decode_finite(ieee_exponent, ieee_mantissa);
        // Two more bits below the significand leave room for the bounds of the interval.
        let e2 = e2 - 2;
        let accept_bounds = m2.bit_and(1_U64) == 0_U64;
        let mv = 4_U64 * m2;
        let mm_shift = if ieee_mantissa != 0_U64 || ieee_exponent <= 1 { 1_U64 } else { 0_U64 };
        // The decimal numbers below the number, at it and above it, at the power of ten `e10`.
        let (vr, vp, vm, e10, vm_is_trailing_zeros, vr_is_trailing_zeros) = if e2 >= 0 {
            let q = _compute_log10_pow2(e2) - (if e2 > 3 { 1 } else { 0 });
            let i = -e2 + q + _pow5_inv_bitcount + _compute_pow5_bits(q) - 1;
            let mul_low = _pow5_inv_split._unsafe_get_bounds_unchecked(2 * q);
            let mul_high = _pow5_inv_split._unsafe_get_bounds_unchecked(2 * q + 1);
            let vr = _multiply_shift_64(mv, mul_low, mul_high, i);
            let vp = _multiply_shift_64(mv + 2_U64, mul_low, mul_high, i);
            let vm = _multiply_shift_64(mv - 1_U64 - mm_shift, mul_low, mul_high, i);
            if q > 21 { (vr, vp, vm, q, false, false) };
            // Only one of `mv`, `mv + 2` and `mv - 1 - mm_shift` can be a multiple of 5, if any.
            if mv % 5_U64 == 0_U64 { (vr, vp, vm, q, false, mv._is_multiple_of_power_of_5(q)) };
            if accept_bounds { (vr, vp, vm, q, (mv - 1_U64 - mm_shift)._is_multiple_of_power_of_5(q), false) };
            let vp = vp - (if (mv + 2_U64)._is_multiple_of_power_of_5(q) { 1_U64 } else { 0_U64 });
            (vr, vp, vm, q, false, false)
        } else {
            let q = _compute_log10_pow5(-e2) - (if -e2 > 1 { 1 } else { 0 });
            let i = -e2 - q;
            let j = q - (_compute_pow5_bits(i) - F64::_pow5_bitcount);
            let mul_low = _pow5_split._unsafe_get_bounds_unchecked(2 * i);
            let mul_high = _pow5_split._unsafe_get_bounds_unchecked(2 * i + 1);
            let vr = _multiply_shift_64(mv, mul_low, mul_high, j);
            let vp = _multiply_shift_64(mv + 2_U64, mul_low, mul_high, j);
            let vm = _multiply_shift_64(mv - 1_U64 - mm_shift, mul_low, mul_high, j);
            let e10 = q + e2;
            if q <= 1 {
                // `mv` has at least two trailing zero bits, and `mv - 1 - mm_shift` has one where
                // `mm_shift` is 1.
                if accept_bounds { (vr, vp, vm, e10, mm_shift == 1_U64, true) };
                // `mv + 2` has at least one trailing zero bit.
                (vr, vp - 1_U64, vm, e10, false, true)
            };
            if q < 63 { (vr, vp, vm, e10, false, mv._is_multiple_of_power_of_2(q)) };
            (vr, vp, vm, e10, false, false)
        };
        if vm_is_trailing_zeros || vr_is_trailing_zeros {
            // The general case, which needs the digits removed from `vr` and whether those of `vm`
            // are zeros.
            let (vr, vp, vm, removed, last_removed_digit, vm_is_trailing_zeros, vr_is_trailing_zeros) = loop(
                (vr, vp, vm, 0, 0_U64, vm_is_trailing_zeros, vr_is_trailing_zeros),
                |(vr, vp, vm, removed, last_removed_digit, vm_zeros, vr_zeros)| (
                    let vp_div10 = vp / 10_U64;
                    let vm_div10 = vm / 10_U64;
                    if vp_div10 <= vm_div10 { break $ (vr, vp, vm, removed, last_removed_digit, vm_zeros, vr_zeros) };
                    let vm_mod10 = vm - 10_U64 * vm_div10;
                    let vr_div10 = vr / 10_U64;
                    let vr_mod10 = vr - 10_U64 * vr_div10;
                    continue $ (vr_div10, vp_div10, vm_div10, removed + 1, vr_mod10, vm_zeros && vm_mod10 == 0_U64, vr_zeros && last_removed_digit == 0_U64)
                )
            );
            let (vr, vm, removed, last_removed_digit, vr_is_trailing_zeros) = if vm_is_trailing_zeros {
                loop((vr, vp, vm, removed, last_removed_digit, vr_is_trailing_zeros), |(vr, vp, vm, removed, last_removed_digit, vr_zeros)| (
                    let vm_div10 = vm / 10_U64;
                    let vm_mod10 = vm - 10_U64 * vm_div10;
                    if vm_mod10 != 0_U64 { break $ (vr, vm, removed, last_removed_digit, vr_zeros) };
                    let vr_div10 = vr / 10_U64;
                    let vr_mod10 = vr - 10_U64 * vr_div10;
                    continue $ (vr_div10, vp / 10_U64, vm_div10, removed + 1, vr_mod10, vr_zeros && last_removed_digit == 0_U64)
                ))
            } else {
                (vr, vm, removed, last_removed_digit, vr_is_trailing_zeros)
            };
            // An exact `...50...0` rounds to the even digit.
            let last_removed_digit = if vr_is_trailing_zeros && last_removed_digit == 5_U64 && vr % 2_U64 == 0_U64 { 4_U64 } else { last_removed_digit };
            // `vr + 1` is taken where `vr` is outside the bounds or the removed digits round up.
            let round_up = (vr == vm && (!accept_bounds || !vm_is_trailing_zeros)) || last_removed_digit >= 5_U64;
            (vr + (if round_up { 1_U64 } else { 0_U64 }), e10 + removed)
        };
        // The common case, which removes two digits at once where it can.
        let (vr, vp, vm, removed, round_up) = (
            let vp_div100 = vp / 100_U64;
            let vm_div100 = vm / 100_U64;
            if vp_div100 <= vm_div100 { (vr, vp, vm, 0, false) };
            let vr_div100 = vr / 100_U64;
            (vr_div100, vp_div100, vm_div100, 2, vr - 100_U64 * vr_div100 >= 50_U64)
        );
        let (vr, vm, removed, round_up) = loop((vr, vp, vm, removed, round_up), |(vr, vp, vm, removed, round_up)| (
            let vp_div10 = vp / 10_U64;
            let vm_div10 = vm / 10_U64;
            if vp_div10 <= vm_div10 { break $ (vr, vm, removed, round_up) };
            let vr_div10 = vr / 10_U64;
            continue $ (vr_div10, vp_div10, vm_div10, removed + 1, vr - 10_U64 * vr_div10 >= 5_U64)
        ));
        (vr + (if vr == vm || round_up { 1_U64 } else { 0_U64 }), e10 + removed)
    );

    // Finds the shortest decimal digits that read back as the finite number other than zero whose
    // biased exponent is `ieee_exponent` and whose stored significand is `ieee_mantissa`, and
    // answers with them as a number, the power of ten they are multiplied by, and their count:
    // Ryu's `d2s_shortest`. `0.25` gives `(25, -2, 2)`, and `1e300` gives `(1, 300, 1)`.
    //
    // # Parameters
    // * `ieee_exponent` - The biased exponent.
    // * `ieee_mantissa` - The stored significand.
    _find_shortest_decimal : I64 -> U64 -> (U64, I64, I64);
    _find_shortest_decimal = |ieee_exponent, ieee_mantissa| (
        let (e2, m2) = _decode_finite(ieee_exponent, ieee_mantissa);
        // An integer below `2 ^ 53` is its own digits, with its trailing zeros moved into the
        // power of ten.
        let is_small_integer = e2 <= 0 && e2 >= -_mantissa_bits && m2._is_multiple_of_power_of_2(-e2);
        let (mantissa, exponent) = if is_small_integer {
            loop((m2.shift_right((-e2).u64), 0), |(m, e)| (
                let q = m / 10_U64;
                if m - 10_U64 * q != 0_U64 { break $ (m, e) };
                continue $ (q, e + 1)
            ))
        } else {
            _find_shortest_decimal_general(ieee_exponent, ieee_mantissa)
        };
        (mantissa, exponent, mantissa._count_decimal_digits_17)
    );

    // Computes `floor(m * mul / 2 ^ j) mod 10 ^ 9`, where `mul` is the 192-bit number at entry `p` of
    // `table`, which holds three words per entry, the lowest first: Ryu's `mulShift_mod1e9`. `j` is
    // from 128 to 180.
    //
    // # Parameters
    // * `m` - The number to multiply.
    // * `table` - The multipliers.
    // * `p` - The entry of the multiplier.
    // * `j` - The power of two to divide by.
    _multiply_shift_mod_1e9 : U64 -> Array U64 -> I64 -> I64 -> U32;
    _multiply_shift_mod_1e9 = |m, table, p, j| (
        let b0 = m.u128 * table._unsafe_get_bounds_unchecked(3 * p).u128;
        let b1 = m.u128 * table._unsafe_get_bounds_unchecked(3 * p + 1).u128;
        let b2 = m.u128 * table._unsafe_get_bounds_unchecked(3 * p + 2).u128;
        let mid = b1 + b0.shift_right(64_U128);
        let s1 = b2 + mid.shift_right(64_U128);
        let v = s1.shift_right((j - 128).u128);
        // `floor(v / 10 ^ 9)` is the high word of `v` times the 128-bit number below, shifted
        // right by 29: Ryu's `uint128_mod1e9`, which takes the words of the product the shift
        // keeps.
        let v_low = v.u64.u128;
        let v_high = v.shift_right(64_U128);
        let b_low = 0x31680A88F8953031_U128;
        let b_high = 0x89705F4136B4A597_U128;
        let mid1 = v_high * b_low + (v_low * b_low).shift_right(64_U128);
        let mid2 = v_low * b_high + mid1.u64.u128;
        let quotient = (v_high * b_high + mid1.shift_right(64_U128) + mid2.shift_right(64_U128)).u64.shift_right(29_U64).u32;
        v.u32 - 1000000000_U32 * quotient
    );

    // The index of the table entries of the whole part of a number whose power of two is `e2`, from
    // 0: Ryu's `indexForExponent`.
    //
    // # Parameters
    // * `e2` - The power of two.
    _compute_pow10_index : I64 -> I64;
    _compute_pow10_index = |e2| (e2 + 15) / 16;

    // The number of blocks of nine digits the whole part of a number takes at index `idx`: Ryu's
    // `lengthForIndex`.
    //
    // # Parameters
    // * `idx` - The index from `_compute_pow10_index`.
    _count_pow10_blocks : I64 -> I64;
    _count_pow10_blocks = |idx| (_compute_log10_pow2(16 * idx) + 1 + 16 + 8) / 9;

    // Writes `v` into `bytes` from `at` with `precision` digits after the point, the way
    // `to_string_precision` writes it, and answers with the index after the text and the array: Ryu's
    // `d2fixed_buffered_n` for a finite `v`. The last digit is rounded to the nearest, a tie to the
    // even one, and a precision of 0 writes no point.
    //
    // `bytes` must be unshared and hold at least `at` and the most bytes the text of a number of the
    // type `v` was converted from takes, which `_write_fixed_text` of the type checks. This function
    // does not check it, and violating it causes undefined behavior.
    //
    // # Parameters
    // * `at` - The index of the first byte.
    // * `precision` - The number of digits after the point.
    // * `v` - The number to write.
    // * `bytes` - The array to write into.
    _write_fixed_text_unchecked : I64 -> I64 -> F64 -> Array U8 -> (I64, Array U8);
    _write_fixed_text_unchecked = |at, precision, v, bytes| (
        let (negative, ieee_exponent, ieee_mantissa) = F64::_decode_bits(v.to_bits);
        if ieee_exponent == 0x7FF { bytes._write_special_float(at, false, ieee_mantissa != 0_U64, negative) };
        let (index, bytes) = if negative { (at + 1, bytes.unsafe_set_bounds_unchecked(at, '-')) } else { (at, bytes) };
        if ieee_exponent == 0 && ieee_mantissa == 0_U64 {
            let bytes = bytes.unsafe_set_bounds_unchecked(index, '0');
            if precision == 0 { (index + 1, bytes) };
            let bytes = bytes.unsafe_set_bounds_unchecked(index + 1, '.');
            (index + 2 + precision, bytes._fill_bytes(index + 2, precision, '0'))
        };
        let (e2, m2) = _decode_finite(ieee_exponent, ieee_mantissa);
        let m = m2.shift_left(8_U64);
        // The whole part, nine digits at a time from the most significant, leaving out the zeros
        // before the first digit.
        let (index, bytes) = if e2 < -_mantissa_bits { (index + 1, bytes.unsafe_set_bounds_unchecked(index, '0')) } else {
            let idx = if e2 < 0 { 0 } else { _compute_pow10_index(e2) };
            let j = 16 * idx + _pow10_additional_bits - e2 + 8;
            let offset = _pow10_offset._unsafe_get_bounds_unchecked(idx).i64;
            let (index, has_digits, bytes) = loop((_count_pow10_blocks(idx) - 1, index, false, bytes), |(i, index, has_digits, bytes)| (
                if i < 0 { break $ (index, has_digits, bytes) };
                let digits = _multiply_shift_mod_1e9(m, _pow10_split, offset + i, j);
                if has_digits { continue $ (i - 1, index + 9, true, bytes._write_padded_decimal_digits(index + 9, 9, digits.u64)) };
                if digits == 0_U32 { continue $ (i - 1, index, false, bytes) };
                let length = digits._count_decimal_digits_9;
                continue $ (i - 1, index + length, true, bytes._write_decimal_integer(index + length, false, digits.u64))
            ));
            if has_digits { (index, bytes) };
            (index + 1, bytes.unsafe_set_bounds_unchecked(index, '0'))
        };
        let (index, bytes) = if precision > 0 { (index + 1, bytes.unsafe_set_bounds_unchecked(index, '.')) } else { (index, bytes) };
        if e2 >= 0 { (index + precision, bytes._fill_bytes(index, precision, '0')) };
        // The digits after the point, nine at a time, the last block cut to the precision.
        let idx = -e2 / 16;
        let blocks = precision / 9 + 1;
        let min_block = _min_block_2._unsafe_get_bounds_unchecked(idx).i64;
        let offset = _pow10_offset_2._unsafe_get_bounds_unchecked(idx).i64 - min_block;
        let end = _pow10_offset_2._unsafe_get_bounds_unchecked(idx + 1).i64;
        let j = _pow10_additional_bits + (-e2 - 16 * idx) + 8;
        // The first `min_block` blocks are zeros.
        if blocks <= min_block { (index + precision, bytes._fill_bytes(index, precision, '0')) };
        let (i, index, bytes) = (min_block, index + 9 * min_block, bytes._fill_bytes(index, 9 * min_block, '0'));
        let (index, round_up, bytes) = loop((i, index, bytes), |(i, index, bytes)| (
            if i >= blocks { break $ (index, 0, bytes) };
            let p = offset + i;
            // The blocks past the table are zeros.
            if p >= end {
                let count = precision - 9 * i;
                break $ (index + count, 0, bytes._fill_bytes(index, count, '0'))
            };
            let digits = _multiply_shift_mod_1e9(m, _pow10_split_2, p, j);
            if i < blocks - 1 { continue $ (i + 1, index + 9, bytes._write_padded_decimal_digits(index + 9, 9, digits.u64)) };
            let count = precision - 9 * i;
            let (digits, last_digit) = loop((0, digits, 0_U32), |(k, digits, last_digit)| (
                if k >= 9 - count { break $ (digits, last_digit) };
                continue $ (k + 1, digits / 10_U32, digits % 10_U32)
            ));
            // 0 leaves the digits, 1 rounds them up, and 2 rounds them up where the last is odd: a
            // removed 5 is a tie where `m2 * 10 ^ (precision + 1) / 2 ^ -e2` is an integer.
            let round_up = if last_digit != 5_U32 { if last_digit > 5_U32 { 1 } else { 0 } } else {
                let required_twos = -e2 - precision - 1;
                let is_tie = required_twos <= 0 || (required_twos < 60 && m2._is_multiple_of_power_of_2(required_twos));
                if is_tie { 2 } else { 1 }
            };
            break $ (index + count, round_up, bytes._write_padded_decimal_digits(index + count, count, digits.u64))
        ));
        if round_up == 0 { (index, bytes) };
        let (carried, bytes) = bytes._round_up_decimal_text(at, index, round_up);
        if !carried { (index, bytes) };
        // The digits became a `1` and zeros, and the whole part gains a digit: the point moves one
        // place to the right, and a zero is added at the end.
        let bytes = if precision > 0 {
            let point = index - precision - 1;
            bytes.unsafe_set_bounds_unchecked(point, '0').unsafe_set_bounds_unchecked(point + 1, '.')
        } else { bytes };
        (index + 1, bytes.unsafe_set_bounds_unchecked(index, '0'))
    );

    // Writes `v` into `bytes` from `at` with one digit before the point, `precision` digits after it
    // and a power of ten, the way `to_string_exp_precision` writes it, and answers with the index
    // after the text and the array: Ryu's `d2exp_buffered_n` for a finite `v`. The last digit is
    // rounded to the nearest, a tie to the even one, and a precision of 0 writes no point. The power
    // of ten is written as Fix writes it, with `-` for a negative one and no padding: `1.50e2`,
    // `1.50e-2`.
    //
    // `bytes` must be unshared and hold at least `at` and the most bytes the text of a number of the
    // type `v` was converted from takes, which `_write_exp_text` of the type checks. This function
    // does not check it, and violating it causes undefined behavior.
    //
    // # Parameters
    // * `at` - The index of the first byte.
    // * `precision` - The number of digits after the point.
    // * `v` - The number to write.
    // * `bytes` - The array to write into.
    _write_exp_text_unchecked : I64 -> I64 -> F64 -> Array U8 -> (I64, Array U8);
    _write_exp_text_unchecked = |at, precision, v, bytes| (
        let (negative, ieee_exponent, ieee_mantissa) = F64::_decode_bits(v.to_bits);
        if ieee_exponent == 0x7FF { bytes._write_special_float(at, false, ieee_mantissa != 0_U64, negative) };
        let (index, bytes) = if negative { (at + 1, bytes.unsafe_set_bounds_unchecked(at, '-')) } else { (at, bytes) };
        if ieee_exponent == 0 && ieee_mantissa == 0_U64 {
            let bytes = bytes.unsafe_set_bounds_unchecked(index, '0');
            let (index, bytes) = if precision == 0 { (index + 1, bytes) } else {
                let bytes = bytes.unsafe_set_bounds_unchecked(index + 1, '.');
                (index + 2 + precision, bytes._fill_bytes(index + 2, precision, '0'))
            };
            bytes._write_power_of_ten(index, 0)
        };
        let (e2, m2) = _decode_finite(ieee_exponent, ieee_mantissa);
        let m = m2.shift_left(8_U64);
        let has_point = precision > 0;
        // The digits to write, the one before the point included.
        let digit_count = precision + 1;
        // The blocks of nine digits are visited from the most significant, those of the whole part
        // and then those after the point, until `digit_count` digits are written or the block that
        // holds the last of them is reached. The two loops each repeat the step for a block, since
        // a function they share is not inlined into them, and calling it costs a tenth more time.
        //
        // The state: where the next digit goes, the last block, the digits written, the digits of
        // the last block yet to be written, the power of ten of the first digit, and the bytes.
        let state = (index, 0_U32, 0, 0, 0, bytes);
        let state = if e2 < -_mantissa_bits { state } else {
            let idx = if e2 < 0 { 0 } else { _compute_pow10_index(e2) };
            let j = 16 * idx + _pow10_additional_bits - e2 + 8;
            let offset = _pow10_offset._unsafe_get_bounds_unchecked(idx).i64;
            loop((_count_pow10_blocks(idx) - 1, state), |(i, (index, _, written, pending, power, bytes))| (
                if i < 0 { break $ (index, 0_U32, written, pending, power, bytes) };
                let digits = _multiply_shift_mod_1e9(m, _pow10_split, offset + i, j);
                if written != 0 {
