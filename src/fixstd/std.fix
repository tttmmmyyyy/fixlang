            };
            // An exact `...50...0` rounds to the even digit.
            let last_removed_digit = if vr_is_trailing_zeros && last_removed_digit == 5_U32 && vr % 2_U32 == 0_U32 { 4_U32 } else { last_removed_digit };
            // `vr + 1` is taken where `vr` is outside the bounds or the removed digits round up.
            let round_up = (vr == vm && (!accept_bounds || !vm_is_trailing_zeros)) || last_removed_digit >= 5_U32;
