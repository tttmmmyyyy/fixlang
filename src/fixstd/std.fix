    _decode_bits : U64 -> (Bool, I64, U64);
    _decode_bits = |bits| (
        let mantissa = bits.bit_and(1_U64.shift_left(_mantissa_bits.u64) - 1_U64);
        let exponent = bits.shift_right(_mantissa_bits.u64).bit_and(0x7FF_U64).i64;
        (bits.shift_right(63_U64) == 1_U64, exponent, mantissa)
    );

