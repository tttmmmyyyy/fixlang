            if mv % 5_U32 == 0_U32 { (vr, vp, vm, q, false, F32::_count_factors_of_5(mv) >= q, last_removed_digit) };
            if accept_bounds { (vr, vp, vm, q, F32::_count_factors_of_5(mm) >= q, false, last_removed_digit) };
            let vp = vp - (if F32::_count_factors_of_5(mp) >= q { 1_U32 } else { 0_U32 });
