}
impl U8 : ToBytes {
    to_bytes = U8::_to_bytes;
}
impl U8 : FromBytes {
    from_bytes = |bs| (
        if bs.@size != 1 {
            Result::err $ "Byte array of length " + bs.@size.to_string + " cannot be interpreted as U8."
        };
        Result::ok $ U8::_unsafe_from_bytes_size_unchecked(bs)
    );
}
impl U8 : ToString {
    to_string = |v| String::_from_decimal_integer(false, v.u64);
}
impl U8 : FromString {
    // Reads a decimal integer: an optional `+` or `-` followed by one or more digits, such as
    // `42`, `-0` or `+007`. A text naming a number outside `U8` is an error.
    from_string = |str| str._read_unsigned_decimal_integer(U8::maximum.u64).map(u8 : U64 -> U8);
}

