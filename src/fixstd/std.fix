    // digits and underscores in parentheses, such as `nan(1)`.
    //
    // The number is rounded to the nearest `F64`. A text naming a number too large for `F64`, or a
    // number other than zero too small for it to hold at all, is an error.
    from_string = |str| (
        let (v, outcome) = str.borrow_c_str_io(|c_str| (
            let v = *FFI_CALL_IO[F64 fixruntime_read_f64(Ptr), c_str];
            let outcome = *FFI_CALL_IO[U8 fixruntime_float_text_outcome()];
            (v, outcome).pure
        )).unsafe_perform;
